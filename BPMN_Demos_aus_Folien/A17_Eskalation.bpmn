<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_A17_Eskalation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_A17_Eskalation">
    <bpmn:participant id="P_A17" name="Travel Booking – Escalation" processRef="A17_Escalation" />
  </bpmn:collaboration>
  <bpmn:process id="A17_Escalation" name="Travel Booking – Escalation" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Folie 17: Eskalationen für die Kommunikation zwischen Kind- und Elternprozess. Jede Buchung kann mit ./dpe-demo.sh escalate &lt;taskId&gt; NICHT_BUCHBAR scheitern; der Teilprozess wirft dann eine EIGENE Eskalation (FEHLER_FLUG / FEHLER_HOTEL / FEHLER_MIETWAGEN), und der Elternprozess startet die passende Fehlerbehandlung.</bpmn:documentation>
    <bpmn:startEvent id="A17_Start">
      <bpmn:outgoing>Flow_A17_Start_A17_Sub</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="A17_Sub" name="Travel Booking">
      <bpmn:incoming>Flow_A17_Start_A17_Sub</bpmn:incoming>
      <bpmn:outgoing>Flow_A17_Sub_A17_End</bpmn:outgoing>
      <bpmn:startEvent id="A17_S_Start">
        <bpmn:outgoing>Flow_A17_S_Start_A17_T0</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="A17_S_End">
        <bpmn:incoming>Flow_A17_T2_A17_S_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="A17_T0" name="Book Flight (System-Simulation)" camunda:assignee="demo">
        <bpmn:documentation>Im Original ein automatischer Service Task. Hier als Benutzeraufgabe simuliert, damit du Zeit hast, Ereignisse auszulösen (Nachricht, Fehler, Eskalation). </bpmn:documentation>
        <bpmn:incoming>Flow_A17_S_Start_A17_T0</bpmn:incoming>
        <bpmn:outgoing>Flow_A17_T0_A17_T1</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="A17_TB0" attachedToRef="A17_T0">
        <bpmn:outgoing>Flow_A17_TB0_A17_EE0</bpmn:outgoing>
        <bpmn:escalationEventDefinition id="EscalationDef_A17_TB0" escalationRef="Escalation_NICHT_BUCHBAR" />
      </bpmn:boundaryEvent>
      <bpmn:endEvent id="A17_EE0" name="Erroneous Flight Booking">
        <bpmn:incoming>Flow_A17_TB0_A17_EE0</bpmn:incoming>
        <bpmn:escalationEventDefinition id="EscalationDef_A17_EE0" escalationRef="Escalation_FEHLER_FLUG" />
      </bpmn:endEvent>
      <bpmn:userTask id="A17_T1" name="Book Hotel (System-Simulation)" camunda:assignee="demo">
        <bpmn:documentation>Im Original ein automatischer Service Task. Hier als Benutzeraufgabe simuliert, damit du Zeit hast, Ereignisse auszulösen (Nachricht, Fehler, Eskalation). </bpmn:documentation>
        <bpmn:incoming>Flow_A17_T0_A17_T1</bpmn:incoming>
        <bpmn:outgoing>Flow_A17_T1_A17_T2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="A17_TB1" attachedToRef="A17_T1">
        <bpmn:outgoing>Flow_A17_TB1_A17_EE1</bpmn:outgoing>
        <bpmn:escalationEventDefinition id="EscalationDef_A17_TB1" escalationRef="Escalation_NICHT_BUCHBAR" />
      </bpmn:boundaryEvent>
      <bpmn:endEvent id="A17_EE1" name="Erroneous Hotel Booking">
        <bpmn:incoming>Flow_A17_TB1_A17_EE1</bpmn:incoming>
        <bpmn:escalationEventDefinition id="EscalationDef_A17_EE1" escalationRef="Escalation_FEHLER_HOTEL" />
      </bpmn:endEvent>
      <bpmn:userTask id="A17_T2" name="Book Rental Car (System-Simulation)" camunda:assignee="demo">
        <bpmn:documentation>Im Original ein automatischer Service Task. Hier als Benutzeraufgabe simuliert, damit du Zeit hast, Ereignisse auszulösen (Nachricht, Fehler, Eskalation). </bpmn:documentation>
        <bpmn:incoming>Flow_A17_T1_A17_T2</bpmn:incoming>
        <bpmn:outgoing>Flow_A17_T2_A17_S_End</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="A17_TB2" attachedToRef="A17_T2">
        <bpmn:outgoing>Flow_A17_TB2_A17_EE2</bpmn:outgoing>
        <bpmn:escalationEventDefinition id="EscalationDef_A17_TB2" escalationRef="Escalation_NICHT_BUCHBAR" />
      </bpmn:boundaryEvent>
      <bpmn:endEvent id="A17_EE2" name="Erroneous Rental Car Booking">
        <bpmn:incoming>Flow_A17_TB2_A17_EE2</bpmn:incoming>
        <bpmn:escalationEventDefinition id="EscalationDef_A17_EE2" escalationRef="Escalation_FEHLER_MIETWAGEN" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_A17_S_Start_A17_T0" sourceRef="A17_S_Start" targetRef="A17_T0" />
      <bpmn:sequenceFlow id="Flow_A17_TB0_A17_EE0" sourceRef="A17_TB0" targetRef="A17_EE0" />
      <bpmn:sequenceFlow id="Flow_A17_T0_A17_T1" sourceRef="A17_T0" targetRef="A17_T1" />
      <bpmn:sequenceFlow id="Flow_A17_TB1_A17_EE1" sourceRef="A17_TB1" targetRef="A17_EE1" />
      <bpmn:sequenceFlow id="Flow_A17_T1_A17_T2" sourceRef="A17_T1" targetRef="A17_T2" />
      <bpmn:sequenceFlow id="Flow_A17_TB2_A17_EE2" sourceRef="A17_TB2" targetRef="A17_EE2" />
      <bpmn:sequenceFlow id="Flow_A17_T2_A17_S_End" sourceRef="A17_T2" targetRef="A17_S_End" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="A17_SB0" name="Erroneous Flight Booking" attachedToRef="A17_Sub">
      <bpmn:outgoing>Flow_A17_SB0_A17_H0</bpmn:outgoing>
