      <bpmn:outgoing>Flow_A17_H2_A17_HE2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="A17_HE2">
      <bpmn:incoming>Flow_A17_H2_A17_HE2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="A17_End">
      <bpmn:incoming>Flow_A17_Sub_A17_End</bpmn:incoming>
    </bpmn:endEvent>
