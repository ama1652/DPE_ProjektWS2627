    </bpmn:endEvent>
    <bpmn:boundaryEvent id="A17_SB1" name="Erroneous Hotel Booking" attachedToRef="A17_Sub">
      <bpmn:outgoing>Flow_A17_SB1_A17_H1</bpmn:outgoing>
