    <bpmn:endEvent id="A17_HE1">
      <bpmn:incoming>Flow_A17_H1_A17_HE1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="A17_SB2" name="Erroneous Rental Car Booking" attachedToRef="A17_Sub">
      <bpmn:outgoing>Flow_A17_SB2_A17_H2</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="EscalationDef_A17_SB2" escalationRef="Escalation_FEHLER_MIETWAGEN" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="A17_H2" name="Error Handling Book Rental Car" camunda:assignee="demo">
