<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_E23_Datenobjekte_CallActivity" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_E23_Datenobjekte_CallActivity">
    <bpmn:participant id="P_E23_Main" name="Master Data Process" processRef="E23_MasterDataProcess" />
    <bpmn:participant id="P_E23_Review" name="Master Data Review Process" processRef="E23_MasterDataReview" />
  </bpmn:collaboration>
  <bpmn:process id="E23_MasterDataProcess" name="Master Data Process" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Folie 23 – HIER STARTEN. Die Call Activity ruft einen eigenständigen, wiederverwendbaren Prozess auf. Daten werden als KOPIE übergeben (camunda:in) und nur ausdrücklich zurückgegeben (camunda:out = korrigierterNachname). Ändert der Kindprozess 'nachname', bleibt der Wert im Elternprozess unverändert.</bpmn:documentation>
    <bpmn:dataObjectReference id="E23_DO_Master" name="Master Data" dataObjectRef="DO_E23_DO_Master" />
    <bpmn:dataObject id="DO_E23_DO_Master" />
    <bpmn:dataObjectReference id="E23_DO_Corr" name="Corrected Master Data" dataObjectRef="DO_E23_DO_Corr" />
    <bpmn:dataObject id="DO_E23_DO_Corr" />
    <bpmn:startEvent id="E23_Start">
      <bpmn:outgoing>Flow_E23_Start_E23_Enter</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="E23_Enter" name="Enter Master Data" camunda:assignee="demo">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="vorname" label="Vorname" type="string" defaultValue="Erika" />
          <camunda:formField id="nachname" label="Nachname (absichtlich mit Fehler)" type="string" defaultValue="Mustremann" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_E23_Start_E23_Enter</bpmn:incoming>
      <bpmn:outgoing>Flow_E23_Enter_E23_Call</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_E23_Enter_E23_DO_Master"><bpmn:targetRef>E23_DO_Master</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:callActivity id="E23_Call" name="Master Data Review Process" calledElement="E23_MasterDataReview">
      <bpmn:extensionElements>
        <camunda:in source="vorname" target="vorname" />
        <camunda:in source="nachname" target="nachname" />
        <camunda:out source="korrigierterNachname" target="korrigierterNachname" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_E23_Enter_E23_Call</bpmn:incoming>
      <bpmn:outgoing>Flow_E23_Call_E23_Store</bpmn:outgoing>
      <bpmn:property id="Prop_E23_Call_E23_DO_Master" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_E23_Call_E23_DO_Master"><bpmn:sourceRef>E23_DO_Master</bpmn:sourceRef><bpmn:targetRef>Prop_E23_Call_E23_DO_Master</bpmn:targetRef></bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DOA_E23_Call_E23_DO_Corr"><bpmn:targetRef>E23_DO_Corr</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:callActivity>
    <bpmn:serviceTask id="E23_Store" name="Store Master Data" camunda:expression="${execution.setVariable('gespeichert', vorname.concat(' ').concat(korrigierterNachname))}">
      <bpmn:incoming>Flow_E23_Call_E23_Store</bpmn:incoming>
      <bpmn:outgoing>Flow_E23_Store_E23_End</bpmn:outgoing>
      <bpmn:property id="Prop_E23_Store_E23_DO_Corr" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_E23_Store_E23_DO_Corr"><bpmn:sourceRef>E23_DO_Corr</bpmn:sourceRef><bpmn:targetRef>Prop_E23_Store_E23_DO_Corr</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E23_End">
      <bpmn:incoming>Flow_E23_Store_E23_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_E23_Start_E23_Enter" sourceRef="E23_Start" targetRef="E23_Enter" />
    <bpmn:sequenceFlow id="Flow_E23_Enter_E23_Call" sourceRef="E23_Enter" targetRef="E23_Call" />
    <bpmn:sequenceFlow id="Flow_E23_Call_E23_Store" sourceRef="E23_Call" targetRef="E23_Store" />
    <bpmn:sequenceFlow id="Flow_E23_Store_E23_End" sourceRef="E23_Store" targetRef="E23_End" />
  </bpmn:process>
  <bpmn:process id="E23_MasterDataReview" name="Master Data Review Process" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Folie 23 unten: aufgerufener (globaler) Teilprozess. Nicht direkt starten – er wird von der Call Activity aufgerufen.</bpmn:documentation>
    <bpmn:dataObjectReference id="E23_C_DO_In" name="Master Data (Data Input)" dataObjectRef="DO_E23_C_DO_In" />
    <bpmn:dataObject id="DO_E23_C_DO_In" />
    <bpmn:dataObjectReference id="E23_C_DO_Err" name="Master Data with Errorlist" dataObjectRef="DO_E23_C_DO_Err" />
    <bpmn:dataObject id="DO_E23_C_DO_Err" isCollection="true" />
    <bpmn:dataObjectReference id="E23_C_DO_Out" name="Corrected Master Data (Data Output)" dataObjectRef="DO_E23_C_DO_Out" />
    <bpmn:dataObject id="DO_E23_C_DO_Out" />
    <bpmn:startEvent id="E23_C_Start">
      <bpmn:outgoing>Flow_E23_C_Start_E23_C_Check</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="E23_C_Check" name="Check Master Data" camunda:expression="${execution.setVariable('fehlerliste', 'Nachname prüfen')}">
      <bpmn:incoming>Flow_E23_C_Start_E23_C_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_E23_C_Check_E23_C_Correct</bpmn:outgoing>
      <bpmn:property id="Prop_E23_C_Check_E23_C_DO_In" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_E23_C_Check_E23_C_DO_In"><bpmn:sourceRef>E23_C_DO_In</bpmn:sourceRef><bpmn:targetRef>Prop_E23_C_Check_E23_C_DO_In</bpmn:targetRef></bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DOA_E23_C_Check_E23_C_DO_Err"><bpmn:targetRef>E23_C_DO_Err</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:businessRuleTask>
    <bpmn:userTask id="E23_C_Correct" name="Correct Errors Subprocess" camunda:assignee="demo">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="nachname" label="Nachname korrigieren (ändert nur die KOPIE)" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_E23_C_Check_E23_C_Correct</bpmn:incoming>
      <bpmn:outgoing>Flow_E23_C_Correct_E23_C_Final</bpmn:outgoing>
      <bpmn:property id="Prop_E23_C_Correct_E23_C_DO_Err" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_E23_C_Correct_E23_C_DO_Err"><bpmn:sourceRef>E23_C_DO_Err</bpmn:sourceRef><bpmn:targetRef>Prop_E23_C_Correct_E23_C_DO_Err</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="E23_C_Final" name="Final Check and Approval Subprocess" camunda:assignee="demo">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="korrigierterNachname" label="Korrigierter Nachname (wird zurückgegeben)" type="string" defaultValue="Mustermann" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_E23_C_Correct_E23_C_Final</bpmn:incoming>
      <bpmn:outgoing>Flow_E23_C_Final_E23_C_End</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_E23_C_Final_E23_C_DO_Out"><bpmn:targetRef>E23_C_DO_Out</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:endEvent id="E23_C_End">
      <bpmn:incoming>Flow_E23_C_Final_E23_C_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_E23_C_Start_E23_C_Check" sourceRef="E23_C_Start" targetRef="E23_C_Check" />
    <bpmn:sequenceFlow id="Flow_E23_C_Check_E23_C_Correct" sourceRef="E23_C_Check" targetRef="E23_C_Correct" />
    <bpmn:sequenceFlow id="Flow_E23_C_Correct_E23_C_Final" sourceRef="E23_C_Correct" targetRef="E23_C_Final" />
    <bpmn:sequenceFlow id="Flow_E23_C_Final_E23_C_End" sourceRef="E23_C_Final" targetRef="E23_C_End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_E23_Datenobjekte_CallActivity">
    <bpmndi:BPMNPlane id="BPMNPlane_E23_Datenobjekte_CallActivity" bpmnElement="Collaboration_E23_Datenobjekte_CallActivity">
      <bpmndi:BPMNShape id="P_E23_Main_di" bpmnElement="P_E23_Main" isHorizontal="true"><dc:Bounds x="160" y="40" width="760" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_E23_Review_di" bpmnElement="P_E23_Review" isHorizontal="true"><dc:Bounds x="160" y="340" width="760" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E23_DO_Master_di" bpmnElement="E23_DO_Master"><dc:Bounds x="392" y="65" width="36" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="372" y="119" width="77" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E23_DO_Corr_di" bpmnElement="E23_DO_Corr"><dc:Bounds x="562" y="65" width="36" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="510" y="119" width="140" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E23_Start_di" bpmnElement="E23_Start"><dc:Bounds x="212" y="202" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E23_Enter_di" bpmnElement="E23_Enter"><dc:Bounds x="290" y="180" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E23_Call_di" bpmnElement="E23_Call"><dc:Bounds x="450" y="180" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E23_Store_di" bpmnElement="E23_Store"><dc:Bounds x="610" y="180" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E23_End_di" bpmnElement="E23_End"><dc:Bounds x="772" y="202" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E23_C_DO_In_di" bpmnElement="E23_C_DO_In"><dc:Bounds x="232" y="365" width="36" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="180" y="419" width="140" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E23_C_DO_Err_di" bpmnElement="E23_C_DO_Err"><dc:Bounds x="562" y="365" width="36" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="510" y="419" width="140" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E23_C_DO_Out_di" bpmnElement="E23_C_DO_Out"><dc:Bounds x="772" y="365" width="36" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="720" y="419" width="140" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E23_C_Start_di" bpmnElement="E23_C_Start"><dc:Bounds x="212" y="502" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E23_C_Check_di" bpmnElement="E23_C_Check"><dc:Bounds x="290" y="480" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E23_C_Correct_di" bpmnElement="E23_C_Correct"><dc:Bounds x="450" y="480" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E23_C_Final_di" bpmnElement="E23_C_Final"><dc:Bounds x="610" y="480" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E23_C_End_di" bpmnElement="E23_C_End"><dc:Bounds x="772" y="502" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_E23_Start_E23_Enter_di" bpmnElement="Flow_E23_Start_E23_Enter"><di:waypoint x="248" y="220" /><di:waypoint x="290" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E23_Enter_E23_Call_di" bpmnElement="Flow_E23_Enter_E23_Call"><di:waypoint x="390" y="220" /><di:waypoint x="450" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E23_Call_E23_Store_di" bpmnElement="Flow_E23_Call_E23_Store"><di:waypoint x="550" y="220" /><di:waypoint x="610" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E23_Store_E23_End_di" bpmnElement="Flow_E23_Store_E23_End"><di:waypoint x="710" y="220" /><di:waypoint x="772" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E23_C_Start_E23_C_Check_di" bpmnElement="Flow_E23_C_Start_E23_C_Check"><di:waypoint x="248" y="520" /><di:waypoint x="290" y="520" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E23_C_Check_E23_C_Correct_di" bpmnElement="Flow_E23_C_Check_E23_C_Correct"><di:waypoint x="390" y="520" /><di:waypoint x="450" y="520" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E23_C_Correct_E23_C_Final_di" bpmnElement="Flow_E23_C_Correct_E23_C_Final"><di:waypoint x="550" y="520" /><di:waypoint x="610" y="520" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E23_C_Final_E23_C_End_di" bpmnElement="Flow_E23_C_Final_E23_C_End"><di:waypoint x="710" y="520" /><di:waypoint x="772" y="520" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DOA_E23_Enter_E23_DO_Master_di" bpmnElement="DOA_E23_Enter_E23_DO_Master"><di:waypoint x="355" y="180" /><di:waypoint x="410" y="115" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DIA_E23_Call_E23_DO_Master_di" bpmnElement="DIA_E23_Call_E23_DO_Master"><di:waypoint x="410" y="115" /><di:waypoint x="485" y="180" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DOA_E23_Call_E23_DO_Corr_di" bpmnElement="DOA_E23_Call_E23_DO_Corr"><di:waypoint x="515" y="180" /><di:waypoint x="580" y="115" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DIA_E23_Store_E23_DO_Corr_di" bpmnElement="DIA_E23_Store_E23_DO_Corr"><di:waypoint x="580" y="115" /><di:waypoint x="645" y="180" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DIA_E23_C_Check_E23_C_DO_In_di" bpmnElement="DIA_E23_C_Check_E23_C_DO_In"><di:waypoint x="250" y="415" /><di:waypoint x="325" y="480" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DOA_E23_C_Check_E23_C_DO_Err_di" bpmnElement="DOA_E23_C_Check_E23_C_DO_Err"><di:waypoint x="355" y="480" /><di:waypoint x="580" y="415" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DIA_E23_C_Correct_E23_C_DO_Err_di" bpmnElement="DIA_E23_C_Correct_E23_C_DO_Err"><di:waypoint x="580" y="415" /><di:waypoint x="485" y="480" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DOA_E23_C_Final_E23_C_DO_Out_di" bpmnElement="DOA_E23_C_Final_E23_C_DO_Out"><di:waypoint x="675" y="480" /><di:waypoint x="790" y="415" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
