<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_A20_Timeout_nicht_unterbrechend" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_A20_Timeout_nicht_unterbrechend">
    <bpmn:participant id="P_A20_PDA" name="Process Driven Application" />
    <bpmn:participant id="P_A20_SCIL" name="Service Contract Implementation Layer" processRef="A20_ServiceContract" />
    <bpmn:participant id="P_A20_SP" name="Service Provider" />
    <bpmn:messageFlow id="MsgFlow_P_A20_PDA_A20_Start" sourceRef="P_A20_PDA" targetRef="A20_Start" />
    <bpmn:messageFlow id="MsgFlow_A20_Send_P_A20_SP" sourceRef="A20_Send" targetRef="P_A20_SP" />
    <bpmn:messageFlow id="MsgFlow_P_A20_SP_A20_Rec" sourceRef="P_A20_SP" targetRef="A20_Rec" />
    <bpmn:messageFlow id="MsgFlow_A20_EndOk_P_A20_PDA" sourceRef="A20_EndOk" targetRef="P_A20_PDA" />
  </bpmn:collaboration>
  <bpmn:process id="A20_ServiceContract" name="Service Contract Implementation Layer" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Folie 20: NICHT unterbrechender Timer – nach 15 s startet zusätzlich 'Analyze Delay', das Warten auf die Antwort geht weiter. Starten: ./dpe-demo.sh start A20_ServiceContract; Antwort: ./dpe-demo.sh msg A20_Antwort &lt;processInstanceId&gt;</bpmn:documentation>
    <bpmn:startEvent id="A20_Start" name="Service-Request">
      <bpmn:outgoing>Flow_A20_Start_A20_Send</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_A20_Start" messageRef="Message_A20_ServiceRequest" />
    </bpmn:startEvent>
    <bpmn:sendTask id="A20_Send" name="Send Request to Service Provider" camunda:expression="${execution.setVariable('letzteNachricht', 'Anfrage an Service Provider')}">
      <bpmn:incoming>Flow_A20_Start_A20_Send</bpmn:incoming>
      <bpmn:outgoing>Flow_A20_Send_A20_Rec</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="A20_Rec" name="Wait for Response from Service Provider" messageRef="Message_A20_Antwort">
      <bpmn:incoming>Flow_A20_Send_A20_Rec</bpmn:incoming>
      <bpmn:outgoing>Flow_A20_Rec_A20_EndOk</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="A20_EndOk" name="Service-Response">
      <bpmn:incoming>Flow_A20_Rec_A20_EndOk</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageDef_A20_EndOk" messageRef="Message_A20_Response" camunda:expression="${execution.setVariable('letzteNachricht', 'Antwort an Anwendung')}" />
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="A20_BT" name="max. 15 sec Waiting Time" attachedToRef="A20_Rec" cancelActivity="false">
      <bpmn:outgoing>Flow_A20_BT_A20_Analyze</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_A20_BT">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="A20_Analyze" name="Analyze Delay" camunda:assignee="demo">
      <bpmn:incoming>Flow_A20_BT_A20_Analyze</bpmn:incoming>
      <bpmn:outgoing>Flow_A20_Analyze_A20_End2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="A20_End2">
      <bpmn:incoming>Flow_A20_Analyze_A20_End2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_A20_Start_A20_Send" sourceRef="A20_Start" targetRef="A20_Send" />
    <bpmn:sequenceFlow id="Flow_A20_Send_A20_Rec" sourceRef="A20_Send" targetRef="A20_Rec" />
    <bpmn:sequenceFlow id="Flow_A20_Rec_A20_EndOk" sourceRef="A20_Rec" targetRef="A20_EndOk" />
    <bpmn:sequenceFlow id="Flow_A20_BT_A20_Analyze" sourceRef="A20_BT" targetRef="A20_Analyze" />
    <bpmn:sequenceFlow id="Flow_A20_Analyze_A20_End2" sourceRef="A20_Analyze" targetRef="A20_End2" />
  </bpmn:process>
  <bpmn:message id="Message_A20_ServiceRequest" name="A20_ServiceRequest" />
  <bpmn:message id="Message_A20_Antwort" name="A20_Antwort" />
  <bpmn:message id="Message_A20_Response" name="A20_Response" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_A20_Timeout_nicht_unterbrechend">
    <bpmndi:BPMNPlane id="BPMNPlane_A20_Timeout_nicht_unterbrechend" bpmnElement="Collaboration_A20_Timeout_nicht_unterbrechend">
      <bpmndi:BPMNShape id="P_A20_PDA_di" bpmnElement="P_A20_PDA" isHorizontal="true"><dc:Bounds x="140" y="40" width="860" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_A20_SCIL_di" bpmnElement="P_A20_SCIL" isHorizontal="true"><dc:Bounds x="140" y="140" width="860" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_A20_SP_di" bpmnElement="P_A20_SP" isHorizontal="true"><dc:Bounds x="140" y="440" width="860" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A20_Start_di" bpmnElement="A20_Start"><dc:Bounds x="222" y="212" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="188" y="252" width="105" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A20_Send_di" bpmnElement="A20_Send"><dc:Bounds x="300" y="190" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A20_Rec_di" bpmnElement="A20_Rec"><dc:Bounds x="450" y="190" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A20_EndOk_di" bpmnElement="A20_EndOk"><dc:Bounds x="622" y="212" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="584" y="252" width="112" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A20_BT_di" bpmnElement="A20_BT"><dc:Bounds x="517" y="252" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="465" y="292" width="140" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A20_Analyze_di" bpmnElement="A20_Analyze"><dc:Bounds x="630" y="290" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A20_End2_di" bpmnElement="A20_End2"><dc:Bounds x="782" y="312" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_A20_Start_A20_Send_di" bpmnElement="Flow_A20_Start_A20_Send"><di:waypoint x="258" y="230" /><di:waypoint x="300" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A20_Send_A20_Rec_di" bpmnElement="Flow_A20_Send_A20_Rec"><di:waypoint x="400" y="230" /><di:waypoint x="450" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A20_Rec_A20_EndOk_di" bpmnElement="Flow_A20_Rec_A20_EndOk"><di:waypoint x="550" y="230" /><di:waypoint x="622" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A20_BT_A20_Analyze_di" bpmnElement="Flow_A20_BT_A20_Analyze"><di:waypoint x="535" y="288" /><di:waypoint x="535" y="330" /><di:waypoint x="630" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A20_Analyze_A20_End2_di" bpmnElement="Flow_A20_Analyze_A20_End2"><di:waypoint x="730" y="330" /><di:waypoint x="782" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MsgFlow_P_A20_PDA_A20_Start_di" bpmnElement="MsgFlow_P_A20_PDA_A20_Start"><di:waypoint x="240" y="100" /><di:waypoint x="240" y="212" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MsgFlow_A20_Send_P_A20_SP_di" bpmnElement="MsgFlow_A20_Send_P_A20_SP"><di:waypoint x="350" y="270" /><di:waypoint x="350" y="440" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MsgFlow_P_A20_SP_A20_Rec_di" bpmnElement="MsgFlow_P_A20_SP_A20_Rec"><di:waypoint x="480" y="440" /><di:waypoint x="480" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MsgFlow_A20_EndOk_P_A20_PDA_di" bpmnElement="MsgFlow_A20_EndOk_P_A20_PDA"><di:waypoint x="640" y="212" /><di:waypoint x="640" y="100" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
