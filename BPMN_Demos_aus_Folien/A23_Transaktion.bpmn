<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_A23_Transaktion" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_A23_Transaktion">
    <bpmn:participant id="P_A23_PDA" name="Process Driven Application" />
    <bpmn:participant id="P_A23_SCIL" name="Service Contract Implementation Layer" processRef="A23_ServiceContract" />
    <bpmn:participant id="P_A23_SP" name="Service Provider" />
    <bpmn:messageFlow id="MsgFlow_P_A23_PDA_A23_Start" sourceRef="P_A23_PDA" targetRef="A23_Start" />
    <bpmn:messageFlow id="MsgFlow_A23_EndOk_P_A23_PDA" sourceRef="A23_EndOk" targetRef="P_A23_PDA" />
    <bpmn:messageFlow id="MsgFlow_A23_EndErr_P_A23_PDA" sourceRef="A23_EndErr" targetRef="P_A23_PDA" />
  </bpmn:collaboration>
  <bpmn:process id="A23_ServiceContract" name="Service Contract Implementation Layer" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Folie 23: Transaktion = alle Schritte gelingen gemeinsam oder keiner. Schlägt eine Buchung fehl (./dpe-demo.sh error &lt;taskId&gt; BUCHUNG_FEHLGESCHLAGEN), läuft der Fehler zum Cancel End Event (2). Die Engine geht rückwärts durch ihr Protokoll und führt die Kompensationsaufgaben (5) der bereits erledigten Schritte aus (sie erscheinen in deiner Tasklist). Danach greift das Cancel Boundary Event (3) -&gt; Fehlermeldung.</bpmn:documentation>
    <bpmn:startEvent id="A23_Start" name="Service-Request">
      <bpmn:outgoing>Flow_A23_Start_A23_Tx</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_A23_Start" messageRef="Message_A23_ServiceRequest" />
    </bpmn:startEvent>
    <bpmn:transaction id="A23_Tx" name="Transaction">
      <bpmn:incoming>Flow_A23_Start_A23_Tx</bpmn:incoming>
      <bpmn:outgoing>Flow_A23_Tx_A23_EndOk</bpmn:outgoing>
      <bpmn:startEvent id="A23_T_Start">
        <bpmn:outgoing>Flow_A23_T_Start_A23_B0</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="A23_B0" name="Book Flight (System-Simulation)" camunda:assignee="demo">
        <bpmn:documentation>Im Original ein automatischer Service Task. Hier als Benutzeraufgabe simuliert, damit du Zeit hast, Ereignisse auszulösen (Nachricht, Fehler, Eskalation). Fehler auslösen: ./dpe-demo.sh error &lt;taskId&gt; BUCHUNG_FEHLGESCHLAGEN</bpmn:documentation>
        <bpmn:incoming>Flow_A23_T_Start_A23_B0</bpmn:incoming>
        <bpmn:outgoing>Flow_A23_B0_A23_B1</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="A23_CB0" attachedToRef="A23_B0">
        <bpmn:compensateEventDefinition id="CompensateDef_A23_CB0" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="A23_CH0" name="Compensation Book Flight" camunda:assignee="demo" isForCompensation="true">
      </bpmn:userTask>
      <bpmn:boundaryEvent id="A23_EB0" attachedToRef="A23_B0">
        <bpmn:outgoing>Flow_A23_EB0_A23_T_Cancel</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorDef_A23_EB0" errorRef="Error_BUCHUNG_FEHLGESCHLAGEN" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="A23_B1" name="Book Hotel (System-Simulation)" camunda:assignee="demo">
        <bpmn:documentation>Im Original ein automatischer Service Task. Hier als Benutzeraufgabe simuliert, damit du Zeit hast, Ereignisse auszulösen (Nachricht, Fehler, Eskalation). Fehler auslösen: ./dpe-demo.sh error &lt;taskId&gt; BUCHUNG_FEHLGESCHLAGEN</bpmn:documentation>
        <bpmn:incoming>Flow_A23_B0_A23_B1</bpmn:incoming>
        <bpmn:outgoing>Flow_A23_B1_A23_B2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="A23_CB1" attachedToRef="A23_B1">
        <bpmn:compensateEventDefinition id="CompensateDef_A23_CB1" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="A23_CH1" name="Compensation Book Hotel" camunda:assignee="demo" isForCompensation="true">
      </bpmn:userTask>
      <bpmn:boundaryEvent id="A23_EB1" attachedToRef="A23_B1">
        <bpmn:outgoing>Flow_A23_EB1_A23_T_Cancel</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorDef_A23_EB1" errorRef="Error_BUCHUNG_FEHLGESCHLAGEN" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="A23_B2" name="Book Rental Car (System-Simulation)" camunda:assignee="demo">
        <bpmn:documentation>Im Original ein automatischer Service Task. Hier als Benutzeraufgabe simuliert, damit du Zeit hast, Ereignisse auszulösen (Nachricht, Fehler, Eskalation). Fehler auslösen: ./dpe-demo.sh error &lt;taskId&gt; BUCHUNG_FEHLGESCHLAGEN</bpmn:documentation>
        <bpmn:incoming>Flow_A23_B1_A23_B2</bpmn:incoming>
        <bpmn:outgoing>Flow_A23_B2_A23_T_End</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="A23_EB2" attachedToRef="A23_B2">
        <bpmn:outgoing>Flow_A23_EB2_A23_T_Cancel</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorDef_A23_EB2" errorRef="Error_BUCHUNG_FEHLGESCHLAGEN" />
      </bpmn:boundaryEvent>
      <bpmn:endEvent id="A23_T_End">
        <bpmn:incoming>Flow_A23_B2_A23_T_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="A23_T_Cancel" name="Cancel End Event">
        <bpmn:incoming>Flow_A23_EB0_A23_T_Cancel</bpmn:incoming>
        <bpmn:incoming>Flow_A23_EB1_A23_T_Cancel</bpmn:incoming>
        <bpmn:incoming>Flow_A23_EB2_A23_T_Cancel</bpmn:incoming>
        <bpmn:cancelEventDefinition id="CancelDef_A23_T_Cancel" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_A23_T_Start_A23_B0" sourceRef="A23_T_Start" targetRef="A23_B0" />
      <bpmn:sequenceFlow id="Flow_A23_B0_A23_B1" sourceRef="A23_B0" targetRef="A23_B1" />
      <bpmn:sequenceFlow id="Flow_A23_B1_A23_B2" sourceRef="A23_B1" targetRef="A23_B2" />
      <bpmn:sequenceFlow id="Flow_A23_B2_A23_T_End" sourceRef="A23_B2" targetRef="A23_T_End" />
      <bpmn:sequenceFlow id="Flow_A23_EB0_A23_T_Cancel" sourceRef="A23_EB0" targetRef="A23_T_Cancel" />
      <bpmn:sequenceFlow id="Flow_A23_EB1_A23_T_Cancel" sourceRef="A23_EB1" targetRef="A23_T_Cancel" />
      <bpmn:sequenceFlow id="Flow_A23_EB2_A23_T_Cancel" sourceRef="A23_EB2" targetRef="A23_T_Cancel" />
      <bpmn:association id="Assoc_A23_CB0_A23_CH0" associationDirection="One" sourceRef="A23_CB0" targetRef="A23_CH0" />
      <bpmn:association id="Assoc_A23_CB1_A23_CH1" associationDirection="One" sourceRef="A23_CB1" targetRef="A23_CH1" />
    </bpmn:transaction>
    <bpmn:boundaryEvent id="A23_BCancel" name="Cancel Boundary Event" attachedToRef="A23_Tx">
      <bpmn:outgoing>Flow_A23_BCancel_A23_EndErr</bpmn:outgoing>
      <bpmn:cancelEventDefinition id="CancelDef_A23_BCancel" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="A23_EndOk" name="Service-Response">
      <bpmn:incoming>Flow_A23_Tx_A23_EndOk</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageDef_A23_EndOk" messageRef="Message_A23_Response" camunda:expression="${execution.setVariable('letzteNachricht', 'Buchung bestätigt')}" />
    </bpmn:endEvent>
    <bpmn:endEvent id="A23_EndErr" name="Error Message">
      <bpmn:incoming>Flow_A23_BCancel_A23_EndErr</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageDef_A23_EndErr" messageRef="Message_A23_Error" camunda:expression="${execution.setVariable('letzteNachricht', 'Buchung storniert')}" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_A23_Start_A23_Tx" sourceRef="A23_Start" targetRef="A23_Tx" />
    <bpmn:sequenceFlow id="Flow_A23_Tx_A23_EndOk" sourceRef="A23_Tx" targetRef="A23_EndOk" />
    <bpmn:sequenceFlow id="Flow_A23_BCancel_A23_EndErr" sourceRef="A23_BCancel" targetRef="A23_EndErr" />
  </bpmn:process>
  <bpmn:message id="Message_A23_ServiceRequest" name="A23_ServiceRequest" />
  <bpmn:message id="Message_A23_Response" name="A23_Response" />
  <bpmn:message id="Message_A23_Error" name="A23_Error" />
  <bpmn:error id="Error_BUCHUNG_FEHLGESCHLAGEN" name="BUCHUNG_FEHLGESCHLAGEN" errorCode="BUCHUNG_FEHLGESCHLAGEN" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_A23_Transaktion">
    <bpmndi:BPMNPlane id="BPMNPlane_A23_Transaktion" bpmnElement="Collaboration_A23_Transaktion">
      <bpmndi:BPMNShape id="P_A23_PDA_di" bpmnElement="P_A23_PDA" isHorizontal="true"><dc:Bounds x="140" y="40" width="900" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_A23_SCIL_di" bpmnElement="P_A23_SCIL" isHorizontal="true"><dc:Bounds x="140" y="140" width="900" height="330" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_A23_SP_di" bpmnElement="P_A23_SP" isHorizontal="true"><dc:Bounds x="140" y="510" width="900" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A23_Tx_di" bpmnElement="A23_Tx" isExpanded="true"><dc:Bounds x="260" y="180" width="560" height="250" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A23_Start_di" bpmnElement="A23_Start"><dc:Bounds x="182" y="232" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="148" y="272" width="105" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A23_T_Start_di" bpmnElement="A23_T_Start"><dc:Bounds x="282" y="232" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A23_B0_di" bpmnElement="A23_B0"><dc:Bounds x="350" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A23_CB0_di" bpmnElement="A23_CB0"><dc:Bounds x="352" y="272" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A23_CH0_di" bpmnElement="A23_CH0"><dc:Bounds x="380" y="340" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A23_EB0_di" bpmnElement="A23_EB0"><dc:Bounds x="412" y="272" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A23_B1_di" bpmnElement="A23_B1"><dc:Bounds x="500" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A23_CB1_di" bpmnElement="A23_CB1"><dc:Bounds x="502" y="272" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A23_CH1_di" bpmnElement="A23_CH1"><dc:Bounds x="530" y="340" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A23_EB1_di" bpmnElement="A23_EB1"><dc:Bounds x="562" y="272" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A23_B2_di" bpmnElement="A23_B2"><dc:Bounds x="650" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A23_EB2_di" bpmnElement="A23_EB2"><dc:Bounds x="712" y="272" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A23_T_End_di" bpmnElement="A23_T_End"><dc:Bounds x="762" y="232" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A23_T_Cancel_di" bpmnElement="A23_T_Cancel"><dc:Bounds x="762" y="302" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="802" y="313" width="112" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A23_BCancel_di" bpmnElement="A23_BCancel"><dc:Bounds x="757" y="412" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="705" y="452" width="140" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A23_EndOk_di" bpmnElement="A23_EndOk"><dc:Bounds x="882" y="232" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="844" y="272" width="112" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A23_EndErr_di" bpmnElement="A23_EndErr"><dc:Bounds x="942" y="432" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="914" y="472" width="91" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_A23_T_Start_A23_B0_di" bpmnElement="Flow_A23_T_Start_A23_B0"><di:waypoint x="318" y="250" /><di:waypoint x="350" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A23_B0_A23_B1_di" bpmnElement="Flow_A23_B0_A23_B1"><di:waypoint x="450" y="250" /><di:waypoint x="500" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A23_B1_A23_B2_di" bpmnElement="Flow_A23_B1_A23_B2"><di:waypoint x="600" y="250" /><di:waypoint x="650" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A23_B2_A23_T_End_di" bpmnElement="Flow_A23_B2_A23_T_End"><di:waypoint x="750" y="250" /><di:waypoint x="762" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A23_EB0_A23_T_Cancel_di" bpmnElement="Flow_A23_EB0_A23_T_Cancel"><di:waypoint x="430" y="308" /><di:waypoint x="430" y="320" /><di:waypoint x="762" y="320" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A23_EB1_A23_T_Cancel_di" bpmnElement="Flow_A23_EB1_A23_T_Cancel"><di:waypoint x="580" y="308" /><di:waypoint x="580" y="320" /><di:waypoint x="762" y="320" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A23_EB2_A23_T_Cancel_di" bpmnElement="Flow_A23_EB2_A23_T_Cancel"><di:waypoint x="730" y="308" /><di:waypoint x="730" y="320" /><di:waypoint x="762" y="320" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A23_Start_A23_Tx_di" bpmnElement="Flow_A23_Start_A23_Tx"><di:waypoint x="218" y="250" /><di:waypoint x="260" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A23_Tx_A23_EndOk_di" bpmnElement="Flow_A23_Tx_A23_EndOk"><di:waypoint x="820" y="250" /><di:waypoint x="882" y="250" /></bpmndi:BPMNEdge>
