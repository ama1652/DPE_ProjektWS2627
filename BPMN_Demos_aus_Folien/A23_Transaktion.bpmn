      <bpmndi:BPMNEdge id="MsgFlow_P_A23_PDA_A23_Start_di" bpmnElement="MsgFlow_P_A23_PDA_A23_Start"><di:waypoint x="200" y="100" /><di:waypoint x="200" y="232" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MsgFlow_A23_EndOk_P_A23_PDA_di" bpmnElement="MsgFlow_A23_EndOk_P_A23_PDA"><di:waypoint x="900" y="232" /><di:waypoint x="900" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MsgFlow_A23_EndErr_P_A23_PDA_di" bpmnElement="MsgFlow_A23_EndErr_P_A23_PDA"><di:waypoint x="960" y="432" /><di:waypoint x="960" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_A23_CB0_A23_CH0_di" bpmnElement="Assoc_A23_CB0_A23_CH0"><di:waypoint x="370" y="308" /><di:waypoint x="370" y="380" /><di:waypoint x="380" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_A23_CB1_A23_CH1_di" bpmnElement="Assoc_A23_CB1_A23_CH1"><di:waypoint x="520" y="308" /><di:waypoint x="520" y="380" /><di:waypoint x="530" y="380" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
