<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_A29_Prozesse_starten" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_A29_Prozesse_starten">
    <bpmn:participant id="P_A29_O" name="Original: drei Startereignisse (nur Ansicht – so in CIB seven nicht ausführbar)" processRef="A29_O_Original" />
    <bpmn:participant id="P_A29_A" name="A: Normaler Start + Nachrichtenstart (ausführbar)" processRef="A29_A_MehrereStarts" />
    <bpmn:participant id="P_A29_B" name="B: Instanziierendes ereignisbasiertes Gateway – exklusiv (nur Ansicht)" processRef="A29_B_EventGwExklusiv" />
    <bpmn:participant id="P_A29_C" name="C: Instanziierendes ereignisbasiertes Gateway – parallel (nur Ansicht)" processRef="A29_C_EventGwParallel" />
  </bpmn:collaboration>
  <bpmn:process id="A29_O_Original" name="Original: drei Startereignisse (nur Ansicht – so in CIB seven nicht ausführbar)" isExecutable="false">
    <bpmn:documentation>Folie 29 oben: normales, Nachrichten- und Timer-Startereignis in EINEM Prozess. CIB seven lehnt das beim Hochladen ab (ENGINE-09005: 'multiple none start events or timer start events not supported'). Ausführbare Variante: Pool A.</bpmn:documentation>
    <bpmn:startEvent id="A29O_SNone" name="Create Report via Invocation">
      <bpmn:outgoing>Flow_A29O_SNone_A29O_Calc</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="A29O_SMsg" name="Create Report via Message">
      <bpmn:outgoing>Flow_A29O_SMsg_A29O_Calc</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_A29O_SMsg" messageRef="Message_A29_ReportAnfrage" />
    </bpmn:startEvent>
    <bpmn:startEvent id="A29O_STimer" name="Create Report at end of month">
      <bpmn:outgoing>Flow_A29O_STimer_A29O_Xor</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_A29O_STimer">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 0 L * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="A29O_Calc" name="Calculate time period for report">
      <bpmn:incoming>Flow_A29O_SNone_A29O_Calc</bpmn:incoming>
      <bpmn:incoming>Flow_A29O_SMsg_A29O_Calc</bpmn:incoming>
      <bpmn:outgoing>Flow_A29O_Calc_A29O_Xor</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="A29O_Xor">
      <bpmn:incoming>Flow_A29O_STimer_A29O_Xor</bpmn:incoming>
      <bpmn:incoming>Flow_A29O_Calc_A29O_Xor</bpmn:incoming>
      <bpmn:outgoing>Flow_A29O_Xor_A29O_Rep</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A29O_Rep" name="Create report">
      <bpmn:incoming>Flow_A29O_Xor_A29O_Rep</bpmn:incoming>
      <bpmn:outgoing>Flow_A29O_Rep_A29O_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="A29O_End">
      <bpmn:incoming>Flow_A29O_Rep_A29O_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_A29O_SNone_A29O_Calc" sourceRef="A29O_SNone" targetRef="A29O_Calc" />
    <bpmn:sequenceFlow id="Flow_A29O_SMsg_A29O_Calc" sourceRef="A29O_SMsg" targetRef="A29O_Calc" />
    <bpmn:sequenceFlow id="Flow_A29O_STimer_A29O_Xor" sourceRef="A29O_STimer" targetRef="A29O_Xor" />
    <bpmn:sequenceFlow id="Flow_A29O_Calc_A29O_Xor" sourceRef="A29O_Calc" targetRef="A29O_Xor" />
    <bpmn:sequenceFlow id="Flow_A29O_Xor_A29O_Rep" sourceRef="A29O_Xor" targetRef="A29O_Rep" />
    <bpmn:sequenceFlow id="Flow_A29O_Rep_A29O_End" sourceRef="A29O_Rep" targetRef="A29O_End" />
  </bpmn:process>
  <bpmn:process id="A29_A_MehrereStarts" name="A: Normaler Start + Nachrichtenstart (ausführbar)" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Ausführbare Variante von Folie 29 oben: Ein Prozess darf in CIB seven ein normales Startereignis und beliebig viele Nachrichten-Startereignisse haben, aber NICHT zusätzlich einen Timer-Start. Jeder Start erzeugt eine eigene Instanz: Tasklist/REST oder ./dpe-demo.sh msg A29_ReportAnfrage. Der Timer-Start bräuchte einen eigenen Prozess.</bpmn:documentation>
    <bpmn:startEvent id="A29A_SNone" name="Create Report via Invocation">
      <bpmn:outgoing>Flow_A29A_SNone_A29A_Calc</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="A29A_SMsg" name="Create Report via Message">
      <bpmn:outgoing>Flow_A29A_SMsg_A29A_Calc</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_A29A_SMsg" messageRef="Message_A29_ReportAnfrage" />
    </bpmn:startEvent>
    <bpmn:userTask id="A29A_Calc" name="Calculate time period for report" camunda:assignee="demo">
      <bpmn:incoming>Flow_A29A_SNone_A29A_Calc</bpmn:incoming>
      <bpmn:incoming>Flow_A29A_SMsg_A29A_Calc</bpmn:incoming>
      <bpmn:outgoing>Flow_A29A_Calc_A29A_Rep</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="A29A_Rep" name="Create report" camunda:assignee="demo">
      <bpmn:incoming>Flow_A29A_Calc_A29A_Rep</bpmn:incoming>
      <bpmn:outgoing>Flow_A29A_Rep_A29A_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="A29A_End">
      <bpmn:incoming>Flow_A29A_Rep_A29A_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_A29A_SNone_A29A_Calc" sourceRef="A29A_SNone" targetRef="A29A_Calc" />
    <bpmn:sequenceFlow id="Flow_A29A_SMsg_A29A_Calc" sourceRef="A29A_SMsg" targetRef="A29A_Calc" />
    <bpmn:sequenceFlow id="Flow_A29A_Calc_A29A_Rep" sourceRef="A29A_Calc" targetRef="A29A_Rep" />
    <bpmn:sequenceFlow id="Flow_A29A_Rep_A29A_End" sourceRef="A29A_Rep" targetRef="A29A_End" />
  </bpmn:process>
  <bpmn:process id="A29_B_EventGwExklusiv" name="B: Instanziierendes ereignisbasiertes Gateway – exklusiv (nur Ansicht)" isExecutable="false">
    <bpmn:documentation>Folie 29 Mitte: Wartet auf das erste Ereignis, nur dieser Pfad startet. In Camunda 7 nicht ausführbar.</bpmn:documentation>
    <bpmn:eventBasedGateway id="A29B_Gw" instantiate="true" eventGatewayType="Exclusive">
      <bpmn:outgoing>Flow_A29B_Gw_A29B_Msg</bpmn:outgoing>
      <bpmn:outgoing>Flow_A29B_Gw_A29B_Tim</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="A29B_Msg" name="Create Report via Message">
      <bpmn:incoming>Flow_A29B_Gw_A29B_Msg</bpmn:incoming>
      <bpmn:outgoing>Flow_A29B_Msg_A29B_Calc</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_A29B_Msg" messageRef="Message_A29_ReportAnfrage" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="A29B_Tim" name="Create Report at end of month">
      <bpmn:incoming>Flow_A29B_Gw_A29B_Tim</bpmn:incoming>
      <bpmn:outgoing>Flow_A29B_Tim_A29B_Xor</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_A29B_Tim">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 0 L * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="A29B_Calc" name="Calculate time period for report">
      <bpmn:incoming>Flow_A29B_Msg_A29B_Calc</bpmn:incoming>
      <bpmn:outgoing>Flow_A29B_Calc_A29B_Xor</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="A29B_Xor">
      <bpmn:incoming>Flow_A29B_Calc_A29B_Xor</bpmn:incoming>
      <bpmn:incoming>Flow_A29B_Tim_A29B_Xor</bpmn:incoming>
      <bpmn:outgoing>Flow_A29B_Xor_A29B_Rep</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A29B_Rep" name="Create report">
      <bpmn:incoming>Flow_A29B_Xor_A29B_Rep</bpmn:incoming>
      <bpmn:outgoing>Flow_A29B_Rep_A29B_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="A29B_End">
      <bpmn:incoming>Flow_A29B_Rep_A29B_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_A29B_Gw_A29B_Msg" sourceRef="A29B_Gw" targetRef="A29B_Msg" />
    <bpmn:sequenceFlow id="Flow_A29B_Gw_A29B_Tim" sourceRef="A29B_Gw" targetRef="A29B_Tim" />
    <bpmn:sequenceFlow id="Flow_A29B_Msg_A29B_Calc" sourceRef="A29B_Msg" targetRef="A29B_Calc" />
    <bpmn:sequenceFlow id="Flow_A29B_Calc_A29B_Xor" sourceRef="A29B_Calc" targetRef="A29B_Xor" />
    <bpmn:sequenceFlow id="Flow_A29B_Tim_A29B_Xor" sourceRef="A29B_Tim" targetRef="A29B_Xor" />
    <bpmn:sequenceFlow id="Flow_A29B_Xor_A29B_Rep" sourceRef="A29B_Xor" targetRef="A29B_Rep" />
    <bpmn:sequenceFlow id="Flow_A29B_Rep_A29B_End" sourceRef="A29B_Rep" targetRef="A29B_End" />
  </bpmn:process>
  <bpmn:process id="A29_C_EventGwParallel" name="C: Instanziierendes ereignisbasiertes Gateway – parallel (nur Ansicht)" isExecutable="false">
    <bpmn:documentation>Folie 29 unten: ALLE Ereignisse müssen eintreffen, bevor es weitergeht. In Camunda 7 nicht ausführbar.</bpmn:documentation>
    <bpmn:eventBasedGateway id="A29C_Gw" instantiate="true" eventGatewayType="Parallel">
      <bpmn:outgoing>Flow_A29C_Gw_A29C_Msg</bpmn:outgoing>
      <bpmn:outgoing>Flow_A29C_Gw_A29C_Tim</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="A29C_Msg" name="Create Report">
      <bpmn:incoming>Flow_A29C_Gw_A29C_Msg</bpmn:incoming>
      <bpmn:outgoing>Flow_A29C_Msg_A29C_Join</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_A29C_Msg" messageRef="Message_A29_ReportAnfrage" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="A29C_Tim" name="End of Month Reached">
      <bpmn:incoming>Flow_A29C_Gw_A29C_Tim</bpmn:incoming>
      <bpmn:outgoing>Flow_A29C_Tim_A29C_Join</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_A29C_Tim">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 0 L * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="A29C_Join">
      <bpmn:incoming>Flow_A29C_Msg_A29C_Join</bpmn:incoming>
      <bpmn:incoming>Flow_A29C_Tim_A29C_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_A29C_Join_A29C_Rep</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="A29C_Rep" name="Create report">
      <bpmn:incoming>Flow_A29C_Join_A29C_Rep</bpmn:incoming>
      <bpmn:outgoing>Flow_A29C_Rep_A29C_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="A29C_End">
      <bpmn:incoming>Flow_A29C_Rep_A29C_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_A29C_Gw_A29C_Msg" sourceRef="A29C_Gw" targetRef="A29C_Msg" />
    <bpmn:sequenceFlow id="Flow_A29C_Gw_A29C_Tim" sourceRef="A29C_Gw" targetRef="A29C_Tim" />
    <bpmn:sequenceFlow id="Flow_A29C_Msg_A29C_Join" sourceRef="A29C_Msg" targetRef="A29C_Join" />
    <bpmn:sequenceFlow id="Flow_A29C_Tim_A29C_Join" sourceRef="A29C_Tim" targetRef="A29C_Join" />
    <bpmn:sequenceFlow id="Flow_A29C_Join_A29C_Rep" sourceRef="A29C_Join" targetRef="A29C_Rep" />
    <bpmn:sequenceFlow id="Flow_A29C_Rep_A29C_End" sourceRef="A29C_Rep" targetRef="A29C_End" />
  </bpmn:process>
  <bpmn:message id="Message_A29_ReportAnfrage" name="A29_ReportAnfrage" />
