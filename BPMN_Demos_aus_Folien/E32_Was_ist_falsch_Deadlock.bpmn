    <bpmn:participant id="P_E32_B" name="B: Korrigierte Version" processRef="E32_B_Korrigiert" />
  </bpmn:collaboration>
  <bpmn:process id="E32_A_Deadlock" name="A: Modell der Folie (DEADLOCK)" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Folie 32: Fehler! Das erste parallele Gateway hat 2 eingehende Pfeile (von 'Enter Change Order' und von der Schleife). Ein paralleles Gateway wartet auf ALLE eingehenden Token – das Schleifen-Token kommt am Anfang nie -&gt; Deadlock. Im Cockpit siehst du: die Instanz hängt dauerhaft vor dem Gateway.</bpmn:documentation>
    <bpmn:startEvent id="E32A_Start" name="Change Order">
      <bpmn:outgoing>Flow_E32A_Start_E32A_Enter</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_E32A_Start" messageRef="Message_E32_A_Aenderung" />
    </bpmn:startEvent>
    <bpmn:userTask id="E32A_Enter" name="Enter Change Order" camunda:assignee="demo">
      <bpmn:incoming>Flow_E32A_Start_E32A_Enter</bpmn:incoming>
      <bpmn:outgoing>Flow_E32A_Enter_E32A_Split</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="E32A_Split">
      <bpmn:incoming>Flow_E32A_Enter_E32A_Split</bpmn:incoming>
      <bpmn:incoming>Flow_E32A_Gw_E32A_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_E32A_Split_E32A_U0</bpmn:outgoing>
      <bpmn:outgoing>Flow_E32A_Split_E32A_U1</bpmn:outgoing>
      <bpmn:outgoing>Flow_E32A_Split_E32A_U2</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="E32A_U0" name="Update Order Data" camunda:assignee="demo">
      <bpmn:incoming>Flow_E32A_Split_E32A_U0</bpmn:incoming>
      <bpmn:outgoing>Flow_E32A_U0_E32A_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="E32A_U1" name="Update Budget Data" camunda:assignee="demo">
      <bpmn:incoming>Flow_E32A_Split_E32A_U1</bpmn:incoming>
      <bpmn:outgoing>Flow_E32A_U1_E32A_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="E32A_U2" name="Update Resource Planning" camunda:assignee="demo">
      <bpmn:incoming>Flow_E32A_Split_E32A_U2</bpmn:incoming>
      <bpmn:outgoing>Flow_E32A_U2_E32A_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="E32A_Join">
      <bpmn:incoming>Flow_E32A_U0_E32A_Join</bpmn:incoming>
      <bpmn:incoming>Flow_E32A_U1_E32A_Join</bpmn:incoming>
      <bpmn:incoming>Flow_E32A_U2_E32A_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_E32A_Join_E32A_Decide</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="E32A_Decide" name="Decide on Changes" camunda:assignee="demo">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="accepted" label="Accepted?" type="boolean" defaultValue="True" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_E32A_Join_E32A_Decide</bpmn:incoming>
      <bpmn:outgoing>Flow_E32A_Decide_E32A_Gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="E32A_Gw" name="Accepted?">
      <bpmn:incoming>Flow_E32A_Decide_E32A_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_E32A_Gw_E32A_End</bpmn:outgoing>
      <bpmn:outgoing>Flow_E32A_Gw_E32A_Split</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E32A_End">
      <bpmn:incoming>Flow_E32A_Gw_E32A_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_E32A_Split_E32A_U0" sourceRef="E32A_Split" targetRef="E32A_U0" />
    <bpmn:sequenceFlow id="Flow_E32A_Split_E32A_U1" sourceRef="E32A_Split" targetRef="E32A_U1" />
    <bpmn:sequenceFlow id="Flow_E32A_Split_E32A_U2" sourceRef="E32A_Split" targetRef="E32A_U2" />
