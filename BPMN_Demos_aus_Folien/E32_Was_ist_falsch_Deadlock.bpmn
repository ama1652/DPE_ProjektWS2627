      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${accepted}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_E32A_Gw_E32A_Split" name="No" sourceRef="E32A_Gw" targetRef="E32A_Split">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!accepted}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="E32_B_Korrigiert" name="B: Korrigierte Version" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Korrektur: Zuerst ein EXKLUSIVES Gateway zum Zusammenführen (Anfang + Schleife), danach das parallele Gateway zum Aufteilen.</bpmn:documentation>
