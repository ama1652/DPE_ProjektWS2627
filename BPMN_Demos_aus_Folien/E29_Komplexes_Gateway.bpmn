      <bpmndi:BPMNEdge id="Flow_E29A_Split_E29A_SendBill_di" bpmnElement="Flow_E29A_Split_E29A_SendBill"><di:waypoint x="455" y="275" /><di:waypoint x="490" y="275" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E29A_SendBill_E29A_RecBill_di" bpmnElement="Flow_E29A_SendBill_E29A_RecBill"><di:waypoint x="590" y="275" /><di:waypoint x="642" y="275" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E29A_RecBill_E29A_Cx_di" bpmnElement="Flow_E29A_RecBill_E29A_Cx"><di:waypoint x="678" y="275" /><di:waypoint x="755" y="275" /></bpmndi:BPMNEdge>
