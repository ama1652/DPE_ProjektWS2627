<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_A10_A11_Parallelitaet_Deadlock" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_A10_A11_Parallelitaet_Deadlock">
    <bpmn:participant id="P_A10" name="A: Folie 10 – parallele Verarbeitung" processRef="A10_Parallel" />
    <bpmn:participant id="P_A11_B" name="B: Folie 11 oben – DEADLOCK mit parallelem Join" processRef="A11_B_Deadlock" />
    <bpmn:participant id="P_A11_C" name="C: Folie 11 unten – Lösung mit inklusivem Join" processRef="A11_C_Inklusiv" />
  </bpmn:collaboration>
  <bpmn:process id="A10_Parallel" name="A: Folie 10 – parallele Verarbeitung" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Folie 10: Keine Abhängigkeiten zwischen den Aktivitäten -&gt; paralleles Gateway. Immer paarweise: AND aufteilen, AND zusammenführen. Hier als Benutzeraufgaben, damit du die 3 parallelen Aufgaben gleichzeitig in der Tasklist siehst.</bpmn:documentation>
    <bpmn:startEvent id="A10_Start">
      <bpmn:outgoing>Flow_A10_Start_A10_Split</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="A10_Split">
      <bpmn:incoming>Flow_A10_Start_A10_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_A10_Split_A10_S1</bpmn:outgoing>
      <bpmn:outgoing>Flow_A10_Split_A10_S2</bpmn:outgoing>
      <bpmn:outgoing>Flow_A10_Split_A10_S3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="A10_Join">
      <bpmn:incoming>Flow_A10_S1_A10_Join</bpmn:incoming>
      <bpmn:incoming>Flow_A10_S2_A10_Join</bpmn:incoming>
      <bpmn:incoming>Flow_A10_S3_A10_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_A10_Join_A10_End</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="A10_End">
      <bpmn:incoming>Flow_A10_Join_A10_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="A10_S1" name="System 1" camunda:assignee="demo">
      <bpmn:incoming>Flow_A10_Split_A10_S1</bpmn:incoming>
      <bpmn:outgoing>Flow_A10_S1_A10_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="A10_S2" name="System 2" camunda:assignee="demo">
      <bpmn:incoming>Flow_A10_Split_A10_S2</bpmn:incoming>
      <bpmn:outgoing>Flow_A10_S2_A10_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="A10_S3" name="System 3" camunda:assignee="demo">
      <bpmn:incoming>Flow_A10_Split_A10_S3</bpmn:incoming>
      <bpmn:outgoing>Flow_A10_S3_A10_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_A10_Split_A10_S1" sourceRef="A10_Split" targetRef="A10_S1" />
    <bpmn:sequenceFlow id="Flow_A10_S1_A10_Join" sourceRef="A10_S1" targetRef="A10_Join" />
    <bpmn:sequenceFlow id="Flow_A10_Split_A10_S2" sourceRef="A10_Split" targetRef="A10_S2" />
    <bpmn:sequenceFlow id="Flow_A10_S2_A10_Join" sourceRef="A10_S2" targetRef="A10_Join" />
    <bpmn:sequenceFlow id="Flow_A10_Split_A10_S3" sourceRef="A10_Split" targetRef="A10_S3" />
    <bpmn:sequenceFlow id="Flow_A10_S3_A10_Join" sourceRef="A10_S3" targetRef="A10_Join" />
    <bpmn:sequenceFlow id="Flow_A10_Start_A10_Split" sourceRef="A10_Start" targetRef="A10_Split" />
    <bpmn:sequenceFlow id="Flow_A10_Join_A10_End" sourceRef="A10_Join" targetRef="A10_End" />
  </bpmn:process>
  <bpmn:process id="A11_B_Deadlock" name="B: Folie 11 oben – DEADLOCK mit parallelem Join" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Folie 11 oben: Wählst du 'Compliance ok', kommen nur 2 von 3 Token am parallelen Join an -&gt; Deadlock, die Instanz hängt.</bpmn:documentation>
    <bpmn:startEvent id="A11B_Start">
      <bpmn:outgoing>Flow_A11B_Start_A11B_Draft</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="A11B_Draft" name="Draft Contract" camunda:assignee="demo">
      <bpmn:incoming>Flow_A11B_Start_A11B_Draft</bpmn:incoming>
      <bpmn:outgoing>Flow_A11B_Draft_A11B_Split</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="A11B_Split">
      <bpmn:incoming>Flow_A11B_Draft_A11B_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_A11B_Split_A11B_Legal</bpmn:outgoing>
      <bpmn:outgoing>Flow_A11B_Split_A11B_Fin</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="A11B_Legal" name="Perform legal review" camunda:assignee="demo">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="complianceOk" label="Compliance ok?" type="boolean" defaultValue="True" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A11B_Split_A11B_Legal</bpmn:incoming>
      <bpmn:outgoing>Flow_A11B_Legal_A11B_Xor</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="A11B_Fin" name="Perform financial review" camunda:assignee="demo">
      <bpmn:incoming>Flow_A11B_Split_A11B_Fin</bpmn:incoming>
      <bpmn:outgoing>Flow_A11B_Fin_A11B_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="A11B_Xor">
      <bpmn:incoming>Flow_A11B_Legal_A11B_Xor</bpmn:incoming>
      <bpmn:outgoing>Flow_A11B_Xor_A11B_Modify</bpmn:outgoing>
      <bpmn:outgoing>Flow_A11B_Xor_A11B_Join</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A11B_Modify" name="Modify contract for compliance" camunda:assignee="demo">
      <bpmn:incoming>Flow_A11B_Xor_A11B_Modify</bpmn:incoming>
      <bpmn:outgoing>Flow_A11B_Modify_A11B_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="A11B_Join">
      <bpmn:incoming>Flow_A11B_Xor_A11B_Join</bpmn:incoming>
      <bpmn:incoming>Flow_A11B_Modify_A11B_Join</bpmn:incoming>
      <bpmn:incoming>Flow_A11B_Fin_A11B_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_A11B_Join_A11B_Final</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="A11B_Final" name="Finalize contract" camunda:assignee="demo">
      <bpmn:incoming>Flow_A11B_Join_A11B_Final</bpmn:incoming>
      <bpmn:outgoing>Flow_A11B_Final_A11B_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="A11B_End">
      <bpmn:incoming>Flow_A11B_Final_A11B_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_A11B_Start_A11B_Draft" sourceRef="A11B_Start" targetRef="A11B_Draft" />
    <bpmn:sequenceFlow id="Flow_A11B_Draft_A11B_Split" sourceRef="A11B_Draft" targetRef="A11B_Split" />
    <bpmn:sequenceFlow id="Flow_A11B_Split_A11B_Legal" sourceRef="A11B_Split" targetRef="A11B_Legal" />
    <bpmn:sequenceFlow id="Flow_A11B_Split_A11B_Fin" sourceRef="A11B_Split" targetRef="A11B_Fin" />
    <bpmn:sequenceFlow id="Flow_A11B_Legal_A11B_Xor" sourceRef="A11B_Legal" targetRef="A11B_Xor" />
    <bpmn:sequenceFlow id="Flow_A11B_Xor_A11B_Modify" name="Compliance issues" sourceRef="A11B_Xor" targetRef="A11B_Modify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!complianceOk}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A11B_Xor_A11B_Join" name="Compliance ok" sourceRef="A11B_Xor" targetRef="A11B_Join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${complianceOk}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A11B_Modify_A11B_Join" sourceRef="A11B_Modify" targetRef="A11B_Join" />
    <bpmn:sequenceFlow id="Flow_A11B_Fin_A11B_Join" sourceRef="A11B_Fin" targetRef="A11B_Join" />
    <bpmn:sequenceFlow id="Flow_A11B_Join_A11B_Final" sourceRef="A11B_Join" targetRef="A11B_Final" />
    <bpmn:sequenceFlow id="Flow_A11B_Final_A11B_End" sourceRef="A11B_Final" targetRef="A11B_End" />
  </bpmn:process>
  <bpmn:process id="A11_C_Inklusiv" name="C: Folie 11 unten – Lösung mit inklusivem Join" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Folie 11 unten: Das inklusive Gateway erkennt, dass von 'Modify contract' kein Token mehr kommen kann, und läuft weiter.</bpmn:documentation>
    <bpmn:startEvent id="A11C_Start">
      <bpmn:outgoing>Flow_A11C_Start_A11C_Draft</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="A11C_Draft" name="Draft Contract" camunda:assignee="demo">
      <bpmn:incoming>Flow_A11C_Start_A11C_Draft</bpmn:incoming>
      <bpmn:outgoing>Flow_A11C_Draft_A11C_Split</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="A11C_Split">
      <bpmn:incoming>Flow_A11C_Draft_A11C_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_A11C_Split_A11C_Legal</bpmn:outgoing>
      <bpmn:outgoing>Flow_A11C_Split_A11C_Fin</bpmn:outgoing>
    </bpmn:parallelGateway>
