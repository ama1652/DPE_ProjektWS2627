      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="complianceOk" label="Compliance ok?" type="boolean" defaultValue="True" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A11C_Split_A11C_Legal</bpmn:incoming>
      <bpmn:outgoing>Flow_A11C_Legal_A11C_Xor</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="A11C_Fin" name="Perform financial review" camunda:assignee="demo">
      <bpmn:incoming>Flow_A11C_Split_A11C_Fin</bpmn:incoming>
      <bpmn:outgoing>Flow_A11C_Fin_A11C_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="A11C_Xor">
      <bpmn:incoming>Flow_A11C_Legal_A11C_Xor</bpmn:incoming>
      <bpmn:outgoing>Flow_A11C_Xor_A11C_Modify</bpmn:outgoing>
      <bpmn:outgoing>Flow_A11C_Xor_A11C_Join</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A11C_Modify" name="Modify contract for compliance" camunda:assignee="demo">
      <bpmn:incoming>Flow_A11C_Xor_A11C_Modify</bpmn:incoming>
      <bpmn:outgoing>Flow_A11C_Modify_A11C_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:inclusiveGateway id="A11C_Join">
      <bpmn:incoming>Flow_A11C_Xor_A11C_Join</bpmn:incoming>
      <bpmn:incoming>Flow_A11C_Modify_A11C_Join</bpmn:incoming>
      <bpmn:incoming>Flow_A11C_Fin_A11C_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_A11C_Join_A11C_Final</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:userTask id="A11C_Final" name="Finalize contract" camunda:assignee="demo">
      <bpmn:incoming>Flow_A11C_Join_A11C_Final</bpmn:incoming>
      <bpmn:outgoing>Flow_A11C_Final_A11C_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="A11C_End">
      <bpmn:incoming>Flow_A11C_Final_A11C_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_A11C_Start_A11C_Draft" sourceRef="A11C_Start" targetRef="A11C_Draft" />
    <bpmn:sequenceFlow id="Flow_A11C_Draft_A11C_Split" sourceRef="A11C_Draft" targetRef="A11C_Split" />
