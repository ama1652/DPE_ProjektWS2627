<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_A25_Kompensation_im_Teilprozess" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_A25_Kompensation_im_Teilprozess">
    <bpmn:participant id="P_A25_PDA" name="Process Driven Application" />
    <bpmn:participant id="P_A25_SCIL" name="Service Contract Implementation Layer" processRef="A25_ServiceContract" />
    <bpmn:participant id="P_A25_SP" name="Service Provider" />
    <bpmn:messageFlow id="MsgFlow_P_A25_PDA_A25_Start" sourceRef="P_A25_PDA" targetRef="A25_Start" />
    <bpmn:messageFlow id="MsgFlow_A25_EndOk_P_A25_PDA" sourceRef="A25_EndOk" targetRef="P_A25_PDA" />
    <bpmn:messageFlow id="MsgFlow_A25_EndErr_P_A25_PDA" sourceRef="A25_EndErr" targetRef="P_A25_PDA" />
  </bpmn:collaboration>
  <bpmn:process id="A25_ServiceContract" name="Service Contract Implementation Layer" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Folie 25: Kompensation in einem NORMALEN Teilprozess (ohne Transaktion). (1) Während der Ausführung: Fehler ERROR_1 an Service 3 auslösen (./dpe-demo.sh error &lt;taskId&gt; ERROR_1) -&gt; Ereignis-Teilprozess kompensiert Service 2 und 1 rückwärts und wirft ERROR_2 -&gt; außen Fehlermeldung. (2) Nach Abschluss: bei der 'Follow-Up Task' Fehler FOLLOWUP_FEHLER auslösen -&gt; Rollback des ganzen Teilprozesses (Ereignis-Teilprozess 'Compensation Handling after Sub-Process Finalization' kompensiert 3, 2, 1).</bpmn:documentation>
    <bpmn:startEvent id="A25_Start" name="Service-Request">
      <bpmn:outgoing>Flow_A25_Start_A25_Sub</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_A25_Start" messageRef="Message_A25_ServiceRequest" />
    </bpmn:startEvent>
    <bpmn:subProcess id="A25_Sub" name="Ordinary Sub-Process">
      <bpmn:incoming>Flow_A25_Start_A25_Sub</bpmn:incoming>
      <bpmn:outgoing>Flow_A25_Sub_A25_Follow</bpmn:outgoing>
      <bpmn:startEvent id="A25_S_Start">
        <bpmn:outgoing>Flow_A25_S_Start_A25_Sv1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="A25_S_End">
        <bpmn:incoming>Flow_A25_Sv3_A25_S_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="A25_Sv1" name="Service 1 (System-Simulation)" camunda:assignee="demo">
        <bpmn:documentation>Im Original ein automatischer Service Task. Hier als Benutzeraufgabe simuliert, damit du Zeit hast, Ereignisse auszulösen (Nachricht, Fehler, Eskalation). </bpmn:documentation>
        <bpmn:incoming>Flow_A25_S_Start_A25_Sv1</bpmn:incoming>
        <bpmn:outgoing>Flow_A25_Sv1_A25_Sv2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="A25_CB1" attachedToRef="A25_Sv1">
        <bpmn:compensateEventDefinition id="CompensateDef_A25_CB1" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="A25_CH1" name="Compensation Service 1" camunda:assignee="demo" isForCompensation="true">
      </bpmn:userTask>
      <bpmn:userTask id="A25_Sv2" name="Service 2 (System-Simulation)" camunda:assignee="demo">
        <bpmn:documentation>Im Original ein automatischer Service Task. Hier als Benutzeraufgabe simuliert, damit du Zeit hast, Ereignisse auszulösen (Nachricht, Fehler, Eskalation). </bpmn:documentation>
        <bpmn:incoming>Flow_A25_Sv1_A25_Sv2</bpmn:incoming>
        <bpmn:outgoing>Flow_A25_Sv2_A25_Sv3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="A25_CB2" attachedToRef="A25_Sv2">
        <bpmn:compensateEventDefinition id="CompensateDef_A25_CB2" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="A25_CH2" name="Compensation Service 2" camunda:assignee="demo" isForCompensation="true">
      </bpmn:userTask>
      <bpmn:userTask id="A25_Sv3" name="Service 3 (System-Simulation)" camunda:assignee="demo">
        <bpmn:documentation>Im Original ein automatischer Service Task. Hier als Benutzeraufgabe simuliert, damit du Zeit hast, Ereignisse auszulösen (Nachricht, Fehler, Eskalation). </bpmn:documentation>
        <bpmn:incoming>Flow_A25_Sv2_A25_Sv3</bpmn:incoming>
        <bpmn:outgoing>Flow_A25_Sv3_A25_S_End</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="A25_CB3" attachedToRef="A25_Sv3">
        <bpmn:compensateEventDefinition id="CompensateDef_A25_CB3" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="A25_CH3" name="Compensation Service 3" camunda:assignee="demo" isForCompensation="true">
      </bpmn:userTask>
      <bpmn:subProcess id="A25_ES1" name="Compensation Handling after Sub-Process Finalization" triggeredByEvent="true">
        <bpmn:startEvent id="A25_ES1_Start" name="Rollback">
          <bpmn:outgoing>Flow_A25_ES1_Start_A25_ES1_C3</bpmn:outgoing>
          <bpmn:compensateEventDefinition id="CompensateDef_A25_ES1_Start" />
        </bpmn:startEvent>
        <bpmn:intermediateThrowEvent id="A25_ES1_C3" name="Compensation Service 3">
          <bpmn:incoming>Flow_A25_ES1_Start_A25_ES1_C3</bpmn:incoming>
          <bpmn:outgoing>Flow_A25_ES1_C3_A25_ES1_C2</bpmn:outgoing>
          <bpmn:compensateEventDefinition id="CompensateDef_A25_ES1_C3" activityRef="A25_Sv3" />
        </bpmn:intermediateThrowEvent>
        <bpmn:intermediateThrowEvent id="A25_ES1_C2" name="Compensation Service 2">
          <bpmn:incoming>Flow_A25_ES1_C3_A25_ES1_C2</bpmn:incoming>
          <bpmn:outgoing>Flow_A25_ES1_C2_A25_ES1_C1</bpmn:outgoing>
          <bpmn:compensateEventDefinition id="CompensateDef_A25_ES1_C2" activityRef="A25_Sv2" />
        </bpmn:intermediateThrowEvent>
        <bpmn:intermediateThrowEvent id="A25_ES1_C1" name="Compensation Service 1">
          <bpmn:incoming>Flow_A25_ES1_C2_A25_ES1_C1</bpmn:incoming>
          <bpmn:outgoing>Flow_A25_ES1_C1_A25_ES1_End</bpmn:outgoing>
          <bpmn:compensateEventDefinition id="CompensateDef_A25_ES1_C1" activityRef="A25_Sv1" />
        </bpmn:intermediateThrowEvent>
        <bpmn:endEvent id="A25_ES1_End">
          <bpmn:incoming>Flow_A25_ES1_C1_A25_ES1_End</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_A25_ES1_Start_A25_ES1_C3" sourceRef="A25_ES1_Start" targetRef="A25_ES1_C3" />
        <bpmn:sequenceFlow id="Flow_A25_ES1_C3_A25_ES1_C2" sourceRef="A25_ES1_C3" targetRef="A25_ES1_C2" />
        <bpmn:sequenceFlow id="Flow_A25_ES1_C2_A25_ES1_C1" sourceRef="A25_ES1_C2" targetRef="A25_ES1_C1" />
        <bpmn:sequenceFlow id="Flow_A25_ES1_C1_A25_ES1_End" sourceRef="A25_ES1_C1" targetRef="A25_ES1_End" />
      </bpmn:subProcess>
      <bpmn:subProcess id="A25_ES2" name="Compensation Handling During Sub-Process Execution" triggeredByEvent="true">
        <bpmn:startEvent id="A25_ES2_Start" name="Error 1">
          <bpmn:outgoing>Flow_A25_ES2_Start_A25_ES2_C2</bpmn:outgoing>
          <bpmn:errorEventDefinition id="ErrorDef_A25_ES2_Start" errorRef="Error_ERROR_1" />
        </bpmn:startEvent>
        <bpmn:intermediateThrowEvent id="A25_ES2_C2" name="Compensation Service 2">
          <bpmn:incoming>Flow_A25_ES2_Start_A25_ES2_C2</bpmn:incoming>
          <bpmn:outgoing>Flow_A25_ES2_C2_A25_ES2_C1</bpmn:outgoing>
          <bpmn:compensateEventDefinition id="CompensateDef_A25_ES2_C2" activityRef="A25_Sv2" />
        </bpmn:intermediateThrowEvent>
        <bpmn:intermediateThrowEvent id="A25_ES2_C1" name="Compensation Service 1">
          <bpmn:incoming>Flow_A25_ES2_C2_A25_ES2_C1</bpmn:incoming>
          <bpmn:outgoing>Flow_A25_ES2_C1_A25_ES2_End</bpmn:outgoing>
          <bpmn:compensateEventDefinition id="CompensateDef_A25_ES2_C1" activityRef="A25_Sv1" />
        </bpmn:intermediateThrowEvent>
        <bpmn:endEvent id="A25_ES2_End" name="Error 2">
          <bpmn:incoming>Flow_A25_ES2_C1_A25_ES2_End</bpmn:incoming>
          <bpmn:errorEventDefinition id="ErrorDef_A25_ES2_End" errorRef="Error_ERROR_2" />
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_A25_ES2_Start_A25_ES2_C2" sourceRef="A25_ES2_Start" targetRef="A25_ES2_C2" />
        <bpmn:sequenceFlow id="Flow_A25_ES2_C2_A25_ES2_C1" sourceRef="A25_ES2_C2" targetRef="A25_ES2_C1" />
        <bpmn:sequenceFlow id="Flow_A25_ES2_C1_A25_ES2_End" sourceRef="A25_ES2_C1" targetRef="A25_ES2_End" />
      </bpmn:subProcess>
      <bpmn:sequenceFlow id="Flow_A25_S_Start_A25_Sv1" sourceRef="A25_S_Start" targetRef="A25_Sv1" />
      <bpmn:sequenceFlow id="Flow_A25_Sv1_A25_Sv2" sourceRef="A25_Sv1" targetRef="A25_Sv2" />
      <bpmn:sequenceFlow id="Flow_A25_Sv2_A25_Sv3" sourceRef="A25_Sv2" targetRef="A25_Sv3" />
      <bpmn:sequenceFlow id="Flow_A25_Sv3_A25_S_End" sourceRef="A25_Sv3" targetRef="A25_S_End" />
      <bpmn:association id="Assoc_A25_CB1_A25_CH1" associationDirection="One" sourceRef="A25_CB1" targetRef="A25_CH1" />
      <bpmn:association id="Assoc_A25_CB2_A25_CH2" associationDirection="One" sourceRef="A25_CB2" targetRef="A25_CH2" />
      <bpmn:association id="Assoc_A25_CB3_A25_CH3" associationDirection="One" sourceRef="A25_CB3" targetRef="A25_CH3" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="A25_BErr2" name="Error 2" attachedToRef="A25_Sub">
      <bpmn:outgoing>Flow_A25_BErr2_A25_EndErr</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_A25_BErr2" errorRef="Error_ERROR_2" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="A25_Follow" name="Follow-Up Task" camunda:assignee="demo">
      <bpmn:documentation>Fehler auslösen: ./dpe-demo.sh error &lt;taskId&gt; FOLLOWUP_FEHLER</bpmn:documentation>
      <bpmn:incoming>Flow_A25_Sub_A25_Follow</bpmn:incoming>
      <bpmn:outgoing>Flow_A25_Follow_A25_EndOk</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="A25_EndOk" name="Service-Response">
      <bpmn:incoming>Flow_A25_Follow_A25_EndOk</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageDef_A25_EndOk" messageRef="Message_A25_Response" camunda:expression="${execution.setVariable('letzteNachricht', 'Erfolgreich')}" />
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="A25_BFollow" attachedToRef="A25_Follow">
      <bpmn:outgoing>Flow_A25_BFollow_A25_Rollback</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_A25_BFollow" errorRef="Error_FOLLOWUP_FEHLER" />
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="A25_Rollback" name="Rollback">
      <bpmn:incoming>Flow_A25_BFollow_A25_Rollback</bpmn:incoming>
      <bpmn:outgoing>Flow_A25_Rollback_A25_EndErr</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CompensateDef_A25_Rollback" activityRef="A25_Sub" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="A25_EndErr" name="Error Message">
      <bpmn:incoming>Flow_A25_Rollback_A25_EndErr</bpmn:incoming>
      <bpmn:incoming>Flow_A25_BErr2_A25_EndErr</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageDef_A25_EndErr" messageRef="Message_A25_Error" camunda:expression="${execution.setVariable('letzteNachricht', 'Fehlermeldung')}" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_A25_Start_A25_Sub" sourceRef="A25_Start" targetRef="A25_Sub" />
    <bpmn:sequenceFlow id="Flow_A25_Sub_A25_Follow" sourceRef="A25_Sub" targetRef="A25_Follow" />
    <bpmn:sequenceFlow id="Flow_A25_Follow_A25_EndOk" sourceRef="A25_Follow" targetRef="A25_EndOk" />
    <bpmn:sequenceFlow id="Flow_A25_BFollow_A25_Rollback" sourceRef="A25_BFollow" targetRef="A25_Rollback" />
    <bpmn:sequenceFlow id="Flow_A25_Rollback_A25_EndErr" sourceRef="A25_Rollback" targetRef="A25_EndErr" />
    <bpmn:sequenceFlow id="Flow_A25_BErr2_A25_EndErr" sourceRef="A25_BErr2" targetRef="A25_EndErr" />
  </bpmn:process>
  <bpmn:message id="Message_A25_ServiceRequest" name="A25_ServiceRequest" />
  <bpmn:message id="Message_A25_Response" name="A25_Response" />
  <bpmn:message id="Message_A25_Error" name="A25_Error" />
