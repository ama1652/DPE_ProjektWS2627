  <bpmn:process id="E31_ConditionalFlow" name="C: Conditional Flow direkt an der Aufgabe – Folie 31" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Folie 31: Bedingte Flüsse direkt an der Aufgabe (kleine Raute). Verhalten wie ein INKLUSIVES Gateway: jeder Fluss mit wahrer Bedingung wird genommen. Laut Notizen in der Vorlesung nicht verwenden. Hier sind die Bedingungen überschneidungsfrei; Task 4 ist der Default Flow.</bpmn:documentation>
    <bpmn:startEvent id="E31_Start">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="x" label="Bestellwert x" type="long" defaultValue="20000" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_E31_Start_E31_Check</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="E31_Check" name="Check Order Request" camunda:assignee="demo" default="Flow_E31_Check_E31_T4">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="x" label="Bestellwert x" type="long" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_E31_Start_E31_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_E31_Check_E31_T1</bpmn:outgoing>
