<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_E30_E31_Default_und_Conditional_Flow" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_E30_E31_Default_und_Conditional_Flow">
    <bpmn:participant id="P_E30_A" name="A: XOR mit Marker (X) und Default Flow – Folie 30 links" processRef="E30_A_DefaultFlow" />
    <bpmn:participant id="P_E30_B" name="B: XOR ohne Marker (gleiche Bedeutung, laut Notizen nicht verwenden) – Folie 30 rechts" processRef="E30_B_DefaultFlow" />
    <bpmn:participant id="P_E31_C" name="C: Conditional Flow direkt an der Aufgabe – Folie 31" processRef="E31_ConditionalFlow" />
  </bpmn:collaboration>
  <bpmn:process id="E30_A_DefaultFlow" name="A: XOR mit Marker (X) und Default Flow – Folie 30 links" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Folie 30: Genau EIN Pfad wird genommen. Trifft keine Bedingung zu, greift der Default Flow (Schrägstrich) -&gt; Task 4. Ohne Default Flow würde der Prozess mit einem Fehler stehen bleiben.</bpmn:documentation>
    <bpmn:startEvent id="E30A_Start">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="x" label="Bestellwert x" type="long" defaultValue="20000" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_E30A_Start_E30A_Check</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="E30A_Check" name="Check Order Request" camunda:assignee="demo">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="x" label="Bestellwert x" type="long" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_E30A_Start_E30A_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_E30A_Check_E30A_Gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="E30A_Gw" default="Flow_E30A_Gw_E30A_T4">
      <bpmn:incoming>Flow_E30A_Check_E30A_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_E30A_Gw_E30A_T1</bpmn:outgoing>
      <bpmn:outgoing>Flow_E30A_Gw_E30A_T2</bpmn:outgoing>
      <bpmn:outgoing>Flow_E30A_Gw_E30A_T3</bpmn:outgoing>
      <bpmn:outgoing>Flow_E30A_Gw_E30A_T4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="E30A_Merge">
      <bpmn:incoming>Flow_E30A_T1_E30A_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_E30A_T2_E30A_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_E30A_T3_E30A_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_E30A_T4_E30A_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_E30A_Merge_E30A_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E30A_End">
      <bpmn:incoming>Flow_E30A_Merge_E30A_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="E30A_T1" name="Task 1" camunda:assignee="demo">
      <bpmn:incoming>Flow_E30A_Gw_E30A_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_E30A_T1_E30A_Merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="E30A_T2" name="Task 2" camunda:assignee="demo">
      <bpmn:incoming>Flow_E30A_Gw_E30A_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_E30A_T2_E30A_Merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="E30A_T3" name="Task 3" camunda:assignee="demo">
      <bpmn:incoming>Flow_E30A_Gw_E30A_T3</bpmn:incoming>
      <bpmn:outgoing>Flow_E30A_T3_E30A_Merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="E30A_T4" name="Task 4" camunda:assignee="demo">
      <bpmn:incoming>Flow_E30A_Gw_E30A_T4</bpmn:incoming>
      <bpmn:outgoing>Flow_E30A_T4_E30A_Merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_E30A_Gw_E30A_T1" name="x&lt;10.000" sourceRef="E30A_Gw" targetRef="E30A_T1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${x &lt; 10000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_E30A_T1_E30A_Merge" sourceRef="E30A_T1" targetRef="E30A_Merge" />
    <bpmn:sequenceFlow id="Flow_E30A_Gw_E30A_T2" name="10.000&lt;= x &lt;50.000" sourceRef="E30A_Gw" targetRef="E30A_T2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${x &gt;= 10000 &amp;&amp; x &lt; 50000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_E30A_T2_E30A_Merge" sourceRef="E30A_T2" targetRef="E30A_Merge" />
    <bpmn:sequenceFlow id="Flow_E30A_Gw_E30A_T3" name="50.000&lt;= x &lt; 100.000" sourceRef="E30A_Gw" targetRef="E30A_T3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${x &gt;= 50000 &amp;&amp; x &lt; 100000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_E30A_T3_E30A_Merge" sourceRef="E30A_T3" targetRef="E30A_Merge" />
    <bpmn:sequenceFlow id="Flow_E30A_Gw_E30A_T4" name="Default" sourceRef="E30A_Gw" targetRef="E30A_T4" />
    <bpmn:sequenceFlow id="Flow_E30A_T4_E30A_Merge" sourceRef="E30A_T4" targetRef="E30A_Merge" />
    <bpmn:sequenceFlow id="Flow_E30A_Start_E30A_Check" sourceRef="E30A_Start" targetRef="E30A_Check" />
    <bpmn:sequenceFlow id="Flow_E30A_Check_E30A_Gw" sourceRef="E30A_Check" targetRef="E30A_Gw" />
    <bpmn:sequenceFlow id="Flow_E30A_Merge_E30A_End" sourceRef="E30A_Merge" targetRef="E30A_End" />
  </bpmn:process>
  <bpmn:process id="E30_B_DefaultFlow" name="B: XOR ohne Marker (gleiche Bedeutung, laut Notizen nicht verwenden) – Folie 30 rechts" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Folie 30: Genau EIN Pfad wird genommen. Trifft keine Bedingung zu, greift der Default Flow (Schrägstrich) -&gt; Task 4. Ohne Default Flow würde der Prozess mit einem Fehler stehen bleiben.</bpmn:documentation>
    <bpmn:startEvent id="E30B_Start">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="x" label="Bestellwert x" type="long" defaultValue="20000" />
