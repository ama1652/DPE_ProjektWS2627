      <bpmn:incoming>Flow_E31_Check_E31_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_E31_T1_E31_End1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E31_End1">
      <bpmn:incoming>Flow_E31_T1_E31_End1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="E31_T2" name="Task 2" camunda:assignee="demo">
      <bpmn:incoming>Flow_E31_Check_E31_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_E31_T2_E31_End2</bpmn:outgoing>
