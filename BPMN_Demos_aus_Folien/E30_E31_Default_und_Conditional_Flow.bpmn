    <bpmn:sequenceFlow id="Flow_E31_T2_E31_End2" sourceRef="E31_T2" targetRef="E31_End2" />
    <bpmn:sequenceFlow id="Flow_E31_Check_E31_T3" name="50.000&lt;= x &lt; 100.000" sourceRef="E31_Check" targetRef="E31_T3">
