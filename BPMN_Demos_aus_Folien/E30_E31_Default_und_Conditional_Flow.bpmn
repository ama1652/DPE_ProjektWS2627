      <bpmn:outgoing>Flow_E30B_Merge_E30B_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E30B_End">
      <bpmn:incoming>Flow_E30B_Merge_E30B_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="E30B_T1" name="Task 1" camunda:assignee="demo">
      <bpmn:incoming>Flow_E30B_Gw_E30B_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_E30B_T1_E30B_Merge</bpmn:outgoing>
