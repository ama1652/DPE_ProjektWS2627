    <bpmn:exclusiveGateway id="E30B_Gw" default="Flow_E30B_Gw_E30B_T4">
      <bpmn:incoming>Flow_E30B_Check_E30B_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_E30B_Gw_E30B_T1</bpmn:outgoing>
