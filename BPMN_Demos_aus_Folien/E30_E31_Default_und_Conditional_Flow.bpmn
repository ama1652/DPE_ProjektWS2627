    </bpmn:userTask>
    <bpmn:endEvent id="E31_End3">
      <bpmn:incoming>Flow_E31_T3_E31_End3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="E31_T4" name="Task 4" camunda:assignee="demo">
      <bpmn:incoming>Flow_E31_Check_E31_T4</bpmn:incoming>
      <bpmn:outgoing>Flow_E31_T4_E31_End4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E31_End4">
      <bpmn:incoming>Flow_E31_T4_E31_End4</bpmn:incoming>
