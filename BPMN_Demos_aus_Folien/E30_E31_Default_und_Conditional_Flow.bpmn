    <bpmn:userTask id="E30B_T2" name="Task 2" camunda:assignee="demo">
      <bpmn:incoming>Flow_E30B_Gw_E30B_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_E30B_T2_E30B_Merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="E30B_T3" name="Task 3" camunda:assignee="demo">
