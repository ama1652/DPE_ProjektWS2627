<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_A24_Transaktion_extern_zurueckrollen" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_A24_Transaktion_extern_zurueckrollen">
    <bpmn:participant id="P_A24_PDA" name="Process Driven Application" />
    <bpmn:participant id="P_A24_SCIL" name="Service Contract Implementation Layer" processRef="A24_ServiceContract" />
    <bpmn:participant id="P_A24_SP" name="Service Provider" />
    <bpmn:messageFlow id="MsgFlow_P_A24_PDA_A24_Start" sourceRef="P_A24_PDA" targetRef="A24_Start" />
    <bpmn:messageFlow id="MsgFlow_A24_EndOk_P_A24_PDA" sourceRef="A24_EndOk" targetRef="P_A24_PDA" />
    <bpmn:messageFlow id="MsgFlow_A24_EndErr_P_A24_PDA" sourceRef="A24_EndErr" targetRef="P_A24_PDA" />
  </bpmn:collaboration>
  <bpmn:process id="A24_ServiceContract" name="Service Contract Implementation Layer" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Folie 24: Nachträgliches Kompensieren. Die Transaktion ist schon erfolgreich beendet; erst 'Check Result' entscheidet, dass das Ergebnis nicht passt (Result ok? = Nein). Das Kompensations-Zwischenereignis rollt die ABGESCHLOSSENE Transaktion zurück – die Engine bewahrt dafür ihr Logbuch auf.</bpmn:documentation>
    <bpmn:startEvent id="A24_Start" name="Service-Request">
      <bpmn:outgoing>Flow_A24_Start_A24_Tx</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_A24_Start" messageRef="Message_A24_ServiceRequest" />
    </bpmn:startEvent>
    <bpmn:transaction id="A24_Tx" name="Transaction">
      <bpmn:incoming>Flow_A24_Start_A24_Tx</bpmn:incoming>
      <bpmn:outgoing>Flow_A24_Tx_A24_Check</bpmn:outgoing>
      <bpmn:startEvent id="A24_T_Start">
        <bpmn:outgoing>Flow_A24_T_Start_A24_B0</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="A24_B0" name="Service 1 (System-Simulation)" camunda:assignee="demo">
        <bpmn:documentation>Im Original ein automatischer Service Task. Hier als Benutzeraufgabe simuliert, damit du Zeit hast, Ereignisse auszulösen (Nachricht, Fehler, Eskalation). Fehler auslösen: ./dpe-demo.sh error &lt;taskId&gt; BUCHUNG_FEHLGESCHLAGEN</bpmn:documentation>
        <bpmn:incoming>Flow_A24_T_Start_A24_B0</bpmn:incoming>
        <bpmn:outgoing>Flow_A24_B0_A24_B1</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="A24_CB0" attachedToRef="A24_B0">
        <bpmn:compensateEventDefinition id="CompensateDef_A24_CB0" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="A24_CH0" name="Compensation Service 1" camunda:assignee="demo" isForCompensation="true">
      </bpmn:userTask>
      <bpmn:boundaryEvent id="A24_EB0" attachedToRef="A24_B0">
        <bpmn:outgoing>Flow_A24_EB0_A24_T_Cancel</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorDef_A24_EB0" errorRef="Error_BUCHUNG_FEHLGESCHLAGEN" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="A24_B1" name="Service 2 (System-Simulation)" camunda:assignee="demo">
        <bpmn:documentation>Im Original ein automatischer Service Task. Hier als Benutzeraufgabe simuliert, damit du Zeit hast, Ereignisse auszulösen (Nachricht, Fehler, Eskalation). Fehler auslösen: ./dpe-demo.sh error &lt;taskId&gt; BUCHUNG_FEHLGESCHLAGEN</bpmn:documentation>
        <bpmn:incoming>Flow_A24_B0_A24_B1</bpmn:incoming>
        <bpmn:outgoing>Flow_A24_B1_A24_B2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="A24_CB1" attachedToRef="A24_B1">
        <bpmn:compensateEventDefinition id="CompensateDef_A24_CB1" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="A24_CH1" name="Compensation Service 2" camunda:assignee="demo" isForCompensation="true">
      </bpmn:userTask>
      <bpmn:boundaryEvent id="A24_EB1" attachedToRef="A24_B1">
        <bpmn:outgoing>Flow_A24_EB1_A24_T_Cancel</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorDef_A24_EB1" errorRef="Error_BUCHUNG_FEHLGESCHLAGEN" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="A24_B2" name="Service 3 (System-Simulation)" camunda:assignee="demo">
        <bpmn:documentation>Im Original ein automatischer Service Task. Hier als Benutzeraufgabe simuliert, damit du Zeit hast, Ereignisse auszulösen (Nachricht, Fehler, Eskalation). Fehler auslösen: ./dpe-demo.sh error &lt;taskId&gt; BUCHUNG_FEHLGESCHLAGEN</bpmn:documentation>
        <bpmn:incoming>Flow_A24_B1_A24_B2</bpmn:incoming>
        <bpmn:outgoing>Flow_A24_B2_A24_T_End</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="A24_CB2" attachedToRef="A24_B2">
        <bpmn:compensateEventDefinition id="CompensateDef_A24_CB2" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="A24_CH2" name="Compensation Service 3" camunda:assignee="demo" isForCompensation="true">
      </bpmn:userTask>
      <bpmn:boundaryEvent id="A24_EB2" attachedToRef="A24_B2">
        <bpmn:outgoing>Flow_A24_EB2_A24_T_Cancel</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorDef_A24_EB2" errorRef="Error_BUCHUNG_FEHLGESCHLAGEN" />
      </bpmn:boundaryEvent>
      <bpmn:endEvent id="A24_T_End">
        <bpmn:incoming>Flow_A24_B2_A24_T_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="A24_T_Cancel" name="Cancel End Event">
        <bpmn:incoming>Flow_A24_EB0_A24_T_Cancel</bpmn:incoming>
        <bpmn:incoming>Flow_A24_EB1_A24_T_Cancel</bpmn:incoming>
        <bpmn:incoming>Flow_A24_EB2_A24_T_Cancel</bpmn:incoming>
        <bpmn:cancelEventDefinition id="CancelDef_A24_T_Cancel" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_A24_T_Start_A24_B0" sourceRef="A24_T_Start" targetRef="A24_B0" />
      <bpmn:sequenceFlow id="Flow_A24_B0_A24_B1" sourceRef="A24_B0" targetRef="A24_B1" />
      <bpmn:sequenceFlow id="Flow_A24_B1_A24_B2" sourceRef="A24_B1" targetRef="A24_B2" />
      <bpmn:sequenceFlow id="Flow_A24_B2_A24_T_End" sourceRef="A24_B2" targetRef="A24_T_End" />
      <bpmn:sequenceFlow id="Flow_A24_EB0_A24_T_Cancel" sourceRef="A24_EB0" targetRef="A24_T_Cancel" />
      <bpmn:sequenceFlow id="Flow_A24_EB1_A24_T_Cancel" sourceRef="A24_EB1" targetRef="A24_T_Cancel" />
      <bpmn:sequenceFlow id="Flow_A24_EB2_A24_T_Cancel" sourceRef="A24_EB2" targetRef="A24_T_Cancel" />
      <bpmn:association id="Assoc_A24_CB0_A24_CH0" associationDirection="One" sourceRef="A24_CB0" targetRef="A24_CH0" />
      <bpmn:association id="Assoc_A24_CB1_A24_CH1" associationDirection="One" sourceRef="A24_CB1" targetRef="A24_CH1" />
      <bpmn:association id="Assoc_A24_CB2_A24_CH2" associationDirection="One" sourceRef="A24_CB2" targetRef="A24_CH2" />
    </bpmn:transaction>
    <bpmn:boundaryEvent id="A24_BCancel" attachedToRef="A24_Tx">
      <bpmn:outgoing>Flow_A24_BCancel_A24_Merge</bpmn:outgoing>
      <bpmn:cancelEventDefinition id="CancelDef_A24_BCancel" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="A24_Check" name="Check Result" camunda:assignee="demo">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="resultOk" label="Result ok?" type="boolean" defaultValue="True" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A24_Tx_A24_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_A24_Check_A24_Gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="A24_Gw" name="Result ok?">
      <bpmn:incoming>Flow_A24_Check_A24_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_A24_Gw_A24_EndOk</bpmn:outgoing>
      <bpmn:outgoing>Flow_A24_Gw_A24_Comp</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="A24_EndOk" name="Service-Response">
      <bpmn:incoming>Flow_A24_Gw_A24_EndOk</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageDef_A24_EndOk" messageRef="Message_A24_Response" camunda:expression="${execution.setVariable('letzteNachricht', 'Ergebnis bestätigt')}" />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="A24_Comp" name="Transaction zurückrollen">
      <bpmn:incoming>Flow_A24_Gw_A24_Comp</bpmn:incoming>
      <bpmn:outgoing>Flow_A24_Comp_A24_Merge</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CompensateDef_A24_Comp" activityRef="A24_Tx" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="A24_Merge">
      <bpmn:incoming>Flow_A24_Comp_A24_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_A24_BCancel_A24_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_A24_Merge_A24_EndErr</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="A24_EndErr" name="Error Message">
      <bpmn:incoming>Flow_A24_Merge_A24_EndErr</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageDef_A24_EndErr" messageRef="Message_A24_Error" camunda:expression="${execution.setVariable('letzteNachricht', 'Vorgang zurückgerollt')}" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_A24_Start_A24_Tx" sourceRef="A24_Start" targetRef="A24_Tx" />
    <bpmn:sequenceFlow id="Flow_A24_Tx_A24_Check" sourceRef="A24_Tx" targetRef="A24_Check" />
    <bpmn:sequenceFlow id="Flow_A24_Check_A24_Gw" sourceRef="A24_Check" targetRef="A24_Gw" />
    <bpmn:sequenceFlow id="Flow_A24_Gw_A24_EndOk" name="Yes" sourceRef="A24_Gw" targetRef="A24_EndOk">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${resultOk}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A24_Gw_A24_Comp" name="No" sourceRef="A24_Gw" targetRef="A24_Comp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!resultOk}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A24_Comp_A24_Merge" sourceRef="A24_Comp" targetRef="A24_Merge" />
    <bpmn:sequenceFlow id="Flow_A24_BCancel_A24_Merge" sourceRef="A24_BCancel" targetRef="A24_Merge" />
    <bpmn:sequenceFlow id="Flow_A24_Merge_A24_EndErr" sourceRef="A24_Merge" targetRef="A24_EndErr" />
  </bpmn:process>
