<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_E19_Orchestrierung_Kollaboration" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_E19_Orchestrierung_Kollaboration">
    <bpmn:participant id="P_E19_Pool2" name="Pool 2" processRef="E19_Pool2" />
    <bpmn:participant id="P_E19_Pool1" name="Pool 1" processRef="E19_Pool1" />
    <bpmn:participant id="P_E19_Lanes" name="Pool (mit Lanes)" processRef="E19_PoolMitLanes" />
    <bpmn:messageFlow id="MsgFlow_E19_P1_Send_E19_P2_Start" sourceRef="E19_P1_Send" targetRef="E19_P2_Start" />
    <bpmn:messageFlow id="MsgFlow_E19_P2_Throw_E19_P1_Catch1" sourceRef="E19_P2_Throw" targetRef="E19_P1_Catch1" />
    <bpmn:messageFlow id="MsgFlow_E19_P2_End_E19_P1_Catch2" sourceRef="E19_P2_End" targetRef="E19_P1_Catch2" />
  </bpmn:collaboration>
  <bpmn:process id="E19_Pool2" name="Pool 2" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Folie 19: Wird per Nachricht aus Pool 1 gestartet. Nach der User Task antwortet Pool 2 per Nachricht.</bpmn:documentation>
    <bpmn:startEvent id="E19_P2_Start" name="Anfrage empfangen">
      <bpmn:outgoing>Flow_E19_P2_Start_E19_P2_User</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_E19_P2_Start" messageRef="Message_E19_Anfrage" />
    </bpmn:startEvent>
    <bpmn:userTask id="E19_P2_User" name="User Task" camunda:assignee="demo">
      <bpmn:incoming>Flow_E19_P2_Start_E19_P2_User</bpmn:incoming>
      <bpmn:outgoing>Flow_E19_P2_User_E19_P2_Throw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="E19_P2_Throw" name="Antwort senden" camunda:asyncBefore="true">
      <bpmn:incoming>Flow_E19_P2_User_E19_P2_Throw</bpmn:incoming>
      <bpmn:outgoing>Flow_E19_P2_Throw_E19_P2_Service</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_E19_P2_Throw" messageRef="Message_E19_Antwort" camunda:expression="${execution.getProcessEngineServices().getRuntimeService().createMessageCorrelation('E19_Antwort').processInstanceId(korrelationsId).correlateWithResult() != null}" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="E19_P2_Service" name="Service Task" camunda:expression="${execution.setVariable('pool2_service', 'ausgeführt')}">
      <bpmn:incoming>Flow_E19_P2_Throw_E19_P2_Service</bpmn:incoming>
      <bpmn:outgoing>Flow_E19_P2_Service_E19_P2_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E19_P2_End" name="Ergebnis senden" camunda:asyncBefore="true">
      <bpmn:incoming>Flow_E19_P2_Service_E19_P2_End</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageDef_E19_P2_End" messageRef="Message_E19_Ergebnis" camunda:expression="${execution.getProcessEngineServices().getRuntimeService().createMessageCorrelation('E19_Ergebnis').processInstanceId(korrelationsId).correlateWithResult() != null}" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_E19_P2_Start_E19_P2_User" sourceRef="E19_P2_Start" targetRef="E19_P2_User" />
    <bpmn:sequenceFlow id="Flow_E19_P2_User_E19_P2_Throw" sourceRef="E19_P2_User" targetRef="E19_P2_Throw" />
    <bpmn:sequenceFlow id="Flow_E19_P2_Throw_E19_P2_Service" sourceRef="E19_P2_Throw" targetRef="E19_P2_Service" />
    <bpmn:sequenceFlow id="Flow_E19_P2_Service_E19_P2_End" sourceRef="E19_P2_Service" targetRef="E19_P2_End" />
  </bpmn:process>
  <bpmn:process id="E19_Pool1" name="Pool 1" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Folie 19: HIER STARTEN. Pool 1 schickt eine Nachricht an Pool 2 und wartet auf zwei Antworten.</bpmn:documentation>
    <bpmn:startEvent id="E19_P1_Start" name="Start">
      <bpmn:outgoing>Flow_E19_P1_Start_E19_P1_Send</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="E19_P1_Send" name="Send Task" camunda:expression="${execution.getProcessEngineServices().getRuntimeService().createMessageCorrelation('E19_Anfrage').setVariable('korrelationsId', execution.getProcessInstanceId()).correlateStartMessage() != null}">
      <bpmn:incoming>Flow_E19_P1_Start_E19_P1_Send</bpmn:incoming>
      <bpmn:outgoing>Flow_E19_P1_Send_E19_P1_Catch1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="E19_P1_Catch1" name="Antwort erhalten">
      <bpmn:incoming>Flow_E19_P1_Send_E19_P1_Catch1</bpmn:incoming>
      <bpmn:outgoing>Flow_E19_P1_Catch1_E19_P1_BR</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_E19_P1_Catch1" messageRef="Message_E19_Antwort" />
    </bpmn:intermediateCatchEvent>
    <bpmn:businessRuleTask id="E19_P1_BR" name="Business Rule Task" camunda:expression="${execution.setVariable('pool1_regel', 'ausgeführt')}">
      <bpmn:incoming>Flow_E19_P1_Catch1_E19_P1_BR</bpmn:incoming>
      <bpmn:outgoing>Flow_E19_P1_BR_E19_P1_Catch2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:intermediateCatchEvent id="E19_P1_Catch2" name="Ergebnis erhalten">
      <bpmn:incoming>Flow_E19_P1_BR_E19_P1_Catch2</bpmn:incoming>
      <bpmn:outgoing>Flow_E19_P1_Catch2_E19_P1_End</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_E19_P1_Catch2" messageRef="Message_E19_Ergebnis" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="E19_P1_End" name="Ende">
      <bpmn:incoming>Flow_E19_P1_Catch2_E19_P1_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_E19_P1_Start_E19_P1_Send" sourceRef="E19_P1_Start" targetRef="E19_P1_Send" />
    <bpmn:sequenceFlow id="Flow_E19_P1_Send_E19_P1_Catch1" sourceRef="E19_P1_Send" targetRef="E19_P1_Catch1" />
    <bpmn:sequenceFlow id="Flow_E19_P1_Catch1_E19_P1_BR" sourceRef="E19_P1_Catch1" targetRef="E19_P1_BR" />
    <bpmn:sequenceFlow id="Flow_E19_P1_BR_E19_P1_Catch2" sourceRef="E19_P1_BR" targetRef="E19_P1_Catch2" />
    <bpmn:sequenceFlow id="Flow_E19_P1_Catch2_E19_P1_End" sourceRef="E19_P1_Catch2" targetRef="E19_P1_End" />
  </bpmn:process>
  <bpmn:process id="E19_PoolMitLanes" name="Pool (mit Lanes)" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Folie 19 rechts oben: ein Pool mit zwei Lanes (Rollen). Sequenzfluss darf Lane-Grenzen überqueren, aber nie Pool-Grenzen.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_E19_PoolMitLanes">
      <bpmn:lane id="Lane_E19_A" name="Lane">
        <bpmn:flowNodeRef>E19_L_Task</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_E19_B" name="Lane">
        <bpmn:flowNodeRef>E19_L_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E19_L_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E19_L_Sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E19_L_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E19_L_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="E19_L_Start" name="Nachricht">
      <bpmn:outgoing>Flow_E19_L_Start_E19_L_Split</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_E19_L_Start" messageRef="Message_E19_LaneDemo" />
    </bpmn:startEvent>
    <bpmn:parallelGateway id="E19_L_Split">
      <bpmn:incoming>Flow_E19_L_Start_E19_L_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_E19_L_Split_E19_L_Task</bpmn:outgoing>
      <bpmn:outgoing>Flow_E19_L_Split_E19_L_Sub</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="E19_L_Task" name="Task" camunda:assignee="demo">
      <bpmn:incoming>Flow_E19_L_Split_E19_L_Task</bpmn:incoming>
      <bpmn:outgoing>Flow_E19_L_Task_E19_L_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="E19_L_Sub" name="Subprocess">
      <bpmn:incoming>Flow_E19_L_Split_E19_L_Sub</bpmn:incoming>
      <bpmn:outgoing>Flow_E19_L_Sub_E19_L_Join</bpmn:outgoing>
      <bpmn:startEvent id="E19_L_SubStart">
        <bpmn:outgoing>Flow_E19_L_SubStart_E19_L_SubTask</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:manualTask id="E19_L_SubTask" name="Kurz">
        <bpmn:incoming>Flow_E19_L_SubStart_E19_L_SubTask</bpmn:incoming>
        <bpmn:outgoing>Flow_E19_L_SubTask_E19_L_SubEnd</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:endEvent id="E19_L_SubEnd">
        <bpmn:incoming>Flow_E19_L_SubTask_E19_L_SubEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_E19_L_SubStart_E19_L_SubTask" sourceRef="E19_L_SubStart" targetRef="E19_L_SubTask" />
      <bpmn:sequenceFlow id="Flow_E19_L_SubTask_E19_L_SubEnd" sourceRef="E19_L_SubTask" targetRef="E19_L_SubEnd" />
    </bpmn:subProcess>
    <bpmn:parallelGateway id="E19_L_Join">
      <bpmn:incoming>Flow_E19_L_Task_E19_L_Join</bpmn:incoming>
      <bpmn:incoming>Flow_E19_L_Sub_E19_L_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_E19_L_Join_E19_L_End</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="E19_L_End" name="Nachricht senden">
      <bpmn:incoming>Flow_E19_L_Join_E19_L_End</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageDef_E19_L_End" messageRef="Message_E19_LaneFertig" camunda:expression="${execution.setVariable('letzteNachricht', 'Lane-Demo fertig')}" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_E19_L_Start_E19_L_Split" sourceRef="E19_L_Start" targetRef="E19_L_Split" />
    <bpmn:sequenceFlow id="Flow_E19_L_Split_E19_L_Task" sourceRef="E19_L_Split" targetRef="E19_L_Task" />
    <bpmn:sequenceFlow id="Flow_E19_L_Split_E19_L_Sub" sourceRef="E19_L_Split" targetRef="E19_L_Sub" />
    <bpmn:sequenceFlow id="Flow_E19_L_Task_E19_L_Join" sourceRef="E19_L_Task" targetRef="E19_L_Join" />
    <bpmn:sequenceFlow id="Flow_E19_L_Sub_E19_L_Join" sourceRef="E19_L_Sub" targetRef="E19_L_Join" />
    <bpmn:sequenceFlow id="Flow_E19_L_Join_E19_L_End" sourceRef="E19_L_Join" targetRef="E19_L_End" />
  </bpmn:process>
  <bpmn:message id="Message_E19_Anfrage" name="E19_Anfrage" />
  <bpmn:message id="Message_E19_Antwort" name="E19_Antwort" />
  <bpmn:message id="Message_E19_Ergebnis" name="E19_Ergebnis" />
  <bpmn:message id="Message_E19_LaneDemo" name="E19_LaneDemo" />
  <bpmn:message id="Message_E19_LaneFertig" name="E19_LaneFertig" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_E19_Orchestrierung_Kollaboration">
    <bpmndi:BPMNPlane id="BPMNPlane_E19_Orchestrierung_Kollaboration" bpmnElement="Collaboration_E19_Orchestrierung_Kollaboration">
      <bpmndi:BPMNShape id="P_E19_Pool2_di" bpmnElement="P_E19_Pool2" isHorizontal="true"><dc:Bounds x="160" y="60" width="720" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_E19_Pool1_di" bpmnElement="P_E19_Pool1" isHorizontal="true"><dc:Bounds x="160" y="240" width="720" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_E19_Lanes_di" bpmnElement="P_E19_Lanes" isHorizontal="true"><dc:Bounds x="160" y="420" width="720" height="240" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_E19_A_di" bpmnElement="Lane_E19_A" isHorizontal="true"><dc:Bounds x="190" y="420" width="690" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_E19_B_di" bpmnElement="Lane_E19_B" isHorizontal="true"><dc:Bounds x="190" y="540" width="690" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E19_L_Sub_di" bpmnElement="E19_L_Sub" isExpanded="true"><dc:Bounds x="400" y="560" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E19_P2_Start_di" bpmnElement="E19_P2_Start"><dc:Bounds x="232" y="107" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="190" y="147" width="119" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E19_P2_User_di" bpmnElement="E19_P2_User"><dc:Bounds x="310" y="85" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E19_P2_Throw_di" bpmnElement="E19_P2_Throw"><dc:Bounds x="462" y="107" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="431" y="147" width="98" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E19_P2_Service_di" bpmnElement="E19_P2_Service"><dc:Bounds x="540" y="85" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E19_P2_End_di" bpmnElement="E19_P2_End"><dc:Bounds x="702" y="107" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="668" y="147" width="105" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E19_P1_Start_di" bpmnElement="E19_P1_Start"><dc:Bounds x="202" y="287" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="190" y="327" width="60" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E19_P1_Send_di" bpmnElement="E19_P1_Send"><dc:Bounds x="290" y="265" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E19_P1_Catch1_di" bpmnElement="E19_P1_Catch1"><dc:Bounds x="462" y="287" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="424" y="327" width="112" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E19_P1_BR_di" bpmnElement="E19_P1_BR"><dc:Bounds x="540" y="265" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E19_P1_Catch2_di" bpmnElement="E19_P1_Catch2"><dc:Bounds x="702" y="287" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="660" y="327" width="119" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E19_P1_End_di" bpmnElement="E19_P1_End"><dc:Bounds x="802" y="287" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="790" y="327" width="60" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E19_L_Start_di" bpmnElement="E19_L_Start"><dc:Bounds x="222" y="582" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="208" y="622" width="63" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E19_L_Split_di" bpmnElement="E19_L_Split"><dc:Bounds x="295" y="575" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E19_L_Task_di" bpmnElement="E19_L_Task"><dc:Bounds x="410" y="440" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E19_L_SubStart_di" bpmnElement="E19_L_SubStart"><dc:Bounds x="412" y="582" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E19_L_SubTask_di" bpmnElement="E19_L_SubTask"><dc:Bounds x="455" y="580" width="50" height="40" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E19_L_SubEnd_di" bpmnElement="E19_L_SubEnd"><dc:Bounds x="517" y="582" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E19_L_Join_di" bpmnElement="E19_L_Join"><dc:Bounds x="615" y="575" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E19_L_End_di" bpmnElement="E19_L_End"><dc:Bounds x="742" y="582" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="704" y="622" width="112" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_E19_P2_Start_E19_P2_User_di" bpmnElement="Flow_E19_P2_Start_E19_P2_User"><di:waypoint x="268" y="125" /><di:waypoint x="310" y="125" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E19_P2_User_E19_P2_Throw_di" bpmnElement="Flow_E19_P2_User_E19_P2_Throw"><di:waypoint x="410" y="125" /><di:waypoint x="462" y="125" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E19_P2_Throw_E19_P2_Service_di" bpmnElement="Flow_E19_P2_Throw_E19_P2_Service"><di:waypoint x="498" y="125" /><di:waypoint x="540" y="125" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E19_P2_Service_E19_P2_End_di" bpmnElement="Flow_E19_P2_Service_E19_P2_End"><di:waypoint x="640" y="125" /><di:waypoint x="702" y="125" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E19_P1_Start_E19_P1_Send_di" bpmnElement="Flow_E19_P1_Start_E19_P1_Send"><di:waypoint x="238" y="305" /><di:waypoint x="290" y="305" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E19_P1_Send_E19_P1_Catch1_di" bpmnElement="Flow_E19_P1_Send_E19_P1_Catch1"><di:waypoint x="390" y="305" /><di:waypoint x="462" y="305" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E19_P1_Catch1_E19_P1_BR_di" bpmnElement="Flow_E19_P1_Catch1_E19_P1_BR"><di:waypoint x="498" y="305" /><di:waypoint x="540" y="305" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E19_P1_BR_E19_P1_Catch2_di" bpmnElement="Flow_E19_P1_BR_E19_P1_Catch2"><di:waypoint x="640" y="305" /><di:waypoint x="702" y="305" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E19_P1_Catch2_E19_P1_End_di" bpmnElement="Flow_E19_P1_Catch2_E19_P1_End"><di:waypoint x="738" y="305" /><di:waypoint x="802" y="305" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E19_L_SubStart_E19_L_SubTask_di" bpmnElement="Flow_E19_L_SubStart_E19_L_SubTask"><di:waypoint x="448" y="600" /><di:waypoint x="455" y="600" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E19_L_SubTask_E19_L_SubEnd_di" bpmnElement="Flow_E19_L_SubTask_E19_L_SubEnd"><di:waypoint x="505" y="600" /><di:waypoint x="517" y="600" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E19_L_Start_E19_L_Split_di" bpmnElement="Flow_E19_L_Start_E19_L_Split"><di:waypoint x="258" y="600" /><di:waypoint x="295" y="600" /></bpmndi:BPMNEdge>
