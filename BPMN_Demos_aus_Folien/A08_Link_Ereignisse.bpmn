<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_A08_Link_Ereignisse" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_A08_Link_Ereignisse">
    <bpmn:participant id="P_A08_A" name="A: Schleife mit langem Rückfluss" processRef="A08_A_Schleife" />
    <bpmn:participant id="P_A08_B" name="B: Gleiche Schleife mit Link-Ereignissen ('Label A')" processRef="A08_B_Link" />
  </bpmn:collaboration>
  <bpmn:process id="A08_A_Schleife" name="A: Schleife mit langem Rückfluss" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Folie 8: Link-Ereignisse ersetzen einen langen Sequenzfluss innerhalb DESSELBEN Prozesses (wie 'springe zu Label A'). Schwarzes Link-Ereignis = werfen, weißes = fangen. Folie 9: Link darf NICHT die Grenze eines Teilprozesses überspringen. Step 6 ist hier eine Benutzeraufgabe, damit du 'Approved?' beantworten kannst (sonst Endlosschleife).</bpmn:documentation>
    <bpmn:startEvent id="A08A_Start" name="Manual Start">
      <bpmn:outgoing>Flow_A08A_Start_A08A_Gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="A08A_Gw">
      <bpmn:incoming>Flow_A08A_Start_A08A_Gw</bpmn:incoming>
      <bpmn:incoming>Flow_A08A_Appr_A08A_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_A08A_Gw_A08A_S1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="A08A_S1" name="Step 1" camunda:expression="${execution.setVariable('step1', 'ausgeführt')}">
      <bpmn:incoming>Flow_A08A_Gw_A08A_S1</bpmn:incoming>
      <bpmn:outgoing>Flow_A08A_S1_A08A_S2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="A08A_S2" name="Step 2" camunda:expression="${execution.setVariable('step2', 'ausgeführt')}">
      <bpmn:incoming>Flow_A08A_S1_A08A_S2</bpmn:incoming>
      <bpmn:outgoing>Flow_A08A_S2_A08A_S3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="A08A_S3" name="Step 3" camunda:expression="${execution.setVariable('step3', 'ausgeführt')}">
      <bpmn:incoming>Flow_A08A_S2_A08A_S3</bpmn:incoming>
      <bpmn:outgoing>Flow_A08A_S3_A08A_S4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="A08A_S4" name="Step 4" camunda:expression="${execution.setVariable('step4', 'ausgeführt')}">
      <bpmn:incoming>Flow_A08A_S3_A08A_S4</bpmn:incoming>
      <bpmn:outgoing>Flow_A08A_S4_A08A_S5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="A08A_S5" name="Step 5" camunda:expression="${execution.setVariable('step5', 'ausgeführt')}">
      <bpmn:incoming>Flow_A08A_S4_A08A_S5</bpmn:incoming>
      <bpmn:outgoing>Flow_A08A_S5_A08A_S6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="A08A_S6" name="Step 6" camunda:assignee="demo">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="approved" label="Approved?" type="boolean" defaultValue="False" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A08A_S5_A08A_S6</bpmn:incoming>
      <bpmn:outgoing>Flow_A08A_S6_A08A_Appr</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="A08A_Appr" name="Approved?">
      <bpmn:incoming>Flow_A08A_S6_A08A_Appr</bpmn:incoming>
      <bpmn:outgoing>Flow_A08A_Appr_A08A_End</bpmn:outgoing>
      <bpmn:outgoing>Flow_A08A_Appr_A08A_Gw</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="A08A_End" name="Success">
      <bpmn:incoming>Flow_A08A_Appr_A08A_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_A08A_Start_A08A_Gw" sourceRef="A08A_Start" targetRef="A08A_Gw" />
    <bpmn:sequenceFlow id="Flow_A08A_Gw_A08A_S1" sourceRef="A08A_Gw" targetRef="A08A_S1" />
    <bpmn:sequenceFlow id="Flow_A08A_S1_A08A_S2" sourceRef="A08A_S1" targetRef="A08A_S2" />
    <bpmn:sequenceFlow id="Flow_A08A_S2_A08A_S3" sourceRef="A08A_S2" targetRef="A08A_S3" />
    <bpmn:sequenceFlow id="Flow_A08A_S3_A08A_S4" sourceRef="A08A_S3" targetRef="A08A_S4" />
    <bpmn:sequenceFlow id="Flow_A08A_S4_A08A_S5" sourceRef="A08A_S4" targetRef="A08A_S5" />
    <bpmn:sequenceFlow id="Flow_A08A_S5_A08A_S6" sourceRef="A08A_S5" targetRef="A08A_S6" />
    <bpmn:sequenceFlow id="Flow_A08A_S6_A08A_Appr" sourceRef="A08A_S6" targetRef="A08A_Appr" />
    <bpmn:sequenceFlow id="Flow_A08A_Appr_A08A_End" name="Yes" sourceRef="A08A_Appr" targetRef="A08A_End">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A08A_Appr_A08A_Gw" name="No" sourceRef="A08A_Appr" targetRef="A08A_Gw">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!approved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="A08_B_Link" name="B: Gleiche Schleife mit Link-Ereignissen ('Label A')" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Folie 8: Link-Ereignisse ersetzen einen langen Sequenzfluss innerhalb DESSELBEN Prozesses (wie 'springe zu Label A'). Schwarzes Link-Ereignis = werfen, weißes = fangen. Folie 9: Link darf NICHT die Grenze eines Teilprozesses überspringen. Step 6 ist hier eine Benutzeraufgabe, damit du 'Approved?' beantworten kannst (sonst Endlosschleife).</bpmn:documentation>
