      <bpmndi:BPMNShape id="L03_Anz0_di" bpmnElement="L03_Anz0"><dc:Bounds x="1330" y="220" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L03_End_di" bpmnElement="L03_End"><dc:Bounds x="1492" y="242" width="36" height="36" /></bpmndi:BPMNShape>
