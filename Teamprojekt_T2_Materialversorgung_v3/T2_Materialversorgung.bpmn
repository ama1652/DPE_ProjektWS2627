<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_T2_Materialversorgung" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_T2_Materialversorgung">
    <bpmn:participant id="P_T2_Materialversorgung" name="Pflege-Backoffice: Materialversorgung (Team 2)" processRef="T2_Materialversorgung" />
    <bpmn:participant id="P_T2_App" name="Pflege-App und Prüfplaner" />
    <bpmn:participant id="P_T2_Lieferant" name="Lieferant (SIMULIERT)" />
    <bpmn:participant id="P_T2_Team3" name="Team 3: Kommunikation und Fristen (SIMULIERT)" />
    <bpmn:participant id="P_T2_Team1" name="Team 1: Vorgangsakte und Dokumente (SIMULIERT)" />
    <bpmn:messageFlow id="MF_1" name="Prüftermin fällig" sourceRef="P_T2_App" targetRef="S_Pruefung" />
    <bpmn:messageFlow id="MF_2" name="Bestandsmeldung" sourceRef="P_T2_App" targetRef="S_Meldung" />
    <bpmn:messageFlow id="MF_3" name="Schwellenwert unterschritten" sourceRef="P_T2_App" targetRef="S_Schwelle" />
    <bpmn:messageFlow id="MF_4" name="Bestandsanfrage / Erinnerung" sourceRef="SP_Bedarf" targetRef="P_T2_App" />
    <bpmn:messageFlow id="MF_5" name="Gemeldeter Bestand" sourceRef="P_T2_App" targetRef="SP_Bedarf" />
    <bpmn:messageFlow id="MF_6" name="Freigabeanfrage" sourceRef="SP_Freigabe" targetRef="P_T2_App" />
    <bpmn:messageFlow id="MF_7" name="Entscheidung des Kunden" sourceRef="P_T2_App" targetRef="SP_Freigabe" />
    <bpmn:messageFlow id="MF_8" name="Bitte Lieferung bestätigen" sourceRef="SP_Lieferung" targetRef="P_T2_App" />
    <bpmn:messageFlow id="MF_9" name="Lieferbestätigung" sourceRef="P_T2_App" targetRef="SP_Lieferung" />
    <bpmn:messageFlow id="MF_10" name="Benachrichtigung" sourceRef="E_Doppelt" targetRef="P_T2_App" />
    <bpmn:messageFlow id="MF_11" name="Benachrichtigung" sourceRef="E_KeinBestand" targetRef="P_T2_App" />
    <bpmn:messageFlow id="MF_12" name="Benachrichtigung" sourceRef="E_Termin" targetRef="P_T2_App" />
    <bpmn:messageFlow id="MF_13" name="Benachrichtigung" sourceRef="E_Abgelehnt" targetRef="P_T2_App" />
    <bpmn:messageFlow id="MF_14" name="Benachrichtigung" sourceRef="E_KeineAntwortK" targetRef="P_T2_App" />
    <bpmn:messageFlow id="MF_15" name="Benachrichtigung" sourceRef="E_Grenzfall" targetRef="P_T2_App" />
    <bpmn:messageFlow id="MF_16" name="Benachrichtigung" sourceRef="E_KeinLieferant" targetRef="P_T2_App" />
    <bpmn:messageFlow id="MF_17" name="Benachrichtigung" sourceRef="E_UnbestTop" targetRef="P_T2_App" />
    <bpmn:messageFlow id="MF_18" name="Benachrichtigung" sourceRef="E_AbwTop" targetRef="P_T2_App" />
    <bpmn:messageFlow id="MF_19" name="Benachrichtigung" sourceRef="E_Rest" targetRef="P_T2_App" />
    <bpmn:messageFlow id="MF_20" name="Benachrichtigung" sourceRef="E_Erfolg" targetRef="P_T2_App" />
    <bpmn:messageFlow id="MF_21" name="Bestellung" sourceRef="SP_Bestellung" targetRef="P_T2_Lieferant" />
    <bpmn:messageFlow id="MF_22" name="Bestellbestätigung / nicht lieferbar" sourceRef="P_T2_Lieferant" targetRef="SP_Bestellung" />
    <bpmn:messageFlow id="MF_23" name="Nachfassauftrag" sourceRef="SP_Bestellung" targetRef="P_T2_Team3" />
    <bpmn:messageFlow id="MF_24" name="Versand / Zustellung / nicht lieferbar" sourceRef="P_T2_Lieferant" targetRef="SP_Lieferung" />
    <bpmn:messageFlow id="MF_25" name="Mahnung / Beanstandung" sourceRef="SP_Lieferung" targetRef="P_T2_Team3" />
    <bpmn:messageFlow id="MF_26" name="Liefernachweis" sourceRef="ST_Beleg" targetRef="P_T2_Team1" />
  </bpmn:collaboration>
  <bpmn:process id="T2_Materialversorgung" name="Materialversorgung (Team 2)" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Team 2 Materialversorgung (DPE, Prof. Stiehl, WS 2026/27), Version 3. Eine Prozessinstanz ist ein Vorgang für ein Produkt eines Pflegehaushalts. Oberste Ebene mit Teilprozessen (aufklappbar). Berechnungen und Kontakte laufen als External Tasks, Werte und Grenzen stehen in den DMN-Tabellen T2_Produktprofil, T2_Fristen und T2_Berechtigungsregel. Lieferant, Team 1, Team 3 und Benachrichtigungen sind SIMULIERT.</bpmn:documentation>
    <bpmn:startEvent id="S_Pruefung" name="Bestandsprüfung fällig">
      <bpmn:documentation>Prozessbeginn 1: Der Prüfplaner der App meldet einen geplanten Prüftermin (produktId, pflegehaushaltId). Bestand noch unbekannt.</bpmn:documentation>
      <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('ausloeser', 'Geplante Bestandsprüfung')}" event="end" /></bpmn:extensionElements>
      <bpmn:outgoing>Flow_S_Pruefung_T_Anlegen</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ED_S_Pruefung" messageRef="Msg_MV_Pruefung" />
    </bpmn:startEvent>
    <bpmn:startEvent id="S_Meldung" name="Bestandsmeldung eingegangen">
      <bpmn:documentation>Prozessbeginn 2: Die pflegende Person meldet den Bestand über die App (produktId, pflegehaushaltId, bestand).</bpmn:documentation>
      <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('ausloeser', 'Manuelle Bestandsmeldung')}" event="end" /></bpmn:extensionElements>
      <bpmn:outgoing>Flow_S_Meldung_T_Anlegen</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ED_S_Meldung" messageRef="Msg_MV_Meldung" />
    </bpmn:startEvent>
    <bpmn:startEvent id="S_Schwelle" name="Schwellenwert unterschritten">
      <bpmn:documentation>Prozessbeginn 3: Die App erkennt, dass der vereinbarte Schwellenwert unterschritten ist (produktId, pflegehaushaltId, bestand).</bpmn:documentation>
      <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('ausloeser', 'Schwellenwert unterschritten')}" event="end" /></bpmn:extensionElements>
      <bpmn:outgoing>Flow_S_Schwelle_T_Anlegen</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ED_S_Schwelle" messageRef="Msg_MV_Schwelle" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="T_Anlegen" name="Vorgang eröffnen" camunda:type="external" camunda:topic="t2-vorgang-eroeffnen">
      <bpmn:documentation>Dienst der Vorgangsakte (Team 1, SIMULIERT): vergibt die Vorgangskennung (Business Key) und prüft, ob für Haushalt und Produkt schon ein Vorgang läuft.</bpmn:documentation>
      <bpmn:extensionElements><camunda:executionListener expression="${execution.setProcessBusinessKey(vorgangId)}" event="end" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_S_Pruefung_T_Anlegen</bpmn:incoming>
      <bpmn:incoming>Flow_S_Meldung_T_Anlegen</bpmn:incoming>
      <bpmn:incoming>Flow_S_Schwelle_T_Anlegen</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Anlegen_G_Offen</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Offen" name="Vorgang für dieses Produkt schon offen?" default="Flow_G_Offen_SP_Bedarf">
      <bpmn:incoming>Flow_T_Anlegen_G_Offen</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Offen_E_Doppelt</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Offen_SP_Bedarf</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_Doppelt" name="Kunde informiert: Vorgang läuft bereits">
      <bpmn:documentation>Nachrichten-Endereignis: der gemeinsame Benachrichtigungsdienst informiert den Kunden über die Pflege-App (SIMULIERT).</bpmn:documentation>
      <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Abgebrochen')}" event="start" /><camunda:executionListener expression="${execution.setVariable('ergebnis', 'Für Haushalt und Produkt läuft bereits ein Vorgang, kein zweiter Vorgang')}" event="start" /><camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Vorgang geschlossen')}" event="start" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Offen_E_Doppelt</bpmn:incoming>
      <bpmn:messageEventDefinition id="ED_E_Doppelt" messageRef="Msg_MV_Benachrichtigung" camunda:type="external" camunda:topic="t2-benachrichtigung-senden" />
    </bpmn:endEvent>
    <bpmn:subProcess id="SP_Bedarf" name="Bedarf ermitteln">
      <bpmn:documentation>Teamauftrag Schritte 1 bis 3: Profil und Fristen laden, Bestand klären, Reichweite berechnen, Bedarf feststellen.</bpmn:documentation>
      <bpmn:incoming>Flow_G_Offen_SP_Bedarf</bpmn:incoming>
      <bpmn:outgoing>Flow_SP_Bedarf_G_Bedarf</bpmn:outgoing>
      <bpmn:startEvent id="B_Start" name="Vorgang eröffnet">
        <bpmn:outgoing>Flow_B_Start_R_Profil</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:businessRuleTask id="R_Profil" name="Produktprofil laden" camunda:decisionRef="T2_Produktprofil" camunda:resultVariable="profil" camunda:mapDecisionResult="singleResult">
        <bpmn:documentation>DMN T2_Produktprofil: Produkt, Ersatzoption, Lieferanten, Mengen, Preise und Preisgrenze je Testprodukt (Projektannahmen).</bpmn:documentation>
        <bpmn:extensionElements><camunda:inputOutput><camunda:outputParameter name="produkt">${profil.produkt}</camunda:outputParameter><camunda:outputParameter name="ersatzprodukt">${profil.ersatzprodukt}</camunda:outputParameter><camunda:outputParameter name="lieferant">${profil.lieferant}</camunda:outputParameter><camunda:outputParameter name="alternativLieferant">${profil.alternativLieferant}</camunda:outputParameter><camunda:outputParameter name="packungsgroesse">${profil.packungsgroesse}</camunda:outputParameter><camunda:outputParameter name="zielbestand">${profil.zielbestand}</camunda:outputParameter><camunda:outputParameter name="maxBestellmenge">${profil.maxBestellmenge}</camunda:outputParameter><camunda:outputParameter name="verbrauchProTag">${profil.verbrauchProTag}</camunda:outputParameter><camunda:outputParameter name="lieferzeitTage">${profil.lieferzeitTage}</camunda:outputParameter><camunda:outputParameter name="tageBisNaechstePruefung">${profil.tageBisNaechstePruefung}</camunda:outputParameter><camunda:outputParameter name="stueckpreis">${profil.stueckpreis}</camunda:outputParameter><camunda:outputParameter name="stueckpreisAlternativ">${profil.stueckpreisAlternativ}</camunda:outputParameter><camunda:outputParameter name="stueckpreisErsatz">${profil.stueckpreisErsatz}</camunda:outputParameter><camunda:outputParameter name="betragsgrenze">${profil.betragsgrenze}</camunda:outputParameter><camunda:outputParameter name="schwelleVerbrauchssprung">${profil.schwelleVerbrauchssprung}</camunda:outputParameter></camunda:inputOutput></bpmn:extensionElements>
        <bpmn:incoming>Flow_B_Start_R_Profil</bpmn:incoming>
        <bpmn:outgoing>Flow_R_Profil_R_Fristen</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:businessRuleTask id="R_Fristen" name="Fristen laden" camunda:decisionRef="T2_Fristen" camunda:resultVariable="fristen" camunda:mapDecisionResult="singleResult">
        <bpmn:documentation>DMN T2_Fristen: alle Erinnerungen und Fristen je Testprodukt (ISO 8601). TP-SCHNELL nutzt Minuten zum Vorführen.</bpmn:documentation>
        <bpmn:extensionElements><camunda:inputOutput><camunda:outputParameter name="erinnerungszyklus">${fristen.erinnerungszyklus}</camunda:outputParameter><camunda:outputParameter name="fristBestandsmeldung">${fristen.fristBestandsmeldung}</camunda:outputParameter><camunda:outputParameter name="maxAnfragenBestand">${fristen.maxAnfragenBestand}</camunda:outputParameter><camunda:outputParameter name="fristKundenentscheidung">${fristen.fristKundenentscheidung}</camunda:outputParameter><camunda:outputParameter name="nachfasszyklusLieferant">${fristen.nachfasszyklusLieferant}</camunda:outputParameter><camunda:outputParameter name="fristBestaetigungEndgueltig">${fristen.fristBestaetigungEndgueltig}</camunda:outputParameter><camunda:outputParameter name="mahnzyklusLieferung">${fristen.mahnzyklusLieferung}</camunda:outputParameter><camunda:outputParameter name="fristLieferungEndgueltig">${fristen.fristLieferungEndgueltig}</camunda:outputParameter><camunda:outputParameter name="erinnerungszyklusLieferbestaetigung">${fristen.erinnerungszyklusLieferbestaetigung}</camunda:outputParameter><camunda:outputParameter name="fristLieferbestaetigung">${fristen.fristLieferbestaetigung}</camunda:outputParameter><camunda:outputParameter name="fristPruefstelle">${fristen.fristPruefstelle}</camunda:outputParameter></camunda:inputOutput></bpmn:extensionElements>
        <bpmn:incoming>Flow_R_Profil_R_Fristen</bpmn:incoming>
        <bpmn:outgoing>Flow_R_Fristen_G_Bestand</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="G_Bestand" name="Aktueller Bestand gemeldet?" default="Flow_G_Bestand_SP_Melden">
        <bpmn:incoming>Flow_R_Fristen_G_Bestand</bpmn:incoming>
        <bpmn:outgoing>Flow_G_Bestand_T_Reichweite</bpmn:outgoing>
        <bpmn:outgoing>Flow_G_Bestand_SP_Melden</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:subProcess id="SP_Melden" name="Bestandsmeldung einholen">
        <bpmn:documentation>Kapselt die Aufgabe „Aktuellen Bestand melden“ samt Erinnerungen. Läuft die Frist am Rand ab, werden Aufgabe und Erinnerungen gemeinsam beendet.</bpmn:documentation>
        <bpmn:incoming>Flow_G_Bestand_SP_Melden</bpmn:incoming>
        <bpmn:incoming>Flow_G_Erneut_SP_Melden</bpmn:incoming>
        <bpmn:outgoing>Flow_SP_Melden_T_Reichweite</bpmn:outgoing>
        <bpmn:startEvent id="SP_Melden_Start" name="Aufgabe angelegt">
          <bpmn:outgoing>Flow_SP_Melden_Start_U_Bestand</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:userTask id="U_Bestand" name="Aktuellen Bestand melden" camunda:candidateGroups="pflegende-person">
          <bpmn:documentation>Anlass: geplante Prüfung ohne aktuelle Meldung. Benötigt: Produkt, letzter bekannter Bestand. Rolle: pflegende Person. Ergebnis: aktueller Bestand mit Zeitpunkt. Frist: fristBestandsmeldung, danach erneute Anfrage.</bpmn:documentation>
          <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Wartet auf Kunde')}" event="start" /><camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Unterlagen fehlen')}" event="start" /><camunda:formData><camunda:formField id="bestand" label="Aktueller Bestand (Stück)" type="long"><camunda:validation><camunda:constraint name="required" /></camunda:validation></camunda:formField><camunda:formField id="bestandUnsicher" label="Ich bin mir bei der Menge unsicher" type="boolean" defaultValue="false"></camunda:formField></camunda:formData></bpmn:extensionElements>
          <bpmn:incoming>Flow_SP_Melden_Start_U_Bestand</bpmn:incoming>
          <bpmn:outgoing>Flow_U_Bestand_SP_Melden_Ende</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:endEvent id="SP_Melden_Ende" name="Aufgabe erledigt">
          <bpmn:incoming>Flow_U_Bestand_SP_Melden_Ende</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:boundaryEvent id="SP_Melden_Erinn" name="Erinnerung fällig" attachedToRef="U_Bestand" cancelActivity="false">
          <bpmn:outgoing>Flow_SP_Melden_Erinn_E_ErinnBestand</bpmn:outgoing>
          <bpmn:timerEventDefinition id="ED_SP_Melden_Erinn"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">${erinnerungszyklus}</bpmn:timeCycle></bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:endEvent id="E_ErinnBestand" name="Erinnerung versandt">
          <bpmn:documentation>Erinnerung über den gemeinsamen Benachrichtigungsdienst. Kein Endzustand des Vorgangs, nur das Ende des Erinnerungs-Tokens.</bpmn:documentation>
          <bpmn:incoming>Flow_SP_Melden_Erinn_E_ErinnBestand</bpmn:incoming>
          <bpmn:messageEventDefinition id="ED_E_ErinnBestand" messageRef="Msg_MV_Benachrichtigung" camunda:type="external" camunda:topic="t2-benachrichtigung-senden" />
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_SP_Melden_Start_U_Bestand" sourceRef="SP_Melden_Start" targetRef="U_Bestand" />
        <bpmn:sequenceFlow id="Flow_U_Bestand_SP_Melden_Ende" sourceRef="U_Bestand" targetRef="SP_Melden_Ende" />
        <bpmn:sequenceFlow id="Flow_SP_Melden_Erinn_E_ErinnBestand" sourceRef="SP_Melden_Erinn" targetRef="E_ErinnBestand" />
      </bpmn:subProcess>
      <bpmn:boundaryEvent id="B_FristBestand" name="Meldefrist abgelaufen" attachedToRef="SP_Melden">
        <bpmn:outgoing>Flow_B_FristBestand_G_Erneut</bpmn:outgoing>
        <bpmn:timerEventDefinition id="ED_B_FristBestand"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${fristBestandsmeldung}</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:exclusiveGateway id="G_Erneut" name="Erneut anfragen?" default="Flow_G_Erneut_E_BestandFehlt">
        <bpmn:incoming>Flow_B_FristBestand_G_Erneut</bpmn:incoming>
        <bpmn:outgoing>Flow_G_Erneut_SP_Melden</bpmn:outgoing>
        <bpmn:outgoing>Flow_G_Erneut_E_BestandFehlt</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="E_BestandFehlt" name="Bestand nicht gemeldet">
        <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('ergebnisBedarf', 'BESTAND_FEHLT')}" event="start" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_G_Erneut_E_BestandFehlt</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="T_Reichweite" name="Verbrauch und Reichweite berechnen" camunda:type="external" camunda:topic="t2-reichweite-berechnen">
        <bpmn:documentation>Reichweite = Bestand / Verbrauch pro Tag und voraussichtlicher Tag der Unterschreitung. Keine medizinische Bewertung.</bpmn:documentation>
        <bpmn:incoming>Flow_G_Bestand_T_Reichweite</bpmn:incoming>
        <bpmn:incoming>Flow_SP_Melden_T_Reichweite</bpmn:incoming>
        <bpmn:outgoing>Flow_T_Reichweite_G_Reicht</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_Reicht" name="Reicht der Bestand bis Prüfung + Lieferzeit?" default="Flow_G_Reicht_E_KeinBedarf">
        <bpmn:incoming>Flow_T_Reichweite_G_Reicht</bpmn:incoming>
        <bpmn:outgoing>Flow_G_Reicht_E_Nachv</bpmn:outgoing>
        <bpmn:outgoing>Flow_G_Reicht_E_KeinBedarf</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="E_KeinBedarf" name="Kein Bedarf">
        <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('ergebnisBedarf', 'KEIN_BEDARF')}" event="start" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_G_Reicht_E_KeinBedarf</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="E_Nachv" name="Nachversorgung nötig">
        <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('ergebnisBedarf', 'NACHVERSORGUNG')}" event="start" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_G_Reicht_E_Nachv</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_B_Start_R_Profil" sourceRef="B_Start" targetRef="R_Profil" />
      <bpmn:sequenceFlow id="Flow_R_Profil_R_Fristen" sourceRef="R_Profil" targetRef="R_Fristen" />
      <bpmn:sequenceFlow id="Flow_R_Fristen_G_Bestand" sourceRef="R_Fristen" targetRef="G_Bestand" />
      <bpmn:sequenceFlow id="Flow_G_Bestand_T_Reichweite" name="ja" sourceRef="G_Bestand" targetRef="T_Reichweite"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bestandBekannt}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_G_Bestand_SP_Melden" name="nein" sourceRef="G_Bestand" targetRef="SP_Melden" />
      <bpmn:sequenceFlow id="Flow_SP_Melden_T_Reichweite" sourceRef="SP_Melden" targetRef="T_Reichweite" />
      <bpmn:sequenceFlow id="Flow_B_FristBestand_G_Erneut" sourceRef="B_FristBestand" targetRef="G_Erneut" />
      <bpmn:sequenceFlow id="Flow_G_Erneut_SP_Melden" name="ja" sourceRef="G_Erneut" targetRef="SP_Melden"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('anzahlAnfragen', anzahlAnfragen + 1)}" event="take" /></bpmn:extensionElements><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${anzahlAnfragen &lt; maxAnfragenBestand}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_G_Erneut_E_BestandFehlt" name="nein" sourceRef="G_Erneut" targetRef="E_BestandFehlt" />
      <bpmn:sequenceFlow id="Flow_T_Reichweite_G_Reicht" sourceRef="T_Reichweite" targetRef="G_Reicht" />
      <bpmn:sequenceFlow id="Flow_G_Reicht_E_Nachv" name="nein" sourceRef="G_Reicht" targetRef="E_Nachv"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${nachversorgungNoetig}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_G_Reicht_E_KeinBedarf" name="ja" sourceRef="G_Reicht" targetRef="E_KeinBedarf" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="G_Bedarf" name="Ergebnis der Bedarfsermittlung?" default="Flow_G_Bedarf_E_KeinBestand">
      <bpmn:incoming>Flow_SP_Bedarf_G_Bedarf</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Bedarf_SP_Freigabe</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Bedarf_T_Termin</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Bedarf_E_KeinBestand</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Termin" name="Nächste Prüfung terminieren" camunda:type="external" camunda:topic="t2-pruefung-terminieren">
      <bpmn:documentation>Legt den nächsten Prüftermin fest und meldet ihn dem Prüfplaner der App, der zum Termin den Prozess neu startet. Bei Aufschub kürzer.</bpmn:documentation>
      <bpmn:incoming>Flow_G_Bedarf_T_Termin</bpmn:incoming>
      <bpmn:incoming>Flow_G_Freigabe_T_Termin</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Termin_E_Termin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_Termin" name="Kunde informiert: nächste Prüfung terminiert">
      <bpmn:documentation>Kein Bedarf oder Aufschub durch den Kunden. Der Text nennt Reichweite und Termin, bei Aufschub zusätzlich das Reichweitenrisiko.</bpmn:documentation>
      <bpmn:incoming>Flow_T_Termin_E_Termin</bpmn:incoming>
      <bpmn:messageEventDefinition id="ED_E_Termin" messageRef="Msg_MV_Benachrichtigung" camunda:type="external" camunda:topic="t2-benachrichtigung-senden" />
    </bpmn:endEvent>
    <bpmn:endEvent id="E_KeinBestand" name="Abgebrochen: Bestand nicht gemeldet">
      <bpmn:documentation>Nachrichten-Endereignis: der gemeinsame Benachrichtigungsdienst informiert den Kunden über die Pflege-App (SIMULIERT).</bpmn:documentation>
      <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Abgebrochen')}" event="start" /><camunda:executionListener expression="${execution.setVariable('ergebnis', 'Bestand trotz Erinnerung und erneuter Anfrage nicht gemeldet')}" event="start" /><camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Vorgang geschlossen')}" event="start" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Bedarf_E_KeinBestand</bpmn:incoming>
      <bpmn:messageEventDefinition id="ED_E_KeinBestand" messageRef="Msg_MV_Benachrichtigung" camunda:type="external" camunda:topic="t2-benachrichtigung-senden" />
    </bpmn:endEvent>
    <bpmn:subProcess id="SP_Freigabe" name="Bestellung vorschlagen und freigeben">
      <bpmn:documentation>Teamauftrag Schritte 4 bis 7: Vorschlag, Abweichungen, Berechtigungsregel, Kundenentscheidung oder Prüfstelle.</bpmn:documentation>
      <bpmn:incoming>Flow_G_Bedarf_SP_Freigabe</bpmn:incoming>
      <bpmn:incoming>Flow_G_Bestellung_SP_Freigabe</bpmn:incoming>
      <bpmn:incoming>Flow_G_Lieferung_SP_Freigabe</bpmn:incoming>
      <bpmn:outgoing>Flow_SP_Freigabe_G_Freigabe</bpmn:outgoing>
      <bpmn:startEvent id="F_Start" name="Bedarf festgestellt">
        <bpmn:outgoing>Flow_F_Start_T_Vorschlag</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="T_Vorschlag" name="Produkt, Menge und Lieferant vorschlagen" camunda:type="external" camunda:topic="t2-vorschlag-erstellen">
        <bpmn:documentation>Menge = Fehlmenge bis Zielbestand, aufgerundet auf ganze Packungen. Änderungswunsch des Kunden (Menge, Ersatzprodukt, Alternativlieferant) hat Vorrang.</bpmn:documentation>
        <bpmn:incoming>Flow_F_Start_T_Vorschlag</bpmn:incoming>
        <bpmn:incoming>Flow_G_Entsch_T_Vorschlag</bpmn:incoming>
        <bpmn:outgoing>Flow_T_Vorschlag_T_Abweichung</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_Abweichung" name="Abweichungen prüfen" camunda:type="external" camunda:topic="t2-abweichungen-pruefen">
        <bpmn:documentation>Bewertet Preis, Produktwechsel, Verbrauchssprung, Lieferant und Menge gegenüber dem Produktprofil. Bei Nichtverfügbarkeit nur die hinterlegte Ersatzoption.</bpmn:documentation>
        <bpmn:incoming>Flow_T_Vorschlag_T_Abweichung</bpmn:incoming>
        <bpmn:outgoing>Flow_T_Abweichung_R_Regel</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:businessRuleTask id="R_Regel" name="Berechtigung prüfen" camunda:decisionRef="T2_Berechtigungsregel" camunda:resultVariable="berechtigung" camunda:mapDecisionResult="singleResult">
        <bpmn:documentation>Gemeinsamer Dienst für alle Teams: DMN T2_Berechtigungsregel. Ergebnis AUTOMATISCH, KUNDENFREIGABE oder PRUEFSTELLE mit Begründung.</bpmn:documentation>
        <bpmn:extensionElements><camunda:inputOutput><camunda:outputParameter name="freigabeweg">${berechtigung.freigabeweg}</camunda:outputParameter><camunda:outputParameter name="begruendung">${berechtigung.begruendung}</camunda:outputParameter></camunda:inputOutput></bpmn:extensionElements>
        <bpmn:incoming>Flow_T_Abweichung_R_Regel</bpmn:incoming>
        <bpmn:outgoing>Flow_R_Regel_G_Weg</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="G_Weg" name="Freigabeweg?" default="Flow_G_Weg_U_Grenzfall">
        <bpmn:incoming>Flow_R_Regel_G_Weg</bpmn:incoming>
        <bpmn:outgoing>Flow_G_Weg_E_Frei</bpmn:outgoing>
        <bpmn:outgoing>Flow_G_Weg_C_Entscheidung</bpmn:outgoing>
        <bpmn:outgoing>Flow_G_Weg_U_Grenzfall</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="U_Grenzfall" name="Grenzfall prüfen" camunda:candidateGroups="pruefstelle">
        <bpmn:documentation>Anlass: weder bevorzugtes Produkt noch hinterlegte Ersatzoption lieferbar. Benötigt: Profil, Abweichungen. Rolle: menschliche Prüfstelle. Ergebnis: Kundenentscheidung mit Hinweis oder dokumentierte Übergabe. Frist: fristPruefstelle. Kein medizinischer Ersatz.</bpmn:documentation>
        <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Klärung erforderlich')}" event="start" /><camunda:formData><camunda:formField id="abweichungen" label="Festgestellte Abweichungen" type="string"><camunda:validation><camunda:constraint name="readonly" /></camunda:validation></camunda:formField><camunda:formField id="pruefErgebnis" label="Ergebnis der Prüfung" type="enum"><camunda:validation><camunda:constraint name="required" /></camunda:validation><camunda:value id="KUNDENENTSCHEIDUNG" name="Kunden mit Hinweis entscheiden lassen" /><camunda:value id="UEBERGEBEN" name="Nicht lösbar: Vorgang übergeben" /></camunda:formField><camunda:formField id="pruefNotiz" label="Begründung" type="string"><camunda:validation><camunda:constraint name="required" /></camunda:validation></camunda:formField></camunda:formData></bpmn:extensionElements>
        <bpmn:incoming>Flow_G_Weg_U_Grenzfall</bpmn:incoming>
        <bpmn:outgoing>Flow_U_Grenzfall_G_Grenz</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="B_FristGrenz" name="Prüffrist abgelaufen" attachedToRef="U_Grenzfall">
        <bpmn:outgoing>Flow_B_FristGrenz_E_Grenz</bpmn:outgoing>
        <bpmn:timerEventDefinition id="ED_B_FristGrenz"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${fristPruefstelle}</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:exclusiveGateway id="G_Grenz" name="Prüfergebnis?" default="Flow_G_Grenz_E_Grenz">
        <bpmn:incoming>Flow_U_Grenzfall_G_Grenz</bpmn:incoming>
        <bpmn:outgoing>Flow_G_Grenz_C_Entscheidung</bpmn:outgoing>
        <bpmn:outgoing>Flow_G_Grenz_E_Grenz</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:callActivity id="C_Entscheidung" name="Kundenentscheidung einholen" calledElement="T2_Kundenentscheidung_einholen">
        <bpmn:documentation>Gemeinsame Funktion von Team 2 für alle Teams. Call by Value: nur die genannten Variablen gehen hinein und heraus.</bpmn:documentation>
        <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Wartet auf Kunde')}" event="start" /><camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Kundenentscheidung angefordert')}" event="start" /><camunda:in businessKey="#{execution.processBusinessKey}" /><camunda:in source="pflegehaushaltId" target="pflegehaushaltId" /><camunda:in source="vorgangId" target="vorgangId" /><camunda:in source="freigabeHandlung" target="freigabeHandlung" /><camunda:in sourceExpression="${freigabeBegruendung.concat(' Regel: ').concat(begruendung)}" target="freigabeBegruendung" /><camunda:in source="freigabeFolgen" target="freigabeFolgen" /><camunda:in source="freigabeGueltigBis" target="freigabeGueltigBis" /><camunda:in source="fristKundenentscheidung" target="fristKundenentscheidung" /><camunda:in source="erinnerungszyklus" target="erinnerungszyklus" /><camunda:out source="entscheidung" target="entscheidung" /><camunda:out source="entscheidungKommentar" target="entscheidungKommentar" /><camunda:out source="gewuenschteMenge" target="gewuenschteMenge" /><camunda:out source="gewuenschteAlternative" target="gewuenschteAlternative" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_G_Weg_C_Entscheidung</bpmn:incoming>
        <bpmn:incoming>Flow_G_Grenz_C_Entscheidung</bpmn:incoming>
        <bpmn:outgoing>Flow_C_Entscheidung_G_Entsch</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:exclusiveGateway id="G_Entsch" name="Entscheidung des Kunden?" default="Flow_G_Entsch_E_Keine">
        <bpmn:incoming>Flow_C_Entscheidung_G_Entsch</bpmn:incoming>
        <bpmn:outgoing>Flow_G_Entsch_E_Frei</bpmn:outgoing>
        <bpmn:outgoing>Flow_G_Entsch_T_Vorschlag</bpmn:outgoing>
        <bpmn:outgoing>Flow_G_Entsch_E_Abgel</bpmn:outgoing>
        <bpmn:outgoing>Flow_G_Entsch_E_Aufsch</bpmn:outgoing>
        <bpmn:outgoing>Flow_G_Entsch_E_Keine</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="E_Frei" name="Bestellung freigegeben">
        <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('ergebnisFreigabe', 'FREIGEGEBEN')}" event="start" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_G_Weg_E_Frei</bpmn:incoming>
        <bpmn:incoming>Flow_G_Entsch_E_Frei</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="E_Abgel" name="Abgelehnt">
        <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('ergebnisFreigabe', 'ABGELEHNT')}" event="start" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_G_Entsch_E_Abgel</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="E_Aufsch" name="Aufgeschoben">
        <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('ergebnisFreigabe', 'AUFGESCHOBEN')}" event="start" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_G_Entsch_E_Aufsch</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="E_Keine" name="Keine Antwort">
        <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('ergebnisFreigabe', 'KEINE_ANTWORT')}" event="start" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_G_Entsch_E_Keine</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="E_Grenz" name="Grenzfall nicht lösbar">
        <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('ergebnisFreigabe', 'GRENZFALL')}" event="start" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_B_FristGrenz_E_Grenz</bpmn:incoming>
        <bpmn:incoming>Flow_G_Grenz_E_Grenz</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_F_Start_T_Vorschlag" sourceRef="F_Start" targetRef="T_Vorschlag" />
      <bpmn:sequenceFlow id="Flow_T_Vorschlag_T_Abweichung" sourceRef="T_Vorschlag" targetRef="T_Abweichung" />
      <bpmn:sequenceFlow id="Flow_T_Abweichung_R_Regel" sourceRef="T_Abweichung" targetRef="R_Regel" />
      <bpmn:sequenceFlow id="Flow_R_Regel_G_Weg" sourceRef="R_Regel" targetRef="G_Weg" />
      <bpmn:sequenceFlow id="Flow_G_Weg_E_Frei" name="automatisch" sourceRef="G_Weg" targetRef="E_Frei"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${freigabeweg == 'AUTOMATISCH'}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_G_Weg_C_Entscheidung" name="Kundenfreigabe" sourceRef="G_Weg" targetRef="C_Entscheidung"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${freigabeweg == 'KUNDENFREIGABE'}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_G_Weg_U_Grenzfall" name="Prüfstelle" sourceRef="G_Weg" targetRef="U_Grenzfall" />
      <bpmn:sequenceFlow id="Flow_U_Grenzfall_G_Grenz" sourceRef="U_Grenzfall" targetRef="G_Grenz" />
      <bpmn:sequenceFlow id="Flow_B_FristGrenz_E_Grenz" sourceRef="B_FristGrenz" targetRef="E_Grenz" />
      <bpmn:sequenceFlow id="Flow_G_Grenz_C_Entscheidung" name="Kunde entscheidet" sourceRef="G_Grenz" targetRef="C_Entscheidung"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${pruefErgebnis == 'KUNDENENTSCHEIDUNG'}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_G_Grenz_E_Grenz" name="nicht lösbar" sourceRef="G_Grenz" targetRef="E_Grenz" />
      <bpmn:sequenceFlow id="Flow_C_Entscheidung_G_Entsch" sourceRef="C_Entscheidung" targetRef="G_Entsch" />
      <bpmn:sequenceFlow id="Flow_G_Entsch_E_Frei" name="Freigegeben" sourceRef="G_Entsch" targetRef="E_Frei"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${entscheidung == 'FREIGEGEBEN'}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_G_Entsch_T_Vorschlag" name="Änderung gewünscht" sourceRef="G_Entsch" targetRef="T_Vorschlag"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${entscheidung == 'AENDERUNG'}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_G_Entsch_E_Abgel" name="Abgelehnt" sourceRef="G_Entsch" targetRef="E_Abgel"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${entscheidung == 'ABGELEHNT'}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_G_Entsch_E_Aufsch" name="Aufgeschoben" sourceRef="G_Entsch" targetRef="E_Aufsch"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${entscheidung == 'AUFSCHUB'}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_G_Entsch_E_Keine" name="Keine Antwort" sourceRef="G_Entsch" targetRef="E_Keine" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="G_Freigabe" name="Ergebnis der Freigabe?" default="Flow_G_Freigabe_E_Grenzfall">
      <bpmn:incoming>Flow_SP_Freigabe_G_Freigabe</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Freigabe_SP_Bestellung</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Freigabe_T_Termin</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Freigabe_E_Abgelehnt</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Freigabe_E_KeineAntwortK</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Freigabe_E_Grenzfall</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_Abgelehnt" name="Kunde informiert: Bestellung abgelehnt">
      <bpmn:documentation>Nachrichten-Endereignis: der gemeinsame Benachrichtigungsdienst informiert den Kunden über die Pflege-App (SIMULIERT).</bpmn:documentation>
      <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Erfolglos abgeschlossen')}" event="start" /><camunda:executionListener expression="${execution.setVariable('ergebnis', 'Kunde hat abgelehnt, keine Bestellung, Reichweitenrisiko mitgeteilt')}" event="start" /><camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Vorgang geschlossen')}" event="start" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Freigabe_E_Abgelehnt</bpmn:incoming>
      <bpmn:messageEventDefinition id="ED_E_Abgelehnt" messageRef="Msg_MV_Benachrichtigung" camunda:type="external" camunda:topic="t2-benachrichtigung-senden" />
    </bpmn:endEvent>
    <bpmn:endEvent id="E_KeineAntwortK" name="Kunde informiert: keine Antwort, keine Bestellung">
      <bpmn:documentation>Nachrichten-Endereignis: der gemeinsame Benachrichtigungsdienst informiert den Kunden über die Pflege-App (SIMULIERT).</bpmn:documentation>
      <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Erfolglos abgeschlossen')}" event="start" /><camunda:executionListener expression="${execution.setVariable('ergebnis', 'Kunde hat nicht geantwortet, keine Bestellung (keine Antwort ist keine Freigabe), Reichweitenrisiko mitgeteilt')}" event="start" /><camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Vorgang geschlossen')}" event="start" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Freigabe_E_KeineAntwortK</bpmn:incoming>
      <bpmn:messageEventDefinition id="ED_E_KeineAntwortK" messageRef="Msg_MV_Benachrichtigung" camunda:type="external" camunda:topic="t2-benachrichtigung-senden" />
    </bpmn:endEvent>
    <bpmn:endEvent id="E_Grenzfall" name="Übergeben: Grenzfall nicht lösbar">
      <bpmn:documentation>Nachrichten-Endereignis: der gemeinsame Benachrichtigungsdienst informiert den Kunden über die Pflege-App (SIMULIERT).</bpmn:documentation>
      <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Übergeben')}" event="start" /><camunda:executionListener expression="${execution.setVariable('ergebnis', 'Grenzfall von der Prüfstelle mit Begründung übergeben')}" event="start" /><camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Vorgang geschlossen')}" event="start" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Freigabe_E_Grenzfall</bpmn:incoming>
      <bpmn:messageEventDefinition id="ED_E_Grenzfall" messageRef="Msg_MV_Benachrichtigung" camunda:type="external" camunda:topic="t2-benachrichtigung-senden" />
    </bpmn:endEvent>
    <bpmn:subProcess id="SP_Bestellung" name="Bestellung abwickeln">
      <bpmn:documentation>Teamauftrag Schritte 8 und 9: Bestellung simuliert auslösen, auf Bestätigung warten, nachfassen. Das Warten bleibt aktiv, während nachgefasst wird (nicht unterbrechender Timer am Empfang).</bpmn:documentation>
      <bpmn:incoming>Flow_G_Freigabe_SP_Bestellung</bpmn:incoming>
      <bpmn:outgoing>Flow_SP_Bestellung_G_Bestellung</bpmn:outgoing>
      <bpmn:startEvent id="O_Start" name="Bestellung freigegeben">
        <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Freigegeben')}" event="start" /></bpmn:extensionElements>
        <bpmn:outgoing>Flow_O_Start_ST_Bestellen</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sendTask id="ST_Bestellen" name="Bestellung simuliert übermitteln" camunda:type="external" camunda:topic="t2-bestellung-uebermitteln">
        <bpmn:documentation>Überträgt Lieferant, Produkt, Menge, Preis und Freigabe an den Lieferdienst. SIMULIERT, keine echte Bestellung.</bpmn:documentation>
        <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'In Ausführung')}" event="start" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_O_Start_ST_Bestellen</bpmn:incoming>
        <bpmn:outgoing>Flow_ST_Bestellen_RT_Bestaetigung</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="RT_Bestaetigung" name="Auf Bestellbestätigung warten" messageRef="Msg_MV_Bestaetigung">
        <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Wartet auf Gegenstelle')}" event="start" /><camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Antwort eingegangen')}" event="end" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_ST_Bestellen_RT_Bestaetigung</bpmn:incoming>
        <bpmn:outgoing>Flow_RT_Bestaetigung_E_Bestaetigt</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:boundaryEvent id="B_Nachfassen" name="Bestätigungsfrist abgelaufen" attachedToRef="RT_Bestaetigung" cancelActivity="false">
        <bpmn:outgoing>Flow_B_Nachfassen_ST_Nachfassen</bpmn:outgoing>
        <bpmn:timerEventDefinition id="ED_B_Nachfassen"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">${nachfasszyklusLieferant}</bpmn:timeCycle></bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sendTask id="ST_Nachfassen" name="Beim Lieferanten nachfassen (über Team 3)" camunda:type="external" camunda:topic="t3-nachfassen">
        <bpmn:documentation>Kommunikationsauftrag an den Baustein von Team 3. Der Zähler anzahlNachfassen wird im Prozess erhöht, nicht im Dienst.</bpmn:documentation>
        <bpmn:incoming>Flow_B_Nachfassen_ST_Nachfassen</bpmn:incoming>
        <bpmn:outgoing>Flow_ST_Nachfassen_E_Nachgefasst</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="E_Nachgefasst" name="Nachfassen ausgelöst">
        <bpmn:incoming>Flow_ST_Nachfassen_E_Nachgefasst</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:boundaryEvent id="B_Endgueltig" name="Endgültige Frist abgelaufen" attachedToRef="RT_Bestaetigung">
        <bpmn:outgoing>Flow_B_Endgueltig_U_LiefAntwort</bpmn:outgoing>
        <bpmn:timerEventDefinition id="ED_B_Endgueltig"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${fristBestaetigungEndgueltig}</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="B_NichtLieferbar" name="Nicht lieferbar gemeldet" attachedToRef="RT_Bestaetigung">
        <bpmn:outgoing>Flow_B_NichtLieferbar_E_Neu</bpmn:outgoing>
        <bpmn:messageEventDefinition id="ED_B_NichtLieferbar" messageRef="Msg_MV_NichtLieferbar" />
      </bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="B_ZustellungFrueh" name="Zustellung gemeldet" attachedToRef="RT_Bestaetigung">
        <bpmn:outgoing>Flow_B_ZustellungFrueh_E_Bestaetigt</bpmn:outgoing>
        <bpmn:messageEventDefinition id="ED_B_ZustellungFrueh" messageRef="Msg_MV_Zustellung" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="U_LiefAntwort" name="Ausbleibende Lieferantenantwort klären" camunda:candidateGroups="pruefstelle">
        <bpmn:documentation>Anlass: Lieferant hat trotz Nachfassen nicht bestätigt. Benötigt: Bestellung, Nachfassverlauf, Alternativlieferant. Rolle: menschliche Prüfstelle. Ergebnis: Alternativlieferant (wird neu geprüft) oder dokumentiertes Ende. Frist: fristPruefstelle.</bpmn:documentation>
        <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Klärung erforderlich')}" event="start" /><camunda:formData><camunda:formField id="anzahlNachfassen" label="Bisher nachgefasst" type="long"><camunda:validation><camunda:constraint name="readonly" /></camunda:validation></camunda:formField><camunda:formField id="lieferantErgebnis" label="Wie geht es weiter?" type="enum"><camunda:validation><camunda:constraint name="required" /></camunda:validation><camunda:value id="ALTERNATIVLIEFERANT" name="Zugelassenen Alternativlieferanten vorlegen" /><camunda:value id="BEENDEN" name="Vorgang mit Grund beenden" /></camunda:formField><camunda:formField id="pruefNotiz" label="Begründung" type="string"><camunda:validation><camunda:constraint name="required" /></camunda:validation></camunda:formField></camunda:formData></bpmn:extensionElements>
        <bpmn:incoming>Flow_B_Endgueltig_U_LiefAntwort</bpmn:incoming>
        <bpmn:outgoing>Flow_U_LiefAntwort_G_LiefAntwort</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="B_FristLief" name="Prüffrist abgelaufen" attachedToRef="U_LiefAntwort">
        <bpmn:outgoing>Flow_B_FristLief_E_KeineAntwort</bpmn:outgoing>
        <bpmn:timerEventDefinition id="ED_B_FristLief"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${fristPruefstelle}</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="B_SpaetBestaetigt" name="Doch noch bestätigt" attachedToRef="U_LiefAntwort">
        <bpmn:outgoing>Flow_B_SpaetBestaetigt_E_Bestaetigt</bpmn:outgoing>
        <bpmn:messageEventDefinition id="ED_B_SpaetBestaetigt" messageRef="Msg_MV_Bestaetigung" />
      </bpmn:boundaryEvent>
      <bpmn:exclusiveGateway id="G_LiefAntwort" name="Ergebnis der Klärung?" default="Flow_G_LiefAntwort_E_KeineAntwort">
        <bpmn:incoming>Flow_U_LiefAntwort_G_LiefAntwort</bpmn:incoming>
        <bpmn:outgoing>Flow_G_LiefAntwort_E_Neu</bpmn:outgoing>
        <bpmn:outgoing>Flow_G_LiefAntwort_E_KeineAntwort</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="E_Bestaetigt" name="Bestellung bestätigt">
        <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('ergebnisBestellung', 'BESTAETIGT')}" event="start" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_RT_Bestaetigung_E_Bestaetigt</bpmn:incoming>
        <bpmn:incoming>Flow_B_ZustellungFrueh_E_Bestaetigt</bpmn:incoming>
        <bpmn:incoming>Flow_B_SpaetBestaetigt_E_Bestaetigt</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="E_Neu" name="Neue Auswahl nötig">
        <bpmn:documentation>Nicht lieferbar (Ersatzoption prüfen) oder Alternativlieferant gewählt: Vorschlag und Freigabe laufen neu.</bpmn:documentation>
        <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('ergebnisBestellung', 'NEUE_AUSWAHL')}" event="start" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_B_NichtLieferbar_E_Neu</bpmn:incoming>
        <bpmn:incoming>Flow_G_LiefAntwort_E_Neu</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="E_KeineAntwort" name="Lieferant antwortet nicht">
        <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('ergebnisBestellung', 'KEINE_ANTWORT')}" event="start" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_B_FristLief_E_KeineAntwort</bpmn:incoming>
        <bpmn:incoming>Flow_G_LiefAntwort_E_KeineAntwort</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_O_Start_ST_Bestellen" sourceRef="O_Start" targetRef="ST_Bestellen" />
      <bpmn:sequenceFlow id="Flow_ST_Bestellen_RT_Bestaetigung" sourceRef="ST_Bestellen" targetRef="RT_Bestaetigung" />
      <bpmn:sequenceFlow id="Flow_RT_Bestaetigung_E_Bestaetigt" sourceRef="RT_Bestaetigung" targetRef="E_Bestaetigt" />
      <bpmn:sequenceFlow id="Flow_B_Nachfassen_ST_Nachfassen" sourceRef="B_Nachfassen" targetRef="ST_Nachfassen"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('anzahlNachfassen', anzahlNachfassen + 1)}" event="take" /></bpmn:extensionElements></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_ST_Nachfassen_E_Nachgefasst" sourceRef="ST_Nachfassen" targetRef="E_Nachgefasst" />
      <bpmn:sequenceFlow id="Flow_B_Endgueltig_U_LiefAntwort" sourceRef="B_Endgueltig" targetRef="U_LiefAntwort" />
      <bpmn:sequenceFlow id="Flow_B_NichtLieferbar_E_Neu" sourceRef="B_NichtLieferbar" targetRef="E_Neu"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('produktVerfuegbar', false)}" event="take" /></bpmn:extensionElements></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_B_ZustellungFrueh_E_Bestaetigt" sourceRef="B_ZustellungFrueh" targetRef="E_Bestaetigt"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('zustellungGemeldet', true)}" event="take" /></bpmn:extensionElements></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_U_LiefAntwort_G_LiefAntwort" sourceRef="U_LiefAntwort" targetRef="G_LiefAntwort" />
      <bpmn:sequenceFlow id="Flow_B_SpaetBestaetigt_E_Bestaetigt" sourceRef="B_SpaetBestaetigt" targetRef="E_Bestaetigt" />
      <bpmn:sequenceFlow id="Flow_B_FristLief_E_KeineAntwort" sourceRef="B_FristLief" targetRef="E_KeineAntwort" />
      <bpmn:sequenceFlow id="Flow_G_LiefAntwort_E_Neu" name="Alternativlieferant" sourceRef="G_LiefAntwort" targetRef="E_Neu"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('aktuellerLieferant', alternativLieferant)}" event="take" /></bpmn:extensionElements><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${lieferantErgebnis == 'ALTERNATIVLIEFERANT'}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_G_LiefAntwort_E_KeineAntwort" name="beenden" sourceRef="G_LiefAntwort" targetRef="E_KeineAntwort" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="G_Bestellung" name="Ergebnis der Bestellung?" default="Flow_G_Bestellung_E_KeinLieferant">
      <bpmn:incoming>Flow_SP_Bestellung_G_Bestellung</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Bestellung_SP_Lieferung</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Bestellung_SP_Freigabe</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Bestellung_E_KeinLieferant</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_KeinLieferant" name="Erfolglos: Lieferant antwortet nicht">
      <bpmn:documentation>Nachrichten-Endereignis: der gemeinsame Benachrichtigungsdienst informiert den Kunden über die Pflege-App (SIMULIERT).</bpmn:documentation>
      <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Erfolglos abgeschlossen')}" event="start" /><camunda:executionListener expression="${execution.setVariable('ergebnis', 'Lieferant hat trotz Nachfassen nicht bestätigt, Vorgang mit Grund beendet')}" event="start" /><camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Vorgang geschlossen')}" event="start" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Bestellung_E_KeinLieferant</bpmn:incoming>
      <bpmn:messageEventDefinition id="ED_E_KeinLieferant" messageRef="Msg_MV_Benachrichtigung" camunda:type="external" camunda:topic="t2-benachrichtigung-senden" />
    </bpmn:endEvent>
    <bpmn:subProcess id="SP_Lieferung" name="Lieferung überwachen und prüfen">
      <bpmn:documentation>Teamauftrag Schritte 9 und 10: Versand und Zustellung verfolgen, mahnen, Lieferung bestätigen lassen, Abweichungen klären.</bpmn:documentation>
      <bpmn:incoming>Flow_G_Bestellung_SP_Lieferung</bpmn:incoming>
      <bpmn:outgoing>Flow_SP_Lieferung_G_Lieferung</bpmn:outgoing>
      <bpmn:startEvent id="L_Start" name="Bestellung bestätigt">
        <bpmn:outgoing>Flow_L_Start_G_Zugestellt</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="G_Zugestellt" name="Zustellung schon gemeldet?" default="Flow_G_Zugestellt_RT_Zustellung">
        <bpmn:incoming>Flow_L_Start_G_Zugestellt</bpmn:incoming>
        <bpmn:outgoing>Flow_G_Zugestellt_SP_Bestaetigen</bpmn:outgoing>
        <bpmn:outgoing>Flow_G_Zugestellt_RT_Zustellung</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:receiveTask id="RT_Zustellung" name="Auf Zustellmeldung warten" messageRef="Msg_MV_Zustellung">
        <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Wartet auf Gegenstelle')}" event="start" /><camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Lieferung gemeldet')}" event="end" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_G_Zugestellt_RT_Zustellung</bpmn:incoming>
        <bpmn:incoming>Flow_G_Klaerung_RT_Zustellung</bpmn:incoming>
        <bpmn:outgoing>Flow_RT_Zustellung_SP_Bestaetigen</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:boundaryEvent id="B_Versand" name="Versand gemeldet" attachedToRef="RT_Zustellung" cancelActivity="false">
        <bpmn:outgoing>Flow_B_Versand_E_Versand</bpmn:outgoing>
        <bpmn:messageEventDefinition id="ED_B_Versand" messageRef="Msg_MV_Versand" />
      </bpmn:boundaryEvent>
      <bpmn:endEvent id="E_Versand" name="Versand vermerkt">
        <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('versandGemeldet', true)}" event="start" /><camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Versand gemeldet')}" event="start" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_B_Versand_E_Versand</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:boundaryEvent id="B_Mahnung" name="Lieferfrist überschritten" attachedToRef="RT_Zustellung" cancelActivity="false">
        <bpmn:outgoing>Flow_B_Mahnung_ST_Mahnen</bpmn:outgoing>
        <bpmn:timerEventDefinition id="ED_B_Mahnung"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">${mahnzyklusLieferung}</bpmn:timeCycle></bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sendTask id="ST_Mahnen" name="Lieferung anmahnen (über Team 3)" camunda:type="external" camunda:topic="t3-mahnen">
        <bpmn:incoming>Flow_B_Mahnung_ST_Mahnen</bpmn:incoming>
        <bpmn:outgoing>Flow_ST_Mahnen_E_Mahnung</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="E_Mahnung" name="Mahnung ausgelöst">
        <bpmn:incoming>Flow_ST_Mahnen_E_Mahnung</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:boundaryEvent id="B_LieferungAus" name="Lieferung endgültig ausgeblieben" attachedToRef="RT_Zustellung">
        <bpmn:outgoing>Flow_B_LieferungAus_T_Erfassen</bpmn:outgoing>
        <bpmn:timerEventDefinition id="ED_B_LieferungAus"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${fristLieferungEndgueltig}</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="B_NichtLieferbar2" name="Nicht lieferbar gemeldet" attachedToRef="RT_Zustellung">
        <bpmn:outgoing>Flow_B_NichtLieferbar2_E_NichtLieferbar2</bpmn:outgoing>
        <bpmn:messageEventDefinition id="ED_B_NichtLieferbar2" messageRef="Msg_MV_NichtLieferbar" />
      </bpmn:boundaryEvent>
      <bpmn:subProcess id="SP_Bestaetigen" name="Lieferbestätigung einholen">
        <bpmn:documentation>Kapselt die Aufgabe „Lieferung prüfen und bestätigen“ samt Erinnerungen. Läuft die Frist am Rand ab, werden Aufgabe und Erinnerungen gemeinsam beendet.</bpmn:documentation>
        <bpmn:incoming>Flow_G_Zugestellt_SP_Bestaetigen</bpmn:incoming>
        <bpmn:incoming>Flow_RT_Zustellung_SP_Bestaetigen</bpmn:incoming>
        <bpmn:outgoing>Flow_SP_Bestaetigen_G_LiefOk</bpmn:outgoing>
        <bpmn:startEvent id="SP_Bestaetigen_Start" name="Aufgabe angelegt">
          <bpmn:outgoing>Flow_SP_Bestaetigen_Start_U_Lieferung</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:userTask id="U_Lieferung" name="Lieferung prüfen und bestätigen" camunda:candidateGroups="pflegende-person">
          <bpmn:documentation>Anlass: Lieferant meldet Zustellung. Benötigt: Bestellinhalt, erwartete Menge. Rolle: pflegende Person. Ergebnis: korrekt, teilweise, falsch oder nicht geliefert. Ohne Bestätigung wird der Vorgang nie automatisch erfolgreich geschlossen.</bpmn:documentation>
          <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Wartet auf Kunde')}" event="start" /><camunda:formData><camunda:formField id="lieferErgebnis" label="Wie ist die Lieferung angekommen?" type="enum"><camunda:validation><camunda:constraint name="required" /></camunda:validation><camunda:value id="KORREKT" name="Richtig und vollständig geliefert" /><camunda:value id="TEILLIEFERUNG" name="Nur teilweise geliefert" /><camunda:value id="FALSCHLIEFERUNG" name="Falsches Produkt geliefert" /><camunda:value id="NICHT_GELIEFERT" name="Nicht angekommen" /></camunda:formField><camunda:formField id="gelieferteMenge" label="Tatsächlich gelieferte brauchbare Menge (Stück)" type="long"></camunda:formField></camunda:formData></bpmn:extensionElements>
          <bpmn:incoming>Flow_SP_Bestaetigen_Start_U_Lieferung</bpmn:incoming>
          <bpmn:outgoing>Flow_U_Lieferung_SP_Bestaetigen_Ende</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:endEvent id="SP_Bestaetigen_Ende" name="Aufgabe erledigt">
          <bpmn:incoming>Flow_U_Lieferung_SP_Bestaetigen_Ende</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:boundaryEvent id="SP_Bestaetigen_Erinn" name="Erinnerung fällig" attachedToRef="U_Lieferung" cancelActivity="false">
          <bpmn:outgoing>Flow_SP_Bestaetigen_Erinn_E_ErinnLief</bpmn:outgoing>
          <bpmn:timerEventDefinition id="ED_SP_Bestaetigen_Erinn"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">${erinnerungszyklusLieferbestaetigung}</bpmn:timeCycle></bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:endEvent id="E_ErinnLief" name="Erinnerung versandt">
          <bpmn:documentation>Erinnerung über den gemeinsamen Benachrichtigungsdienst. Kein Endzustand des Vorgangs, nur das Ende des Erinnerungs-Tokens.</bpmn:documentation>
          <bpmn:incoming>Flow_SP_Bestaetigen_Erinn_E_ErinnLief</bpmn:incoming>
          <bpmn:messageEventDefinition id="ED_E_ErinnLief" messageRef="Msg_MV_Benachrichtigung" camunda:type="external" camunda:topic="t2-benachrichtigung-senden" />
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_SP_Bestaetigen_Start_U_Lieferung" sourceRef="SP_Bestaetigen_Start" targetRef="U_Lieferung" />
        <bpmn:sequenceFlow id="Flow_U_Lieferung_SP_Bestaetigen_Ende" sourceRef="U_Lieferung" targetRef="SP_Bestaetigen_Ende" />
        <bpmn:sequenceFlow id="Flow_SP_Bestaetigen_Erinn_E_ErinnLief" sourceRef="SP_Bestaetigen_Erinn" targetRef="E_ErinnLief" />
      </bpmn:subProcess>
      <bpmn:boundaryEvent id="B_FristLiefBest" name="Bestätigungsfrist abgelaufen" attachedToRef="SP_Bestaetigen">
        <bpmn:outgoing>Flow_B_FristLiefBest_E_Unbestaetigt</bpmn:outgoing>
        <bpmn:timerEventDefinition id="ED_B_FristLiefBest"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${fristLieferbestaetigung}</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:exclusiveGateway id="G_LiefOk" name="Lieferung korrekt?" default="Flow_G_LiefOk_T_Erfassen">
        <bpmn:incoming>Flow_SP_Bestaetigen_G_LiefOk</bpmn:incoming>
        <bpmn:outgoing>Flow_G_LiefOk_E_Angenommen</bpmn:outgoing>
        <bpmn:outgoing>Flow_G_LiefOk_T_Erfassen</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="T_Erfassen" name="Lieferabweichung erfassen" camunda:type="external" camunda:topic="t2-lieferabweichung-erfassen">
        <bpmn:incoming>Flow_B_LieferungAus_T_Erfassen</bpmn:incoming>
        <bpmn:incoming>Flow_G_LiefOk_T_Erfassen</bpmn:incoming>
        <bpmn:outgoing>Flow_T_Erfassen_ST_Reklamation</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="ST_Reklamation" name="Abweichung an Lieferanten melden (über Team 3)" camunda:type="external" camunda:topic="t3-gegenstelle-kontaktieren">
        <bpmn:incoming>Flow_T_Erfassen_ST_Reklamation</bpmn:incoming>
        <bpmn:outgoing>Flow_ST_Reklamation_U_Klaerung</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="U_Klaerung" name="Lieferabweichung klären" camunda:candidateGroups="pruefstelle">
        <bpmn:documentation>Anlass: Teil-, Falsch- oder Nichtlieferung. Benötigt: Bestellung, Abweichung, Antwort des Lieferanten über Team 3. Rolle: menschliche Prüfstelle. Ergebnis: Nachlieferung, Übernahme der Teilmenge (Rest bleibt offen) oder dokumentierte Übergabe. Frist: fristPruefstelle.</bpmn:documentation>
        <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Klärung erforderlich')}" event="start" /><camunda:formData><camunda:formField id="lieferabweichung" label="Abweichung" type="string"><camunda:validation><camunda:constraint name="readonly" /></camunda:validation></camunda:formField><camunda:formField id="klaerErgebnis" label="Ergebnis der Klärung" type="enum"><camunda:validation><camunda:constraint name="required" /></camunda:validation><camunda:value id="NACHLIEFERUNG" name="Lieferant liefert nach" /><camunda:value id="TEILMENGE_UEBERNEHMEN" name="Gelieferte Menge übernehmen, Rest offen" /><camunda:value id="NICHT_LOESBAR" name="Nicht lösbar: Vorgang übergeben" /></camunda:formField><camunda:formField id="gelieferteMenge" label="Übernommene Menge (Stück)" type="long"></camunda:formField><camunda:formField id="pruefNotiz" label="Antwort des Lieferanten / Begründung" type="string"><camunda:validation><camunda:constraint name="required" /></camunda:validation></camunda:formField></camunda:formData></bpmn:extensionElements>
        <bpmn:incoming>Flow_ST_Reklamation_U_Klaerung</bpmn:incoming>
        <bpmn:outgoing>Flow_U_Klaerung_G_Klaerung</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="B_FristKlaer" name="Prüffrist abgelaufen" attachedToRef="U_Klaerung">
        <bpmn:outgoing>Flow_B_FristKlaer_E_AbwOffen</bpmn:outgoing>
        <bpmn:timerEventDefinition id="ED_B_FristKlaer"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${fristPruefstelle}</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:exclusiveGateway id="G_Klaerung" name="Klärungsergebnis?" default="Flow_G_Klaerung_E_AbwOffen">
        <bpmn:incoming>Flow_U_Klaerung_G_Klaerung</bpmn:incoming>
        <bpmn:outgoing>Flow_G_Klaerung_RT_Zustellung</bpmn:outgoing>
        <bpmn:outgoing>Flow_G_Klaerung_E_Angenommen</bpmn:outgoing>
        <bpmn:outgoing>Flow_G_Klaerung_E_AbwOffen</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="E_Angenommen" name="Lieferung angenommen">
        <bpmn:documentation>Lieferung korrekt oder Teilmenge übernommen. Ob vollständig, steht in lieferErgebnis bzw. klaerErgebnis.</bpmn:documentation>
        <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('ergebnisLieferung', 'ANGENOMMEN')}" event="start" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_G_LiefOk_E_Angenommen</bpmn:incoming>
        <bpmn:incoming>Flow_G_Klaerung_E_Angenommen</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="E_NichtLieferbar2" name="Neue Auswahl nötig">
        <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('ergebnisLieferung', 'NEUE_AUSWAHL')}" event="start" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_B_NichtLieferbar2_E_NichtLieferbar2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="E_Unbestaetigt" name="Lieferung unbestätigt">
        <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('ergebnisLieferung', 'UNBESTAETIGT')}" event="start" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_B_FristLiefBest_E_Unbestaetigt</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="E_AbwOffen" name="Lieferabweichung offen">
        <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('ergebnisLieferung', 'ABWEICHUNG_OFFEN')}" event="start" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_B_FristKlaer_E_AbwOffen</bpmn:incoming>
        <bpmn:incoming>Flow_G_Klaerung_E_AbwOffen</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_L_Start_G_Zugestellt" sourceRef="L_Start" targetRef="G_Zugestellt" />
      <bpmn:sequenceFlow id="Flow_G_Zugestellt_SP_Bestaetigen" name="ja" sourceRef="G_Zugestellt" targetRef="SP_Bestaetigen"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${zustellungGemeldet}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_G_Zugestellt_RT_Zustellung" name="nein" sourceRef="G_Zugestellt" targetRef="RT_Zustellung" />
      <bpmn:sequenceFlow id="Flow_RT_Zustellung_SP_Bestaetigen" sourceRef="RT_Zustellung" targetRef="SP_Bestaetigen" />
      <bpmn:sequenceFlow id="Flow_B_Versand_E_Versand" sourceRef="B_Versand" targetRef="E_Versand" />
      <bpmn:sequenceFlow id="Flow_B_Mahnung_ST_Mahnen" sourceRef="B_Mahnung" targetRef="ST_Mahnen" />
      <bpmn:sequenceFlow id="Flow_ST_Mahnen_E_Mahnung" sourceRef="ST_Mahnen" targetRef="E_Mahnung" />
      <bpmn:sequenceFlow id="Flow_B_LieferungAus_T_Erfassen" sourceRef="B_LieferungAus" targetRef="T_Erfassen"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('lieferErgebnis', 'NICHT_GELIEFERT')}" event="take" /></bpmn:extensionElements></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_B_NichtLieferbar2_E_NichtLieferbar2" sourceRef="B_NichtLieferbar2" targetRef="E_NichtLieferbar2"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('produktVerfuegbar', false)}" event="take" /></bpmn:extensionElements></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_B_FristLiefBest_E_Unbestaetigt" sourceRef="B_FristLiefBest" targetRef="E_Unbestaetigt" />
      <bpmn:sequenceFlow id="Flow_SP_Bestaetigen_G_LiefOk" sourceRef="SP_Bestaetigen" targetRef="G_LiefOk" />
      <bpmn:sequenceFlow id="Flow_G_LiefOk_E_Angenommen" name="ja" sourceRef="G_LiefOk" targetRef="E_Angenommen"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${lieferErgebnis == 'KORREKT'}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_G_LiefOk_T_Erfassen" name="nein" sourceRef="G_LiefOk" targetRef="T_Erfassen" />
      <bpmn:sequenceFlow id="Flow_T_Erfassen_ST_Reklamation" sourceRef="T_Erfassen" targetRef="ST_Reklamation" />
      <bpmn:sequenceFlow id="Flow_ST_Reklamation_U_Klaerung" sourceRef="ST_Reklamation" targetRef="U_Klaerung" />
      <bpmn:sequenceFlow id="Flow_U_Klaerung_G_Klaerung" sourceRef="U_Klaerung" targetRef="G_Klaerung" />
      <bpmn:sequenceFlow id="Flow_B_FristKlaer_E_AbwOffen" sourceRef="B_FristKlaer" targetRef="E_AbwOffen" />
      <bpmn:sequenceFlow id="Flow_G_Klaerung_RT_Zustellung" name="Nachlieferung" sourceRef="G_Klaerung" targetRef="RT_Zustellung"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('zustellungGemeldet', false)}" event="take" /></bpmn:extensionElements><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${klaerErgebnis == 'NACHLIEFERUNG'}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_G_Klaerung_E_Angenommen" name="Teilmenge übernehmen" sourceRef="G_Klaerung" targetRef="E_Angenommen"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${klaerErgebnis == 'TEILMENGE_UEBERNEHMEN'}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_G_Klaerung_E_AbwOffen" name="nicht lösbar" sourceRef="G_Klaerung" targetRef="E_AbwOffen" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="G_Lieferung" name="Ergebnis der Lieferung?" default="Flow_G_Lieferung_E_AbwTop">
      <bpmn:incoming>Flow_SP_Lieferung_G_Lieferung</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Lieferung_T_Fortschreiben</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Lieferung_SP_Freigabe</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Lieferung_E_UnbestTop</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Lieferung_E_AbwTop</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_UnbestTop" name="Übergeben: Lieferung unbestätigt">
      <bpmn:documentation>Nachrichten-Endereignis: der gemeinsame Benachrichtigungsdienst informiert den Kunden über die Pflege-App (SIMULIERT).</bpmn:documentation>
      <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Übergeben')}" event="start" /><camunda:executionListener expression="${execution.setVariable('ergebnis', 'Kunde hat die Lieferung nicht bestätigt, Vorgang nicht automatisch erfolgreich geschlossen')}" event="start" /><camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Vorgang geschlossen')}" event="start" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Lieferung_E_UnbestTop</bpmn:incoming>
      <bpmn:messageEventDefinition id="ED_E_UnbestTop" messageRef="Msg_MV_Benachrichtigung" camunda:type="external" camunda:topic="t2-benachrichtigung-senden" />
    </bpmn:endEvent>
    <bpmn:endEvent id="E_AbwTop" name="Übergeben: Lieferabweichung offen">
      <bpmn:documentation>Nachrichten-Endereignis: der gemeinsame Benachrichtigungsdienst informiert den Kunden über die Pflege-App (SIMULIERT).</bpmn:documentation>
      <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Übergeben')}" event="start" /><camunda:executionListener expression="${execution.setVariable('ergebnis', 'Lieferabweichung nicht lösbar, an andere Stelle übergeben')}" event="start" /><camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Vorgang geschlossen')}" event="start" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Lieferung_E_AbwTop</bpmn:incoming>
      <bpmn:messageEventDefinition id="ED_E_AbwTop" messageRef="Msg_MV_Benachrichtigung" camunda:type="external" camunda:topic="t2-benachrichtigung-senden" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_Fortschreiben" name="Bestand und Verbrauch fortschreiben" camunda:type="external" camunda:topic="t2-bestand-fortschreiben">
      <bpmn:documentation>Schreibt den Bestand erst nach bestätigtem Ergebnis mit der gelieferten Menge fort und legt Reichweite und nächsten Prüfzeitpunkt fest.</bpmn:documentation>
      <bpmn:incoming>Flow_G_Lieferung_T_Fortschreiben</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Fortschreiben_ST_Beleg</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="ST_Beleg" name="Liefernachweis an Team 1 übergeben" camunda:type="external" camunda:topic="t1-nachweis-uebergeben">
      <bpmn:documentation>Übergabe an Team 1 mit pflegehaushaltId, vorgangId, Bestellung und Ergebnis. SIMULIERT.</bpmn:documentation>
      <bpmn:incoming>Flow_T_Fortschreiben_ST_Beleg</bpmn:incoming>
      <bpmn:outgoing>Flow_ST_Beleg_G_Vollst</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="G_Vollst" name="Vollständig geliefert?" default="Flow_G_Vollst_E_Rest">
      <bpmn:incoming>Flow_ST_Beleg_G_Vollst</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Vollst_E_Erfolg</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Vollst_E_Rest</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_Erfolg" name="Kunde informiert: Lieferung bestätigt">
      <bpmn:documentation>Nachrichten-Endereignis: der gemeinsame Benachrichtigungsdienst informiert den Kunden über die Pflege-App (SIMULIERT).</bpmn:documentation>
      <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Erfolgreich abgeschlossen')}" event="start" /><camunda:executionListener expression="${execution.setVariable('ergebnis', 'Lieferung bestätigt und Bestand fortgeschrieben')}" event="start" /><camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Vorgang geschlossen')}" event="start" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Vollst_E_Erfolg</bpmn:incoming>
      <bpmn:messageEventDefinition id="ED_E_Erfolg" messageRef="Msg_MV_Benachrichtigung" camunda:type="external" camunda:topic="t2-benachrichtigung-senden" />
    </bpmn:endEvent>
    <bpmn:endEvent id="E_Rest" name="Kunde informiert: Restmenge offen">
      <bpmn:documentation>Nachrichten-Endereignis: der gemeinsame Benachrichtigungsdienst informiert den Kunden über die Pflege-App (SIMULIERT).</bpmn:documentation>
      <bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Übergeben')}" event="start" /><camunda:executionListener expression="${execution.setVariable('ergebnis', 'Teilmenge übernommen und Bestand fortgeschrieben, Restmenge offen (Teamentscheidung offen)')}" event="start" /><camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Vorgang geschlossen')}" event="start" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Vollst_E_Rest</bpmn:incoming>
      <bpmn:messageEventDefinition id="ED_E_Rest" messageRef="Msg_MV_Benachrichtigung" camunda:type="external" camunda:topic="t2-benachrichtigung-senden" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_S_Pruefung_T_Anlegen" sourceRef="S_Pruefung" targetRef="T_Anlegen" />
    <bpmn:sequenceFlow id="Flow_S_Meldung_T_Anlegen" sourceRef="S_Meldung" targetRef="T_Anlegen" />
    <bpmn:sequenceFlow id="Flow_S_Schwelle_T_Anlegen" sourceRef="S_Schwelle" targetRef="T_Anlegen" />
    <bpmn:sequenceFlow id="Flow_T_Anlegen_G_Offen" sourceRef="T_Anlegen" targetRef="G_Offen" />
    <bpmn:sequenceFlow id="Flow_G_Offen_E_Doppelt" name="ja" sourceRef="G_Offen" targetRef="E_Doppelt"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${vorgangBereitsOffen}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Offen_SP_Bedarf" name="nein" sourceRef="G_Offen" targetRef="SP_Bedarf" />
    <bpmn:sequenceFlow id="Flow_SP_Bedarf_G_Bedarf" sourceRef="SP_Bedarf" targetRef="G_Bedarf" />
    <bpmn:sequenceFlow id="Flow_G_Bedarf_SP_Freigabe" name="Nachversorgung nötig" sourceRef="G_Bedarf" targetRef="SP_Freigabe"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ergebnisBedarf == 'NACHVERSORGUNG'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Bedarf_T_Termin" name="Kein Bedarf" sourceRef="G_Bedarf" targetRef="T_Termin"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('terminAnlass', 'KEIN_BEDARF')}" event="take" /><camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Erfolgreich abgeschlossen')}" event="take" /><camunda:executionListener expression="${execution.setVariable('ergebnis', 'Kein Nachversorgungsbedarf, nächste Prüfung terminiert')}" event="take" /></bpmn:extensionElements><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ergebnisBedarf == 'KEIN_BEDARF'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Bedarf_E_KeinBestand" name="Bestand nicht gemeldet" sourceRef="G_Bedarf" targetRef="E_KeinBestand" />
    <bpmn:sequenceFlow id="Flow_T_Termin_E_Termin" sourceRef="T_Termin" targetRef="E_Termin" />
    <bpmn:sequenceFlow id="Flow_SP_Freigabe_G_Freigabe" sourceRef="SP_Freigabe" targetRef="G_Freigabe" />
    <bpmn:sequenceFlow id="Flow_G_Freigabe_SP_Bestellung" name="Bestellung freigegeben" sourceRef="G_Freigabe" targetRef="SP_Bestellung"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ergebnisFreigabe == 'FREIGEGEBEN'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Freigabe_T_Termin" name="Aufgeschoben" sourceRef="G_Freigabe" targetRef="T_Termin"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('terminAnlass', 'AUFSCHUB')}" event="take" /><camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Erfolglos abgeschlossen')}" event="take" /><camunda:executionListener expression="${execution.setVariable('ergebnis', 'Kunde hat verschoben, keine Bestellung, frühere Prüfung terminiert')}" event="take" /></bpmn:extensionElements><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ergebnisFreigabe == 'AUFGESCHOBEN'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Freigabe_E_Abgelehnt" name="Abgelehnt" sourceRef="G_Freigabe" targetRef="E_Abgelehnt"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ergebnisFreigabe == 'ABGELEHNT'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Freigabe_E_KeineAntwortK" name="Keine Antwort" sourceRef="G_Freigabe" targetRef="E_KeineAntwortK"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ergebnisFreigabe == 'KEINE_ANTWORT'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Freigabe_E_Grenzfall" name="Grenzfall nicht lösbar" sourceRef="G_Freigabe" targetRef="E_Grenzfall" />
    <bpmn:sequenceFlow id="Flow_SP_Bestellung_G_Bestellung" sourceRef="SP_Bestellung" targetRef="G_Bestellung" />
    <bpmn:sequenceFlow id="Flow_G_Bestellung_SP_Lieferung" name="Bestellung bestätigt" sourceRef="G_Bestellung" targetRef="SP_Lieferung"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ergebnisBestellung == 'BESTAETIGT'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Bestellung_SP_Freigabe" name="Neue Auswahl nötig" sourceRef="G_Bestellung" targetRef="SP_Freigabe"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('anzahlNachfassen', 0)}" event="take" /></bpmn:extensionElements><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ergebnisBestellung == 'NEUE_AUSWAHL'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Bestellung_E_KeinLieferant" name="Lieferant antwortet nicht" sourceRef="G_Bestellung" targetRef="E_KeinLieferant" />
    <bpmn:sequenceFlow id="Flow_SP_Lieferung_G_Lieferung" sourceRef="SP_Lieferung" targetRef="G_Lieferung" />
    <bpmn:sequenceFlow id="Flow_G_Lieferung_T_Fortschreiben" name="Lieferung angenommen" sourceRef="G_Lieferung" targetRef="T_Fortschreiben"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ergebnisLieferung == 'ANGENOMMEN'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Lieferung_SP_Freigabe" name="Neue Auswahl nötig" sourceRef="G_Lieferung" targetRef="SP_Freigabe"><bpmn:extensionElements><camunda:executionListener expression="${execution.setVariable('anzahlNachfassen', 0)}" event="take" /><camunda:executionListener expression="${execution.setVariable('zustellungGemeldet', false)}" event="take" /></bpmn:extensionElements><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ergebnisLieferung == 'NEUE_AUSWAHL'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Lieferung_E_UnbestTop" name="Lieferung unbestätigt" sourceRef="G_Lieferung" targetRef="E_UnbestTop"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ergebnisLieferung == 'UNBESTAETIGT'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Lieferung_E_AbwTop" name="Lieferabweichung offen" sourceRef="G_Lieferung" targetRef="E_AbwTop" />
    <bpmn:sequenceFlow id="Flow_T_Fortschreiben_ST_Beleg" sourceRef="T_Fortschreiben" targetRef="ST_Beleg" />
    <bpmn:sequenceFlow id="Flow_ST_Beleg_G_Vollst" sourceRef="ST_Beleg" targetRef="G_Vollst" />
    <bpmn:sequenceFlow id="Flow_G_Vollst_E_Erfolg" name="ja" sourceRef="G_Vollst" targetRef="E_Erfolg"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${lieferErgebnis == 'KORREKT'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Vollst_E_Rest" name="nein" sourceRef="G_Vollst" targetRef="E_Rest" />
  </bpmn:process>
  <bpmn:message id="Msg_MV_Pruefung" name="MV_Bestandspruefung_faellig" />
  <bpmn:message id="Msg_MV_Meldung" name="MV_Bestandsmeldung_eingegangen" />
