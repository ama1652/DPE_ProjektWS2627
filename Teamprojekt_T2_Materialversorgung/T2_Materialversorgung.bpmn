          <dc:Bounds x="1464" y="375" width="110" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="J_Bestand_di" bpmnElement="J_Bestand" isMarkerVisible="true">
