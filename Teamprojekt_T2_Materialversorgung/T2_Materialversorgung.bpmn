<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_T2_Materialversorgung" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">

  <bpmn:collaboration id="Collaboration_T2_Materialversorgung">
    <bpmn:participant id="P_T2_Materialversorgung" name="Pflege-Backoffice: Materialversorgung (Team 2)" processRef="T2_Materialversorgung" />
    <bpmn:participant id="P_T2_App" name="Pflege-App und Prüfplaner (Auslöser, Anzeige der Benachrichtigungen)" />
    <bpmn:participant id="P_T2_Lieferant" name="Lieferant: Versorgungsdienst Beispiel (SIMULIERT)" />
    <bpmn:participant id="P_T2_Team3" name="Team 3: Kommunikation, Fristen, Nachfassen (SIMULIERT)" />
    <bpmn:participant id="P_T2_Team1" name="Team 1: Dokumente und Vorgangsübersicht (SIMULIERT)" />
    <bpmn:messageFlow id="MF_Pruefung" sourceRef="P_T2_App" targetRef="S_Pruefung" />
    <bpmn:messageFlow id="MF_Meldung" sourceRef="P_T2_App" targetRef="S_Meldung" />
    <bpmn:messageFlow id="MF_Schwelle" sourceRef="P_T2_App" targetRef="S_Schwelle" />
    <bpmn:messageFlow id="MF_ErinnBestand" sourceRef="E_ErinnBestand" targetRef="P_T2_App" />
    <bpmn:messageFlow id="MF_KeinBestand" sourceRef="E_KeinBestand" targetRef="P_T2_App" />
    <bpmn:messageFlow id="MF_KeinBedarf" sourceRef="E_KeinBedarf" targetRef="P_T2_App" />
    <bpmn:messageFlow id="MF_Abgelehnt" sourceRef="E_Abgelehnt" targetRef="P_T2_App" />
    <bpmn:messageFlow id="MF_ErinnLief" sourceRef="E_ErinnLief" targetRef="P_T2_App" />
    <bpmn:messageFlow id="MF_Erfolg" sourceRef="E_Erfolg" targetRef="P_T2_App" />
    <bpmn:messageFlow id="MF_Bestellung" name="Bestellung" sourceRef="ST_Bestellen" targetRef="P_T2_Lieferant" />
    <bpmn:messageFlow id="MF_NichtLieferbar" sourceRef="P_T2_Lieferant" targetRef="IC_NichtLieferbar" />
    <bpmn:messageFlow id="MF_Bestaetigung" sourceRef="P_T2_Lieferant" targetRef="IC_Bestaetigt" />
    <bpmn:messageFlow id="MF_Nachfassen" sourceRef="ST_Nachfassen" targetRef="P_T2_Team3" />
    <bpmn:messageFlow id="MF_Zustellung" sourceRef="P_T2_Lieferant" targetRef="RT_Zustellung" />
    <bpmn:messageFlow id="MF_Mahnen" sourceRef="ST_Mahnen" targetRef="P_T2_Team3" />
    <bpmn:messageFlow id="MF_Reklamation" sourceRef="ST_Reklamation" targetRef="P_T2_Team3" />
    <bpmn:messageFlow id="MF_Beleg" name="Liefernachweis" sourceRef="ST_Beleg" targetRef="P_T2_Team1" />
  </bpmn:collaboration>
  <bpmn:process id="T2_Materialversorgung" name="Materialversorgung (Team 2)" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Team 2 Materialversorgung, Semesterprojekt Pflege-Backoffice MVP (DPE, Prof. Stiehl, WS 2026/27). Wiederkehrende Nachversorgung ausgewählter Verbrauchsprodukte vom Auslöser bis zur bestätigten Lieferung. Prozessschicht ohne Programmlogik: Berechnungen und externe Dienste laufen als External Tasks (Topics t1-, t2-, t3-...), Konfiguration und Grenzen stehen in den DMN-Tabellen T2_Versorgungsprofil und T2_Berechtigungsregel. Lieferant, Team 1, Team 3 und Benachrichtigungen sind SIMULIERT (simulator/t2-simulator.js). Vorgangszustände nach Projekthandbuch 7.2 in vorgangsstatus, letztes gemeinsames Ereignis in letztesEreignis.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_T2_Materialversorgung">
      <bpmn:lane id="Lane_T2_Kunde" name="Pflegende Person">
        <bpmn:flowNodeRef>U_Bestand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_ErinnBestand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_FristBestand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ErinnBestand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_KeinBestand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_Kunde</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Entscheidung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Entsch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Abgelehnt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_Lieferung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_ErinnLief</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ErinnLief</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_T2_Backoffice" name="Pflege-Backoffice (Prozess)">
        <bpmn:flowNodeRef>S_Pruefung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Meldung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Schwelle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Anlegen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Profil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Bestand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_Bestand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Reichweite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Bedarf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Termin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_KeinBedarf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_Vorschlag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Vorschlag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_Pruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Abweichung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Regel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Weg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_Bestellen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_Bestellen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_Warten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EG_Antwort</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IC_NichtLieferbar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IC_Bestaetigt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT_Frist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Nachfassen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_Nachfassen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_Lieferung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RT_Zustellung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Mahnung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_LieferungAus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_Mahnen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Mahnung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_LiefOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Erfassen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_Reklamation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_Fortschreiben</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Fortschreiben</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_Beleg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Erfolg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_T2_Pruefstelle" name="Menschliche Prüfstelle">
        <bpmn:flowNodeRef>U_Grenzfall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Grenz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Grenzfall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_LiefAntwort</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_LiefAntwort</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_KeinLieferant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_Klaerung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_Klaerung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Klaerung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Klaerung</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_Pruefung" name="Bestandsprüfung fällig">
      <bpmn:documentation>Prozessbeginn 1: Der Prüfplaner meldet einen geplanten Bestandsprüfungstermin (Variable produktId). Bestand ist noch nicht bekannt.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('ausloeser', 'Geplante Bestandsprüfung')}" event="end" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_S_Pruefung_J_Start</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_S_Pruefung" messageRef="Msg_MV_Pruefung" />
    </bpmn:startEvent>
    <bpmn:startEvent id="S_Meldung" name="Bestandsmeldung eingegangen">
      <bpmn:documentation>Prozessbeginn 2: Die pflegende Person meldet den Bestand über die App (Variablen produktId, bestand).</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('ausloeser', 'Manuelle Bestandsmeldung')}" event="end" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_S_Meldung_J_Start</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_S_Meldung" messageRef="Msg_MV_Meldung" />
    </bpmn:startEvent>
    <bpmn:startEvent id="S_Schwelle" name="Schwellenwert unterschritten">
      <bpmn:documentation>Prozessbeginn 3: Die App erkennt, dass der vereinbarte Schwellenwert unterschritten ist (Variablen produktId, bestand).</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('ausloeser', 'Schwellenwert unterschritten')}" event="end" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_S_Schwelle_J_Start</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_S_Schwelle" messageRef="Msg_MV_Schwelle" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="J_Start">
      <bpmn:incoming>Flow_S_Pruefung_J_Start</bpmn:incoming>
      <bpmn:incoming>Flow_S_Meldung_J_Start</bpmn:incoming>
      <bpmn:incoming>Flow_S_Schwelle_J_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_J_Start_T_Anlegen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Anlegen" name="Vorgang eröffnen" camunda:type="external" camunda:topic="t2-vorgang-eroeffnen">
      <bpmn:documentation>Dienst der Vorgangsakte (Team 1): eröffnet den Vorgang und vergibt die Vorgangskennung. Business Key = vorgangId, darüber werden alle späteren Nachrichten korreliert. SIMULIERT im Team-2-Simulator.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setProcessBusinessKey(vorgangId)}" event="end" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_J_Start_T_Anlegen</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Anlegen_R_Profil</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="R_Profil" name="Versorgungsprofil laden" camunda:decisionRef="T2_Versorgungsprofil" camunda:resultVariable="profil" camunda:mapDecisionResult="singleResult">
      <bpmn:documentation>DMN-Tabelle T2_Versorgungsprofil: Produkt, Ersatzoption, Lieferanten, Packungsgröße, Zielbestand, Verbrauchsannahme, Preise und Fristen je Testprodukt. Konfigurierbar ohne Änderung von Prozess oder Code (Projekthandbuch 5.6). Alle Werte sind Projektannahmen.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="produkt">${profil.produkt}</camunda:outputParameter>
          <camunda:outputParameter name="ersatzprodukt">${profil.ersatzprodukt}</camunda:outputParameter>
          <camunda:outputParameter name="lieferant">${profil.lieferant}</camunda:outputParameter>
          <camunda:outputParameter name="alternativLieferant">${profil.alternativLieferant}</camunda:outputParameter>
          <camunda:outputParameter name="packungsgroesse">${profil.packungsgroesse}</camunda:outputParameter>
          <camunda:outputParameter name="zielbestand">${profil.zielbestand}</camunda:outputParameter>
          <camunda:outputParameter name="verbrauchProTag">${profil.verbrauchProTag}</camunda:outputParameter>
          <camunda:outputParameter name="lieferzeitTage">${profil.lieferzeitTage}</camunda:outputParameter>
          <camunda:outputParameter name="tageBisNaechstePruefung">${profil.tageBisNaechstePruefung}</camunda:outputParameter>
          <camunda:outputParameter name="stueckpreis">${profil.stueckpreis}</camunda:outputParameter>
          <camunda:outputParameter name="stueckpreisAlternativ">${profil.stueckpreisAlternativ}</camunda:outputParameter>
          <camunda:outputParameter name="maxBestellmenge">${profil.maxBestellmenge}</camunda:outputParameter>
          <camunda:outputParameter name="schwelleVerbrauchssprung">${profil.schwelleVerbrauchssprung}</camunda:outputParameter>
          <camunda:outputParameter name="erinnerungszyklus">${profil.erinnerungszyklus}</camunda:outputParameter>
          <camunda:outputParameter name="fristBestandsmeldung">${profil.fristBestandsmeldung}</camunda:outputParameter>
          <camunda:outputParameter name="fristKundenentscheidung">${profil.fristKundenentscheidung}</camunda:outputParameter>
          <camunda:outputParameter name="fristBestaetigungLieferant">${profil.fristBestaetigungLieferant}</camunda:outputParameter>
          <camunda:outputParameter name="maxNachfassen">${profil.maxNachfassen}</camunda:outputParameter>
          <camunda:outputParameter name="mahnzyklusLieferung">${profil.mahnzyklusLieferung}</camunda:outputParameter>
          <camunda:outputParameter name="fristLieferungEndgueltig">${profil.fristLieferungEndgueltig}</camunda:outputParameter>
          <camunda:outputParameter name="erinnerungszyklusLieferbestaetigung">${profil.erinnerungszyklusLieferbestaetigung}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_T_Anlegen_R_Profil</bpmn:incoming>
      <bpmn:outgoing>Flow_R_Profil_G_Bestand</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="G_Bestand" name="Aktueller Bestand gemeldet?" default="Flow_G_Bestand_U_Bestand">
      <bpmn:incoming>Flow_R_Profil_G_Bestand</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Bestand_J_Bestand</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Bestand_U_Bestand</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U_Bestand" name="Aktuellen Bestand melden" camunda:assignee="demo">
      <bpmn:documentation>Anlass: geplante Bestandsprüfung ohne aktuelle Meldung. Benötigt: Produktname, letzter bekannter Bestand. Rolle: pflegende Person. Ergebnis: aktueller Bestand mit Zeitpunkt. Frist: fristBestandsmeldung aus dem Versorgungsprofil, vorher Erinnerungen im Zyklus erinnerungszyklus.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Wartet auf Kunde')}" event="start" />
        <camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Unterlagen fehlen')}" event="start" />
        <camunda:formData>
          <camunda:formField id="bestand" label="Aktueller Bestand (Stück)" type="long">
            <camunda:validation><camunda:constraint name="required" /></camunda:validation>
          </camunda:formField>
          <camunda:formField id="bestandUnsicher" label="Ich bin mir bei der Menge unsicher" type="boolean" defaultValue="false" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Bestand_U_Bestand</bpmn:incoming>
      <bpmn:outgoing>Flow_U_Bestand_J_Bestand</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_ErinnBestand" name="Erinnerung fällig" attachedToRef="U_Bestand" cancelActivity="false">
      <bpmn:outgoing>Flow_B_ErinnBestand_E_ErinnBestand</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_B_ErinnBestand">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">${erinnerungszyklus}</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_FristBestand" name="Meldefrist abgelaufen" attachedToRef="U_Bestand">
      <bpmn:outgoing>Flow_B_FristBestand_E_KeinBestand</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_B_FristBestand">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${fristBestandsmeldung}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="E_ErinnBestand" name="An Bestandsmeldung erinnert">
      <bpmn:documentation>Nachrichten-Endereignis: der gemeinsame Benachrichtigungsdienst (Topic t2-benachrichtigung-senden) informiert den Kunden über die Pflege-App. SIMULIERT.</bpmn:documentation>
      <bpmn:incoming>Flow_B_ErinnBestand_E_ErinnBestand</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_E_ErinnBestand" messageRef="Msg_MV_Benachrichtigung" camunda:type="external" camunda:topic="t2-benachrichtigung-senden" />
    </bpmn:endEvent>
    <bpmn:endEvent id="E_KeinBestand" name="Abgebrochen: Bestand nicht gemeldet">
      <bpmn:documentation>Nachrichten-Endereignis: der gemeinsame Benachrichtigungsdienst (Topic t2-benachrichtigung-senden) informiert den Kunden über die Pflege-App. SIMULIERT.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Abgebrochen')}" event="start" />
        <camunda:executionListener expression="${execution.setVariable('ergebnis', 'Bestand trotz Erinnerung nicht gemeldet')}" event="start" />
        <camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Vorgang geschlossen')}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B_FristBestand_E_KeinBestand</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_E_KeinBestand" messageRef="Msg_MV_Benachrichtigung" camunda:type="external" camunda:topic="t2-benachrichtigung-senden" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="J_Bestand">
      <bpmn:incoming>Flow_G_Bestand_J_Bestand</bpmn:incoming>
      <bpmn:incoming>Flow_U_Bestand_J_Bestand</bpmn:incoming>
      <bpmn:outgoing>Flow_J_Bestand_T_Reichweite</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Reichweite" name="Verbrauch und Reichweite berechnen" camunda:type="external" camunda:topic="t2-reichweite-berechnen">
      <bpmn:documentation>Reichweite = Bestand / Verbrauch pro Tag, dazu voraussichtlicher Zeitpunkt der Unterschreitung. Keine medizinische Bewertung des Verbrauchs.</bpmn:documentation>
      <bpmn:incoming>Flow_J_Bestand_T_Reichweite</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Reichweite_G_Bedarf</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Bedarf" name="Reicht der Bestand bis Prüfung + Lieferzeit?" default="Flow_G_Bedarf_T_Termin">
      <bpmn:incoming>Flow_T_Reichweite_G_Bedarf</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Bedarf_J_Vorschlag</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Bedarf_T_Termin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Termin" name="Nächste Prüfung terminieren" camunda:type="external" camunda:topic="t2-pruefung-terminieren">
      <bpmn:incoming>Flow_G_Bedarf_T_Termin</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Termin_E_KeinBedarf</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_KeinBedarf" name="Kunde informiert: kein Bedarf">
      <bpmn:documentation>Nachrichten-Endereignis: der gemeinsame Benachrichtigungsdienst (Topic t2-benachrichtigung-senden) informiert den Kunden über die Pflege-App. SIMULIERT.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Erfolgreich abgeschlossen')}" event="start" />
        <camunda:executionListener expression="${execution.setVariable('ergebnis', 'Kein Nachversorgungsbedarf, nächste Prüfung terminiert')}" event="start" />
        <camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Vorgang geschlossen')}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_T_Termin_E_KeinBedarf</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_E_KeinBedarf" messageRef="Msg_MV_Benachrichtigung" camunda:type="external" camunda:topic="t2-benachrichtigung-senden" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="J_Vorschlag">
      <bpmn:incoming>Flow_G_Bedarf_J_Vorschlag</bpmn:incoming>
      <bpmn:incoming>Flow_G_Entsch_J_Vorschlag</bpmn:incoming>
      <bpmn:outgoing>Flow_J_Vorschlag_T_Vorschlag</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Vorschlag" name="Produkt, Menge und Lieferant vorschlagen" camunda:type="external" camunda:topic="t2-vorschlag-erstellen">
      <bpmn:documentation>Menge = Fehlmenge bis Zielbestand, aufgerundet auf ganze Packungen. Bei Änderungswunsch des Kunden gilt dessen Menge.</bpmn:documentation>
      <bpmn:incoming>Flow_J_Vorschlag_T_Vorschlag</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Vorschlag_J_Pruefen</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="J_Pruefen">
      <bpmn:incoming>Flow_T_Vorschlag_J_Pruefen</bpmn:incoming>
      <bpmn:incoming>Flow_IC_NichtLieferbar_J_Pruefen</bpmn:incoming>
      <bpmn:incoming>Flow_G_LiefAntwort_J_Pruefen</bpmn:incoming>
      <bpmn:outgoing>Flow_J_Pruefen_T_Abweichung</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Abweichung" name="Abweichungen prüfen" camunda:type="external" camunda:topic="t2-abweichungen-pruefen">
      <bpmn:documentation>Bewertet Produktwechsel, Lieferantenwechsel, Verbrauchssprung und Menge gegenüber dem Versorgungsprofil. Bei Nichtverfügbarkeit nur die hinterlegte Ersatzoption. Bereitet Handlung, Begründung, Folgen und Gültigkeit der Freigabe vor.</bpmn:documentation>
      <bpmn:incoming>Flow_J_Pruefen_T_Abweichung</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Abweichung_R_Regel</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="R_Regel" name="Berechtigung prüfen" camunda:decisionRef="T2_Berechtigungsregel" camunda:resultVariable="berechtigung" camunda:mapDecisionResult="singleResult">
      <bpmn:documentation>Gemeinsamer Dienst für alle Teams: DMN-Tabelle T2_Berechtigungsregel mit Handlungsart, Betrag, ungeklärtem Fall und Abweichung. Ergebnis AUTOMATISCH, KUNDENFREIGABE oder PRUEFSTELLE samt Begründung.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="freigabeweg">${berechtigung.freigabeweg}</camunda:outputParameter>
          <camunda:outputParameter name="regelBegruendung">${berechtigung.begruendung}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_T_Abweichung_R_Regel</bpmn:incoming>
      <bpmn:outgoing>Flow_R_Regel_G_Weg</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="G_Weg" name="Freigabeweg?" default="Flow_G_Weg_U_Grenzfall">
      <bpmn:incoming>Flow_R_Regel_G_Weg</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Weg_J_Bestellen</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Weg_J_Kunde</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Weg_U_Grenzfall</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U_Grenzfall" name="Grenzfall prüfen" camunda:assignee="demo">
      <bpmn:documentation>Anlass: weder bevorzugtes Produkt noch hinterlegte Ersatzoption lieferbar (ungeklärter Fall). Benötigt: Versorgungsprofil, Abweichungen, Lieferantenmeldung. Rolle: menschliche Prüfstelle. Ergebnis: Kundenentscheidung mit Hinweis oder dokumentierte Übergabe. Kein medizinischer Ersatz.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Klärung erforderlich')}" event="start" />
        <camunda:formData>
          <camunda:formField id="pruefErgebnis" label="Ergebnis der Prüfung" type="enum">
            <camunda:value id="KUNDENENTSCHEIDUNG" name="Kunden mit Hinweis entscheiden lassen" />
            <camunda:value id="UEBERGEBEN" name="Nicht lösbar: Vorgang übergeben" />
            <camunda:validation><camunda:constraint name="required" /></camunda:validation>
          </camunda:formField>
          <camunda:formField id="pruefNotiz" label="Begründung" type="string">
            <camunda:validation><camunda:constraint name="required" /></camunda:validation>
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Weg_U_Grenzfall</bpmn:incoming>
      <bpmn:outgoing>Flow_U_Grenzfall_G_Grenz</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Grenz" name="Prüfergebnis?" default="Flow_G_Grenz_E_Grenzfall">
      <bpmn:incoming>Flow_U_Grenzfall_G_Grenz</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Grenz_J_Kunde</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Grenz_E_Grenzfall</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_Grenzfall" name="Übergeben: Grenzfall nicht lösbar">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Übergeben')}" event="start" />
        <camunda:executionListener expression="${execution.setVariable('ergebnis', 'Grenzfall von Prüfstelle übergeben')}" event="start" />
        <camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Vorgang geschlossen')}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Grenz_E_Grenzfall</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="J_Kunde">
      <bpmn:incoming>Flow_G_Weg_J_Kunde</bpmn:incoming>
      <bpmn:incoming>Flow_G_Grenz_J_Kunde</bpmn:incoming>
      <bpmn:outgoing>Flow_J_Kunde_C_Entscheidung</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="C_Entscheidung" name="Kundenentscheidung einholen" calledElement="T2_Kundenentscheidung_einholen">
      <bpmn:documentation>Gemeinsame Funktion von Team 2 (auch für Team 1 und 3): Freigabeanforderung mit Handlung, Begründung, Folgen und Gültigkeit. Call by Value: nur die genannten Variablen gehen hinein und heraus.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Wartet auf Kunde')}" event="start" />
        <camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Kundenentscheidung angefordert')}" event="start" />
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in source="pflegehaushaltId" target="pflegehaushaltId" />
        <camunda:in source="vorgangId" target="vorgangId" />
        <camunda:in source="freigabeHandlung" target="freigabeHandlung" />
        <camunda:in sourceExpression="${freigabeBegruendung.concat(' Regel: ').concat(regelBegruendung)}" target="freigabeBegruendung" />
        <camunda:in source="freigabeFolgen" target="freigabeFolgen" />
        <camunda:in source="freigabeGueltigBis" target="freigabeGueltigBis" />
        <camunda:in source="fristKundenentscheidung" target="fristKundenentscheidung" />
        <camunda:in source="erinnerungszyklus" target="erinnerungszyklus" />
        <camunda:out source="entscheidung" target="entscheidung" />
        <camunda:out source="entscheidungKommentar" target="entscheidungKommentar" />
        <camunda:out source="gewuenschteMenge" target="gewuenschteMenge" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_J_Kunde_C_Entscheidung</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Entscheidung_G_Entsch</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="G_Entsch" name="Entscheidung des Kunden?" default="Flow_G_Entsch_E_Abgelehnt">
      <bpmn:incoming>Flow_C_Entscheidung_G_Entsch</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Entsch_J_Bestellen</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Entsch_J_Vorschlag</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Entsch_E_Abgelehnt</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_Abgelehnt" name="Kunde informiert: keine Bestellung">
      <bpmn:documentation>Nachrichten-Endereignis: der gemeinsame Benachrichtigungsdienst (Topic t2-benachrichtigung-senden) informiert den Kunden über die Pflege-App. SIMULIERT.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Erfolglos abgeschlossen')}" event="start" />
        <camunda:executionListener expression="${execution.setVariable('ergebnis', 'Kunde hat abgelehnt, verschoben oder nicht geantwortet; keine Bestellung, Reichweitenrisiko mitgeteilt')}" event="start" />
        <camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Vorgang geschlossen')}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Entsch_E_Abgelehnt</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_E_Abgelehnt" messageRef="Msg_MV_Benachrichtigung" camunda:type="external" camunda:topic="t2-benachrichtigung-senden" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="J_Bestellen">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Freigegeben')}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Weg_J_Bestellen</bpmn:incoming>
      <bpmn:incoming>Flow_G_Entsch_J_Bestellen</bpmn:incoming>
      <bpmn:outgoing>Flow_J_Bestellen_ST_Bestellen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="ST_Bestellen" name="Bestellung simuliert übermitteln" camunda:type="external" camunda:topic="t2-bestellung-uebermitteln">
      <bpmn:documentation>Überträgt Lieferant, Produkt, Menge, Preis und Freigabe an den Lieferdienst. SIMULIERT: keine echte Bestellung.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'In Ausführung')}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_J_Bestellen_ST_Bestellen</bpmn:incoming>
      <bpmn:outgoing>Flow_ST_Bestellen_J_Warten</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="J_Warten">
      <bpmn:incoming>Flow_ST_Bestellen_J_Warten</bpmn:incoming>
      <bpmn:incoming>Flow_ST_Nachfassen_J_Warten</bpmn:incoming>
      <bpmn:outgoing>Flow_J_Warten_EG_Antwort</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="EG_Antwort" name="Antwort des Lieferanten?">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Wartet auf Gegenstelle')}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_J_Warten_EG_Antwort</bpmn:incoming>
      <bpmn:outgoing>Flow_EG_Antwort_IC_NichtLieferbar</bpmn:outgoing>
      <bpmn:outgoing>Flow_EG_Antwort_IC_Bestaetigt</bpmn:outgoing>
      <bpmn:outgoing>Flow_EG_Antwort_IT_Frist</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="IC_NichtLieferbar" name="Nicht lieferbar gemeldet">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Antwort eingegangen (nicht lieferbar)')}" event="end" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_EG_Antwort_IC_NichtLieferbar</bpmn:incoming>
      <bpmn:outgoing>Flow_IC_NichtLieferbar_J_Pruefen</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_IC_NichtLieferbar" messageRef="Msg_MV_NichtLieferbar" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="IC_Bestaetigt" name="Bestellung bestätigt">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Antwort eingegangen')}" event="end" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_EG_Antwort_IC_Bestaetigt</bpmn:incoming>
      <bpmn:outgoing>Flow_IC_Bestaetigt_J_Lieferung</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_IC_Bestaetigt" messageRef="Msg_MV_Bestaetigung" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="IT_Frist" name="Bestätigungsfrist abgelaufen">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Frist abgelaufen')}" event="end" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_EG_Antwort_IT_Frist</bpmn:incoming>
      <bpmn:outgoing>Flow_IT_Frist_G_Nachfassen</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_IT_Frist">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${fristBestaetigungLieferant}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="G_Nachfassen" name="Nachfassen noch möglich?" default="Flow_G_Nachfassen_U_LiefAntwort">
      <bpmn:incoming>Flow_IT_Frist_G_Nachfassen</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Nachfassen_ST_Nachfassen</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Nachfassen_U_LiefAntwort</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="ST_Nachfassen" name="Beim Lieferanten nachfassen (über Team 3)" camunda:type="external" camunda:topic="t3-nachfassen">
      <bpmn:documentation>Kommunikationsauftrag an den Baustein von Team 3 (Gegenstelle, Nachricht, Antwortfrist, Nachfassregel). SIMULIERT, solange Team 3 ihn nicht bereitstellt.</bpmn:documentation>
      <bpmn:incoming>Flow_G_Nachfassen_ST_Nachfassen</bpmn:incoming>
      <bpmn:outgoing>Flow_ST_Nachfassen_J_Warten</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="U_LiefAntwort" name="Ausbleibende Lieferantenantwort klären" camunda:assignee="demo">
      <bpmn:documentation>Anlass: Lieferant hat trotz maxNachfassen Erinnerungen nicht bestätigt. Benötigt: Bestellung, Nachfassverlauf, zugelassener Alternativlieferant. Rolle: menschliche Prüfstelle. Ergebnis: Alternativlieferant (wird erneut geprüft) oder dokumentiertes Ende.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Klärung erforderlich')}" event="start" />
        <camunda:formData>
          <camunda:formField id="lieferantErgebnis" label="Wie geht es weiter?" type="enum">
            <camunda:value id="ALTERNATIVLIEFERANT" name="Zugelassenen Alternativlieferanten vorlegen" />
            <camunda:value id="BEENDEN" name="Vorgang mit Grund beenden" />
            <camunda:validation><camunda:constraint name="required" /></camunda:validation>
          </camunda:formField>
          <camunda:formField id="pruefNotiz" label="Begründung" type="string">
            <camunda:validation><camunda:constraint name="required" /></camunda:validation>
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Nachfassen_U_LiefAntwort</bpmn:incoming>
      <bpmn:outgoing>Flow_U_LiefAntwort_G_LiefAntwort</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_LiefAntwort" name="Ergebnis?" default="Flow_G_LiefAntwort_E_KeinLieferant">
      <bpmn:incoming>Flow_U_LiefAntwort_G_LiefAntwort</bpmn:incoming>
      <bpmn:outgoing>Flow_G_LiefAntwort_J_Pruefen</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_LiefAntwort_E_KeinLieferant</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_KeinLieferant" name="Erfolglos: Lieferant antwortet nicht">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Erfolglos abgeschlossen')}" event="start" />
        <camunda:executionListener expression="${execution.setVariable('ergebnis', 'Lieferant hat nicht bestätigt, Vorgang beendet')}" event="start" />
        <camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Vorgang geschlossen')}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_LiefAntwort_E_KeinLieferant</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="J_Lieferung">
      <bpmn:incoming>Flow_IC_Bestaetigt_J_Lieferung</bpmn:incoming>
      <bpmn:incoming>Flow_G_Klaerung_J_Lieferung</bpmn:incoming>
      <bpmn:outgoing>Flow_J_Lieferung_RT_Zustellung</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="RT_Zustellung" name="Auf Zustellmeldung warten" messageRef="Msg_MV_Zustellung">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Wartet auf Gegenstelle')}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_J_Lieferung_RT_Zustellung</bpmn:incoming>
      <bpmn:outgoing>Flow_RT_Zustellung_U_Lieferung</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="B_Mahnung" name="Lieferfrist überschritten" attachedToRef="RT_Zustellung" cancelActivity="false">
      <bpmn:outgoing>Flow_B_Mahnung_ST_Mahnen</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_B_Mahnung">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">${mahnzyklusLieferung}</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_LieferungAus" name="Lieferung endgültig ausgeblieben" attachedToRef="RT_Zustellung">
      <bpmn:outgoing>Flow_B_LieferungAus_J_Klaerung</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_B_LieferungAus">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${fristLieferungEndgueltig}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="ST_Mahnen" name="Lieferung anmahnen (über Team 3)" camunda:type="external" camunda:topic="t3-nachfassen">
      <bpmn:incoming>Flow_B_Mahnung_ST_Mahnen</bpmn:incoming>
      <bpmn:outgoing>Flow_ST_Mahnen_E_Mahnung</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_Mahnung" name="Mahnung versandt">
      <bpmn:incoming>Flow_ST_Mahnen_E_Mahnung</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="U_Lieferung" name="Lieferung prüfen und bestätigen" camunda:assignee="demo">
      <bpmn:documentation>Anlass: Lieferant meldet Zustellung. Benötigt: Bestellinhalt, erwartete Menge. Rolle: pflegende Person. Ergebnis: korrekt, teilweise, falsch oder nicht geliefert. Ohne Bestätigung wird der Vorgang NICHT automatisch erfolgreich geschlossen; es folgen Erinnerungen.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Wartet auf Kunde')}" event="start" />
        <camunda:formData>
          <camunda:formField id="lieferErgebnis" label="Wie ist die Lieferung angekommen?" type="enum">
            <camunda:value id="KORREKT" name="Richtig und vollständig geliefert" />
            <camunda:value id="TEILLIEFERUNG" name="Nur teilweise geliefert" />
            <camunda:value id="FALSCHLIEFERUNG" name="Falsches Produkt geliefert" />
            <camunda:value id="NICHT_GELIEFERT" name="Nicht angekommen" />
            <camunda:validation><camunda:constraint name="required" /></camunda:validation>
          </camunda:formField>
          <camunda:formField id="gelieferteMenge" label="Tatsächlich gelieferte brauchbare Menge (Stück)" type="long" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RT_Zustellung_U_Lieferung</bpmn:incoming>
      <bpmn:outgoing>Flow_U_Lieferung_G_LiefOk</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_ErinnLief" name="Erinnerung fällig" attachedToRef="U_Lieferung" cancelActivity="false">
      <bpmn:outgoing>Flow_B_ErinnLief_E_ErinnLief</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_B_ErinnLief">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">${erinnerungszyklusLieferbestaetigung}</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="E_ErinnLief" name="An Lieferbestätigung erinnert">
      <bpmn:documentation>Nachrichten-Endereignis: der gemeinsame Benachrichtigungsdienst (Topic t2-benachrichtigung-senden) informiert den Kunden über die Pflege-App. SIMULIERT.</bpmn:documentation>
      <bpmn:incoming>Flow_B_ErinnLief_E_ErinnLief</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_E_ErinnLief" messageRef="Msg_MV_Benachrichtigung" camunda:type="external" camunda:topic="t2-benachrichtigung-senden" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_LiefOk" name="Lieferung korrekt?" default="Flow_G_LiefOk_T_Erfassen">
      <bpmn:incoming>Flow_U_Lieferung_G_LiefOk</bpmn:incoming>
      <bpmn:outgoing>Flow_G_LiefOk_J_Fortschreiben</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_LiefOk_T_Erfassen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Erfassen" name="Lieferabweichung erfassen" camunda:type="external" camunda:topic="t2-lieferabweichung-erfassen">
      <bpmn:incoming>Flow_G_LiefOk_T_Erfassen</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Erfassen_ST_Reklamation</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="ST_Reklamation" name="Abweichung an Lieferanten melden (über Team 3)" camunda:type="external" camunda:topic="t3-gegenstelle-kontaktieren">
      <bpmn:incoming>Flow_T_Erfassen_ST_Reklamation</bpmn:incoming>
      <bpmn:outgoing>Flow_ST_Reklamation_J_Klaerung</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="J_Klaerung">
      <bpmn:incoming>Flow_B_LieferungAus_J_Klaerung</bpmn:incoming>
      <bpmn:incoming>Flow_ST_Reklamation_J_Klaerung</bpmn:incoming>
      <bpmn:outgoing>Flow_J_Klaerung_U_Klaerung</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U_Klaerung" name="Lieferabweichung klären" camunda:assignee="demo">
      <bpmn:documentation>Anlass: Teil-, Falsch- oder Nichtlieferung bzw. Lieferung endgültig ausgeblieben. Benötigt: Bestellung, Lieferabweichung, Antwort des Lieferanten (über Team 3). Rolle: menschliche Prüfstelle. Ergebnis: Nachlieferung, Übernahme der Teilmenge oder dokumentierte Übergabe.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Klärung erforderlich')}" event="start" />
        <camunda:formData>
          <camunda:formField id="klaerErgebnis" label="Ergebnis der Klärung" type="enum">
            <camunda:value id="NACHLIEFERUNG" name="Lieferant liefert nach" />
            <camunda:value id="TEILMENGE_UEBERNEHMEN" name="Gelieferte Menge übernehmen" />
            <camunda:value id="NICHT_LOESBAR" name="Nicht lösbar: Vorgang übergeben" />
            <camunda:validation><camunda:constraint name="required" /></camunda:validation>
          </camunda:formField>
          <camunda:formField id="gelieferteMenge" label="Übernommene Menge (Stück)" type="long" />
          <camunda:formField id="pruefNotiz" label="Antwort des Lieferanten / Begründung" type="string">
            <camunda:validation><camunda:constraint name="required" /></camunda:validation>
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_J_Klaerung_U_Klaerung</bpmn:incoming>
      <bpmn:outgoing>Flow_U_Klaerung_G_Klaerung</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Klaerung" name="Klärungsergebnis?" default="Flow_G_Klaerung_E_Klaerung">
      <bpmn:incoming>Flow_U_Klaerung_G_Klaerung</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Klaerung_J_Fortschreiben</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Klaerung_J_Lieferung</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Klaerung_E_Klaerung</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_Klaerung" name="Übergeben: Lieferabweichung offen">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Übergeben')}" event="start" />
        <camunda:executionListener expression="${execution.setVariable('ergebnis', 'Lieferabweichung nicht lösbar, an andere Stelle übergeben')}" event="start" />
        <camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Vorgang geschlossen')}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_G_Klaerung_E_Klaerung</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="J_Fortschreiben">
      <bpmn:incoming>Flow_G_LiefOk_J_Fortschreiben</bpmn:incoming>
      <bpmn:incoming>Flow_G_Klaerung_J_Fortschreiben</bpmn:incoming>
      <bpmn:outgoing>Flow_J_Fortschreiben_T_Fortschreiben</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Fortschreiben" name="Bestand und Verbrauch fortschreiben" camunda:type="external" camunda:topic="t2-bestand-fortschreiben">
      <bpmn:documentation>Schreibt den Bestand erst nach bestätigtem Ergebnis mit der gelieferten Menge fort und legt Reichweite und nächsten Prüfzeitpunkt neu fest.</bpmn:documentation>
      <bpmn:incoming>Flow_J_Fortschreiben_T_Fortschreiben</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Fortschreiben_ST_Beleg</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="ST_Beleg" name="Liefernachweis an Team 1 übergeben" camunda:type="external" camunda:topic="t1-nachweis-uebergeben">
      <bpmn:documentation>Übergabe an Team 1 mit pflegehaushaltId, vorgangId, Bestellung und Ergebnis (gemeinsamer Ereignisrahmen). SIMULIERT.</bpmn:documentation>
      <bpmn:incoming>Flow_T_Fortschreiben_ST_Beleg</bpmn:incoming>
      <bpmn:outgoing>Flow_ST_Beleg_E_Erfolg</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_Erfolg" name="Kunde informiert: Lieferung bestätigt">
      <bpmn:documentation>Nachrichten-Endereignis: der gemeinsame Benachrichtigungsdienst (Topic t2-benachrichtigung-senden) informiert den Kunden über die Pflege-App. SIMULIERT.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('vorgangsstatus', 'Erfolgreich abgeschlossen')}" event="start" />
        <camunda:executionListener expression="${execution.setVariable('ergebnis', 'Lieferung bestätigt und Bestand fortgeschrieben')}" event="start" />
        <camunda:executionListener expression="${execution.setVariable('letztesEreignis', 'Vorgang geschlossen')}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ST_Beleg_E_Erfolg</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_E_Erfolg" messageRef="Msg_MV_Benachrichtigung" camunda:type="external" camunda:topic="t2-benachrichtigung-senden" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_S_Pruefung_J_Start" sourceRef="S_Pruefung" targetRef="J_Start" />
    <bpmn:sequenceFlow id="Flow_S_Meldung_J_Start" sourceRef="S_Meldung" targetRef="J_Start" />
    <bpmn:sequenceFlow id="Flow_S_Schwelle_J_Start" sourceRef="S_Schwelle" targetRef="J_Start" />
    <bpmn:sequenceFlow id="Flow_J_Start_T_Anlegen" sourceRef="J_Start" targetRef="T_Anlegen" />
    <bpmn:sequenceFlow id="Flow_T_Anlegen_R_Profil" sourceRef="T_Anlegen" targetRef="R_Profil" />
    <bpmn:sequenceFlow id="Flow_R_Profil_G_Bestand" sourceRef="R_Profil" targetRef="G_Bestand" />
    <bpmn:sequenceFlow id="Flow_G_Bestand_J_Bestand" name="ja" sourceRef="G_Bestand" targetRef="J_Bestand">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bestandBekannt}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Bestand_U_Bestand" name="nein" sourceRef="G_Bestand" targetRef="U_Bestand" />
    <bpmn:sequenceFlow id="Flow_U_Bestand_J_Bestand" sourceRef="U_Bestand" targetRef="J_Bestand" />
    <bpmn:sequenceFlow id="Flow_B_ErinnBestand_E_ErinnBestand" sourceRef="B_ErinnBestand" targetRef="E_ErinnBestand" />
    <bpmn:sequenceFlow id="Flow_B_FristBestand_E_KeinBestand" sourceRef="B_FristBestand" targetRef="E_KeinBestand" />
    <bpmn:sequenceFlow id="Flow_J_Bestand_T_Reichweite" sourceRef="J_Bestand" targetRef="T_Reichweite" />
    <bpmn:sequenceFlow id="Flow_T_Reichweite_G_Bedarf" sourceRef="T_Reichweite" targetRef="G_Bedarf" />
    <bpmn:sequenceFlow id="Flow_G_Bedarf_J_Vorschlag" name="nein" sourceRef="G_Bedarf" targetRef="J_Vorschlag">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${nachversorgungNoetig}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Bedarf_T_Termin" name="ja" sourceRef="G_Bedarf" targetRef="T_Termin" />
    <bpmn:sequenceFlow id="Flow_T_Termin_E_KeinBedarf" sourceRef="T_Termin" targetRef="E_KeinBedarf" />
    <bpmn:sequenceFlow id="Flow_J_Vorschlag_T_Vorschlag" sourceRef="J_Vorschlag" targetRef="T_Vorschlag" />
    <bpmn:sequenceFlow id="Flow_T_Vorschlag_J_Pruefen" sourceRef="T_Vorschlag" targetRef="J_Pruefen" />
    <bpmn:sequenceFlow id="Flow_J_Pruefen_T_Abweichung" sourceRef="J_Pruefen" targetRef="T_Abweichung" />
    <bpmn:sequenceFlow id="Flow_T_Abweichung_R_Regel" sourceRef="T_Abweichung" targetRef="R_Regel" />
    <bpmn:sequenceFlow id="Flow_R_Regel_G_Weg" sourceRef="R_Regel" targetRef="G_Weg" />
    <bpmn:sequenceFlow id="Flow_G_Weg_J_Bestellen" name="automatisch" sourceRef="G_Weg" targetRef="J_Bestellen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${freigabeweg == 'AUTOMATISCH'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Weg_J_Kunde" name="Kundenfreigabe" sourceRef="G_Weg" targetRef="J_Kunde">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${freigabeweg == 'KUNDENFREIGABE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Weg_U_Grenzfall" name="Prüfstelle" sourceRef="G_Weg" targetRef="U_Grenzfall" />
    <bpmn:sequenceFlow id="Flow_U_Grenzfall_G_Grenz" sourceRef="U_Grenzfall" targetRef="G_Grenz" />
    <bpmn:sequenceFlow id="Flow_G_Grenz_J_Kunde" name="Kunde entscheidet" sourceRef="G_Grenz" targetRef="J_Kunde">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${pruefErgebnis == 'KUNDENENTSCHEIDUNG'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Grenz_E_Grenzfall" name="nicht lösbar" sourceRef="G_Grenz" targetRef="E_Grenzfall" />
    <bpmn:sequenceFlow id="Flow_J_Kunde_C_Entscheidung" sourceRef="J_Kunde" targetRef="C_Entscheidung" />
    <bpmn:sequenceFlow id="Flow_C_Entscheidung_G_Entsch" sourceRef="C_Entscheidung" targetRef="G_Entsch" />
    <bpmn:sequenceFlow id="Flow_G_Entsch_J_Bestellen" name="freigegeben" sourceRef="G_Entsch" targetRef="J_Bestellen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${entscheidung == 'FREIGEGEBEN'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Entsch_J_Vorschlag" name="Änderung gewünscht" sourceRef="G_Entsch" targetRef="J_Vorschlag">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${entscheidung == 'AENDERUNG'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Entsch_E_Abgelehnt" name="abgelehnt, Aufschub, keine Antwort" sourceRef="G_Entsch" targetRef="E_Abgelehnt" />
    <bpmn:sequenceFlow id="Flow_J_Bestellen_ST_Bestellen" sourceRef="J_Bestellen" targetRef="ST_Bestellen" />
    <bpmn:sequenceFlow id="Flow_ST_Bestellen_J_Warten" sourceRef="ST_Bestellen" targetRef="J_Warten" />
    <bpmn:sequenceFlow id="Flow_J_Warten_EG_Antwort" sourceRef="J_Warten" targetRef="EG_Antwort" />
    <bpmn:sequenceFlow id="Flow_EG_Antwort_IC_NichtLieferbar" sourceRef="EG_Antwort" targetRef="IC_NichtLieferbar" />
    <bpmn:sequenceFlow id="Flow_EG_Antwort_IC_Bestaetigt" sourceRef="EG_Antwort" targetRef="IC_Bestaetigt" />
    <bpmn:sequenceFlow id="Flow_EG_Antwort_IT_Frist" sourceRef="EG_Antwort" targetRef="IT_Frist" />
    <bpmn:sequenceFlow id="Flow_IC_NichtLieferbar_J_Pruefen" sourceRef="IC_NichtLieferbar" targetRef="J_Pruefen">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('produktVerfuegbar', false)}" event="take" />
        <camunda:executionListener expression="${execution.setVariable('anzahlNachfassen', 0)}" event="take" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_IT_Frist_G_Nachfassen" sourceRef="IT_Frist" targetRef="G_Nachfassen" />
    <bpmn:sequenceFlow id="Flow_G_Nachfassen_ST_Nachfassen" name="ja" sourceRef="G_Nachfassen" targetRef="ST_Nachfassen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${anzahlNachfassen &lt; maxNachfassen}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Nachfassen_U_LiefAntwort" name="nein" sourceRef="G_Nachfassen" targetRef="U_LiefAntwort" />
    <bpmn:sequenceFlow id="Flow_ST_Nachfassen_J_Warten" sourceRef="ST_Nachfassen" targetRef="J_Warten" />
    <bpmn:sequenceFlow id="Flow_U_LiefAntwort_G_LiefAntwort" sourceRef="U_LiefAntwort" targetRef="G_LiefAntwort" />
    <bpmn:sequenceFlow id="Flow_G_LiefAntwort_J_Pruefen" name="Alternativlieferant" sourceRef="G_LiefAntwort" targetRef="J_Pruefen">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('aktuellerLieferant', alternativLieferant)}" event="take" />
        <camunda:executionListener expression="${execution.setVariable('anzahlNachfassen', 0)}" event="take" />
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${lieferantErgebnis == 'ALTERNATIVLIEFERANT'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_LiefAntwort_E_KeinLieferant" name="beenden" sourceRef="G_LiefAntwort" targetRef="E_KeinLieferant" />
    <bpmn:sequenceFlow id="Flow_IC_Bestaetigt_J_Lieferung" sourceRef="IC_Bestaetigt" targetRef="J_Lieferung" />
    <bpmn:sequenceFlow id="Flow_J_Lieferung_RT_Zustellung" sourceRef="J_Lieferung" targetRef="RT_Zustellung" />
    <bpmn:sequenceFlow id="Flow_B_Mahnung_ST_Mahnen" sourceRef="B_Mahnung" targetRef="ST_Mahnen" />
    <bpmn:sequenceFlow id="Flow_ST_Mahnen_E_Mahnung" sourceRef="ST_Mahnen" targetRef="E_Mahnung" />
    <bpmn:sequenceFlow id="Flow_B_LieferungAus_J_Klaerung" sourceRef="B_LieferungAus" targetRef="J_Klaerung">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('lieferErgebnis', 'NICHT_GELIEFERT')}" event="take" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RT_Zustellung_U_Lieferung" sourceRef="RT_Zustellung" targetRef="U_Lieferung" />
    <bpmn:sequenceFlow id="Flow_B_ErinnLief_E_ErinnLief" sourceRef="B_ErinnLief" targetRef="E_ErinnLief" />
    <bpmn:sequenceFlow id="Flow_U_Lieferung_G_LiefOk" sourceRef="U_Lieferung" targetRef="G_LiefOk" />
    <bpmn:sequenceFlow id="Flow_G_LiefOk_J_Fortschreiben" name="ja" sourceRef="G_LiefOk" targetRef="J_Fortschreiben">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${lieferErgebnis == 'KORREKT'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_LiefOk_T_Erfassen" name="nein" sourceRef="G_LiefOk" targetRef="T_Erfassen" />
    <bpmn:sequenceFlow id="Flow_T_Erfassen_ST_Reklamation" sourceRef="T_Erfassen" targetRef="ST_Reklamation" />
    <bpmn:sequenceFlow id="Flow_ST_Reklamation_J_Klaerung" sourceRef="ST_Reklamation" targetRef="J_Klaerung" />
    <bpmn:sequenceFlow id="Flow_J_Klaerung_U_Klaerung" sourceRef="J_Klaerung" targetRef="U_Klaerung" />
    <bpmn:sequenceFlow id="Flow_U_Klaerung_G_Klaerung" sourceRef="U_Klaerung" targetRef="G_Klaerung" />
    <bpmn:sequenceFlow id="Flow_G_Klaerung_J_Fortschreiben" name="Teilmenge übernehmen" sourceRef="G_Klaerung" targetRef="J_Fortschreiben">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${klaerErgebnis == 'TEILMENGE_UEBERNEHMEN'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Klaerung_J_Lieferung" name="Nachlieferung" sourceRef="G_Klaerung" targetRef="J_Lieferung">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${klaerErgebnis == 'NACHLIEFERUNG'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G_Klaerung_E_Klaerung" name="nicht lösbar" sourceRef="G_Klaerung" targetRef="E_Klaerung" />
    <bpmn:sequenceFlow id="Flow_J_Fortschreiben_T_Fortschreiben" sourceRef="J_Fortschreiben" targetRef="T_Fortschreiben" />
    <bpmn:sequenceFlow id="Flow_T_Fortschreiben_ST_Beleg" sourceRef="T_Fortschreiben" targetRef="ST_Beleg" />
    <bpmn:sequenceFlow id="Flow_ST_Beleg_E_Erfolg" sourceRef="ST_Beleg" targetRef="E_Erfolg" />
  </bpmn:process>
  <bpmn:message id="Msg_MV_Pruefung" name="MV_Bestandspruefung_faellig" />
  <bpmn:message id="Msg_MV_Meldung" name="MV_Bestandsmeldung_eingegangen" />
