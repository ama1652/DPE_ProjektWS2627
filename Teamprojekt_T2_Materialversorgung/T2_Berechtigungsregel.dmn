<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_T2_Berechtigungsregel" name="Berechtigungsprüfung (gemeinsam)" namespace="http://camunda.org/schema/1.0/dmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <decision id="T2_Berechtigungsregel" name="Berechtigung prüfen" camunda:historyTimeToLive="180">
    <description>Gemeinsamer Dienst von Team 2 für Team 1, 2 und 3: Darf eine Handlung automatisch ausgeführt werden, braucht sie eine Kundenfreigabe oder eine menschliche Prüfung? Hit Policy FIRST: die erste passende Zeile gewinnt. Alle Grenzen sind Projektannahmen (Quelle: Teamaufträge, Abschnitt Abweichungen) und noch nicht im Integrationskreis bestätigt.</description>
    <decisionTable id="DecisionTable_T2_Berechtigungsregel" hitPolicy="FIRST">
      <input id="Input_1" label="Handlungsart">
        <inputExpression id="InputExpression_1" typeRef="string">
          <text>handlungsart</text>
        </inputExpression>
      </input>
      <input id="Input_2" label="Betrag (EUR)">
        <inputExpression id="InputExpression_2" typeRef="double">
          <text>betrag</text>
        </inputExpression>
      </input>
      <input id="Input_3" label="Fall ungeklärt?">
        <inputExpression id="InputExpression_3" typeRef="boolean">
          <text>fallUngeklaert</text>
        </inputExpression>
      </input>
      <input id="Input_4" label="Abweichung mit Folgen für den Kunden?">
        <inputExpression id="InputExpression_4" typeRef="boolean">
          <text>abweichungMitFolgen</text>
        </inputExpression>
      </input>
      <output id="Output_1" label="Freigabeweg" name="freigabeweg" typeRef="string" />
      <output id="Output_2" label="Begründung" name="begruendung" typeRef="string" />
      <rule id="Rule_1">
        <description>Unklare Fälle gehen an die Prüfstelle</description>
        <inputEntry id="UnaryTests_1_1"><text></text></inputEntry>
        <inputEntry id="UnaryTests_1_2"><text></text></inputEntry>
        <inputEntry id="UnaryTests_1_3"><text>true</text></inputEntry>
        <inputEntry id="UnaryTests_1_4"><text></text></inputEntry>
        <outputEntry id="LiteralExpression_1_1"><text>"PRUEFSTELLE"</text></outputEntry>
        <outputEntry id="LiteralExpression_1_2"><text>"Fall nicht eindeutig geklärt: keine eigene Regel erfinden, die Prüfstelle entscheidet."</text></outputEntry>
      </rule>
      <rule id="Rule_2">
        <description>Keine stille Abweichung</description>
        <inputEntry id="UnaryTests_2_1"><text></text></inputEntry>
        <inputEntry id="UnaryTests_2_2"><text></text></inputEntry>
        <inputEntry id="UnaryTests_2_3"><text></text></inputEntry>
        <inputEntry id="UnaryTests_2_4"><text>true</text></inputEntry>
        <outputEntry id="LiteralExpression_2_1"><text>"KUNDENFREIGABE"</text></outputEntry>
        <outputEntry id="LiteralExpression_2_2"><text>"Abweichung vom hinterlegten Profil mit Folgen für den Kunden."</text></outputEntry>
      </rule>
      <rule id="Rule_3">
        <description>Projektannahme: Grenze 40 EUR</description>
        <inputEntry id="UnaryTests_3_1"><text>"BESTELLUNG"</text></inputEntry>
        <inputEntry id="UnaryTests_3_2"><text>&lt;= 40</text></inputEntry>
        <inputEntry id="UnaryTests_3_3"><text></text></inputEntry>
        <inputEntry id="UnaryTests_3_4"><text></text></inputEntry>
        <outputEntry id="LiteralExpression_3_1"><text>"AUTOMATISCH"</text></outputEntry>
        <outputEntry id="LiteralExpression_3_2"><text>"Bestellung innerhalb der Grenze für automatische Bestellungen (40 EUR)."</text></outputEntry>
      </rule>
      <rule id="Rule_4">
        <description>Mehrkosten nur mit Freigabe</description>
        <inputEntry id="UnaryTests_4_1"><text>"BESTELLUNG"</text></inputEntry>
        <inputEntry id="UnaryTests_4_2"><text>&gt; 40</text></inputEntry>
        <inputEntry id="UnaryTests_4_3"><text></text></inputEntry>
        <inputEntry id="UnaryTests_4_4"><text></text></inputEntry>
        <outputEntry id="LiteralExpression_4_1"><text>"KUNDENFREIGABE"</text></outputEntry>
        <outputEntry id="LiteralExpression_4_2"><text>"Betrag über der Grenze für automatische Bestellungen (40 EUR)."</text></outputEntry>
      </rule>
      <rule id="Rule_5">
        <description>Für Team 1, Projektannahme</description>
        <inputEntry id="UnaryTests_5_1"><text>"EINREICHUNG"</text></inputEntry>
        <inputEntry id="UnaryTests_5_2"><text></text></inputEntry>
        <inputEntry id="UnaryTests_5_3"><text></text></inputEntry>
        <inputEntry id="UnaryTests_5_4"><text></text></inputEntry>
        <outputEntry id="LiteralExpression_5_1"><text>"KUNDENFREIGABE"</text></outputEntry>
        <outputEntry id="LiteralExpression_5_2"><text>"Einreichungen bei Kassen immer mit Freigabe des Kunden."</text></outputEntry>
      </rule>
      <rule id="Rule_6">
        <description>Für Team 3, Projektannahme</description>
        <inputEntry id="UnaryTests_6_1"><text>"ERSATZVERSORGUNG"</text></inputEntry>
        <inputEntry id="UnaryTests_6_2"><text></text></inputEntry>
        <inputEntry id="UnaryTests_6_3"><text></text></inputEntry>
        <inputEntry id="UnaryTests_6_4"><text></text></inputEntry>
        <outputEntry id="LiteralExpression_6_1"><text>"KUNDENFREIGABE"</text></outputEntry>
        <outputEntry id="LiteralExpression_6_2"><text>"Auswahl einer Ersatzversorgung immer durch den Kunden."</text></outputEntry>
      </rule>
      <rule id="Rule_7">
        <description>Sicherer Standard</description>
        <inputEntry id="UnaryTests_7_1"><text></text></inputEntry>
        <inputEntry id="UnaryTests_7_2"><text></text></inputEntry>
        <inputEntry id="UnaryTests_7_3"><text></text></inputEntry>
        <inputEntry id="UnaryTests_7_4"><text></text></inputEntry>
        <outputEntry id="LiteralExpression_7_1"><text>"KUNDENFREIGABE"</text></outputEntry>
        <outputEntry id="LiteralExpression_7_2"><text>"Unbekannte Handlungsart: sicherheitshalber Freigabe einholen."</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_T2_Berechtigungsregel">
      <dmndi:DMNShape id="DMNShape_T2_Berechtigungsregel" dmnElementRef="T2_Berechtigungsregel">
        <dc:Bounds height="80" width="180" x="160" y="100" />
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
